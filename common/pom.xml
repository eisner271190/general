<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.epc.common</groupId>
  <artifactId>common-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>common-parent</name>
  <description>Componente reutilizable para microservicios Java: BOM de versiones y modulos por capacidad.</description>

  <modules>
    <module>common-bom</module>
    <module>common-log</module>
    <module>common-error</module>
    <module>common-web</module>
    <module>samples/log-only-sample</module>
    <module>samples/web-sample</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <flatten.plugin.version>1.8.0</flatten.plugin.version>
    <maven.compiler.plugin.version>3.14.0</maven.compiler.plugin.version>
    <maven.deploy.plugin.version>3.1.3</maven.deploy.plugin.version>
    <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>

    <!-- Version unica del sistema: se bumpea editando este fichero (docs/como-versionar.md). -->
    <epc.spring-boot.version>3.4.0</epc.spring-boot.version>
    <epc.aws-sdk.version>2.31.73</epc.aws-sdk.version>
    <epc.spring-cloud-aws.version>3.3.1</epc.spring-cloud-aws.version>
    <epc.aws-lambda-java-core.version>1.2.3</epc.aws-lambda-java-core.version>
    <epc.aws-lambda-java-runtime.version>2.8.3</epc.aws-lambda-java-runtime.version>
    <epc.springdoc.version>2.8.3</epc.springdoc.version>
    <epc.gson.version>2.13.1</epc.gson.version>
    <epc.jjwt.version>0.12.6</epc.jjwt.version>
    <epc.karate.version>1.4.1</epc.karate.version>
    <epc.archunit.version>1.3.0</epc.archunit.version>
    <epc.pitest.version>1.2.1</epc.pitest.version>
    <epc.r2dbc-h2.version>1.0.0.RELEASE</epc.r2dbc-h2.version>
    <epc.serverless-java-container.version>2.1.4</epc.serverless-java-container.version>

    <!--
      Endpoint de CodeArtifact. La cuenta y la region las sustituye el usuario al publicar
      (docs/como-versionar.md): no se hardcodean. Solo afecta a `mvn deploy`.
    -->
    <epc.codeartifact.url>https://epc-CHANGE_ME.d.codeartifact.CHANGE_ME.amazonaws.com/maven/common/</epc.codeartifact.url>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Un import de BOM solo aporta dependencyManagement: los modulos internos de `common`
        resuelven aqui las versiones de spring/slf4j/jackson. `common-bom` lo reimporta porque
        el POM publicado de un modulo no arrastra el dependencyManagement de su parent.
      -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${epc.spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <distributionManagement>
    <repository>
      <id>codeartifact</id>
      <name>CodeArtifact (dominio epc, repositorio common)</name>
      <url>${epc.codeartifact.url}</url>
    </repository>
  </distributionManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>flatten-maven-plugin</artifactId>
          <version>${flatten.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!--
        flattenMode=oss: el POM publicado conserva el dependencyManagement del BOM y resuelve sus
        variables (las entradas de modulos salen con 1.0.0 literal, no ${project.version}).
        Medido: con el valor por defecto de 1.8.0 el POM sale minimo y el BOM no gobierna nada.
        updatePomFile=true es obligatorio para packaging=pom (common-bom).
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <configuration>
          <flattenMode>oss</flattenMode>
          <updatePomFile>true</updatePomFile>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>${maven.deploy.plugin.version}</version>
        <inherited>false</inherited>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
