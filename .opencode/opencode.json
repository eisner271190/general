{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git reset*", "effect": "deny" },
    { "action": "shell", "resource": "git clean*", "effect": "deny" },
    { "action": "shell", "resource": "dotnet build*", "effect": "ask" },
    { "action": "shell", "resource": "dotnet run*", "effect": "ask" },
    { "action": "shell", "resource": "dotnet test*", "effect": "ask" },
    { "action": "shell", "resource": "flutter build*", "effect": "ask" },
    { "action": "shell", "resource": "flutter test*", "effect": "ask" },
    { "action": "shell", "resource": "mvn*", "effect": "ask" },
    { "action": "shell", "resource": "./mvnw*", "effect": "ask" },
    { "action": "shell", "resource": "gradle*", "effect": "ask" },
    { "action": "shell", "resource": "terraform apply*", "effect": "deny" },
    { "action": "shell", "resource": "terraform destroy*", "effect": "deny" },
    { "action": "shell", "resource": "gh pr*", "effect": "ask" }
  ],
  "formatter": true,
  "references": {
    "architecture": {
      "path": "./knowledge/architecture",
      "description": "Usar para decisiones de arquitectura y estructura del workspace"
    },
    "domain": {
      "path": "./knowledge/domain",
      "description": "Usar para reglas de negocio y términos del dominio"
    },
    "api": {
      "path": "./knowledge/api",
      "description": "Usar para contratos API, endpoints y esquemas"
    }
  }
}
