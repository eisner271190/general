{{ if(Name == "security") }}package com.{{ Company }}.{{ Name }}.application.services;

import com.{{ Company }}.{{ Name }}.domain.servicePorts.IUserServicePort;
import com.{{ Company }}.{{ Name }}.application.dto.*;
import com.{{ Company }}.{{ Name }}.application.mappers.*;

import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

@Service
public class UserService implements IUserService {

    private final IUserServicePort userServicePort;

    public UserService(IUserServicePort userServicePort) {
        this.userServicePort = userServicePort;
    }

    @Override
    public Mono<TokenResponseDTO> generateToken(TokenRequestDTO request) {
        var model = TokenRequestMapperDto.INSTANCE.toModel(request);
        return userServicePort.generateToken(model)
                .map(modelResponse -> TokenResponseMapperDto.INSTANCE.toDTO(modelResponse));
    }

    @Override
    public Mono<Void> registerUserByAdmin(RegisterUserRequestDTO request) {
        var model = RegisterUserMapperDto.INSTANCE.toModel(request);
        return userServicePort.registerUserByAdmin(model);
    }

    @Override
    public Mono<Void> registerUser(RegisterUserRequestDTO request) {
        var model = RegisterUserMapperDto.INSTANCE.toModel(request);
        return userServicePort.registerUser(model);
    }

    @Override
    public Mono<Void> confirmUser(ConfirmUserRequestDTO request) {
        var model = ConfirmUserMapperDto.INSTANCE.toModel(request);
        return userServicePort.confirmUser(model);
    }

    @Override
    public Mono<Void> forcePasswordReset(ForcePasswordResetRequestDTO request) {
        var model = ForcePasswordResetMapperDto.INSTANCE.toModel(request);
        return userServicePort.forcePasswordReset(model);
    }

    @Override
    public Mono<Void> changePassword(ChangePasswordRequestDTO request) {
        var model = ChangePasswordMapperDto.INSTANCE.toModel(request);
        return userServicePort.changePassword(model);
    }

    @Override
    public Mono<Void> recoverPassword(RecoverPasswordRequestDTO request) {
        var model = RecoverPasswordMapperDto.INSTANCE.toModel(request);
        return userServicePort.recoverPassword(model);
    }

    @Override
    public Mono<Void> deleteUser(String username) {
        return userServicePort.deleteUser(username);
    }

    @Override
    public Mono<Void> activateUser(String username) {
        return userServicePort.activateUser(username);
    }

    @Override
    public Mono<Void> deactivateUser(String username) {
        return userServicePort.deactivateUser(username);
    }
}
{{ end }}