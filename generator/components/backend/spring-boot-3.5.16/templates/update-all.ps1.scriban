<# 
.SYNOPSIS
    Actualiza TODOS los microservicios (Lambda ECR) sin hacer terraform apply.
    Uso: .\backend\update-all.ps1 [-Tag latest] [-PublishVersion]
#>

[CmdletBinding()]
param(
    [string]$Tag = "latest",

    [string]$Environment = "{{ ENVIRONMENT }}",

    [string]$Region = "{{ AWS_REGION }}",

    [switch]$PublishVersion,

    [switch]$SkipBuild,

    [switch]$WhatIf,

    [string[]]$Exclude = @(),

    [switch]$Parallel
)

$ApplicationId = "{{ APPLICATION_ID }}"

# Leer microservicios desde el JSON de configuración (ruta absoluta del generador)
$ConfigPath = "C:\epc\general\generator\target\com.quizsmart.app\com.quizsmart.app.json"
if (-not (Test-Path $ConfigPath)) {
    Write-Error "No se encuentra $ConfigPath. Ejecuta el generador primero."
    exit 1
}
$Config = Get-Content $ConfigPath -Raw | ConvertFrom-Json
$Microservices = $Config.microservices | Where-Object { $_.backend -eq 'spring-boot-3.5.16' -and $_.deploy -eq 'DOCKER' } | ForEach-Object { $_.name }

# Filtrar excluidos
if ($Exclude.Count -gt 0) {
    $Microservices = $Microservices | Where-Object { $_ -notin $Exclude }
}

Write-Host "=== Actualizando TODOS los microservicios ===" -ForegroundColor Cyan
Write-Host "Microservicios: $($Microservices -join ', ')" -ForegroundColor Gray
Write-Host "Tag: $Tag" -ForegroundColor Gray
Write-Host "Environment: $Environment" -ForegroundColor Gray
Write-Host "Region: $Region" -ForegroundColor Gray
if ($Exclude.Count -gt 0) { Write-Host "Excluidos: $($Exclude -join ', ')" -ForegroundColor Yellow }
if ($Parallel) { Write-Host "Modo: PARALELO" -ForegroundColor Yellow } else { Write-Host "Modo: SECUENCIAL" -ForegroundColor Gray }
if ($WhatIf) { Write-Host "=== MODO WHATIF ===" -ForegroundColor Yellow }
Write-Host ""

$failed = @()
$success = @()

function Update-Microservice {
    param([string]$Ms)
    $msScript = Join-Path $PSScriptRoot "$Ms/update-ms.ps1"
    if (-not (Test-Path $msScript)) {
        Write-Warning "No se encuentra $msScript, saltando..."
        return $false
    }

    $args = @(
        "-Tag", $Tag
        "-Environment", $Environment
        "-Region", $Region
    )
    if ($PublishVersion) { $args += "-PublishVersion" }
    if ($SkipBuild) { $args += "-SkipBuild" }
    if ($WhatIf) { $args += "-WhatIf" }

    Write-Host "`n>>> $Ms <<<" -ForegroundColor Cyan
    Push-Location (Split-Path $msScript)
    try {
        $output = & pwsh -File $msScript @args 2>&1
        $exitCode = $LASTEXITCODE
    } finally {
        Pop-Location
    }
    $output | ForEach-Object { Write-Host "  $_" }
    if ($exitCode -eq 0) {
        Write-Host "✓ $Ms OK" -ForegroundColor Green
        return $true
    } else {
        Write-Error "✗ $Ms FALLÓ (exit $exitCode)"
        return $false
    }
}

if ($Parallel) {
    Write-Host "`nEjecutando en paralelo..." -ForegroundColor Yellow
    $jobs = @()
    foreach ($ms in $Microservices) {
        $jobs += Start-Job -ScriptBlock { param($ms, $args) & pwsh -File "$ms/update-ms.ps1" @args } -ArgumentList $ms, $args
    }
    foreach ($job in $jobs) {
        $result = Receive-Job -Job $job -Wait
        $ms = $job.Name -replace '^Job\d+\s+', ''
        if ($job.State -eq 'Completed') {
            $success += $ms
        } else {
            $failed += $ms
        }
    }
} else {
    foreach ($ms in $Microservices) {
        if (Update-Microservice $ms) {
            $success += $ms
        } else {
            $failed += $ms
        }
    }
}

Write-Host "`n=== RESUMEN ===" -ForegroundColor Cyan
Write-Host "Exitosos: $($success.Count) - $($success -join ', ')" -ForegroundColor Green
if ($failed.Count -gt 0) {
    Write-Host "Fallidos: $($failed.Count) - $($failed -join ', ')" -ForegroundColor Red
    exit 1
} else {
    Write-Host "¡TODOS ACTUALIZADOS!" -ForegroundColor Green
}