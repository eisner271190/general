package {{ PACKAGE }}.ai.ai.infrastructure.rest;

import {{ PACKAGE }}.ai.ai.domain.GenerateAiCommand;
import {{ PACKAGE }}.ai.ai.domain.port.IAiPort;
import {{ PACKAGE }}.ai.ai.infrastructure.configuration.AiConstants;
import {{ PACKAGE }}.ai.ai.infrastructure.configuration.AiMessages;
import {{ PACKAGE }}.ai.ai.infrastructure.configuration.AiLogMessages;



import com.epc.common.log.ILogService;
import com.epc.common.error.ApiResponse;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import reactor.core.publisher.Mono;

import java.util.Map;

/**
 * Controller de IA generativa agnostico al proveedor: el cliente solo envia el prompt.
 *
 * <p>El modelo, la temperatura y las credenciales los resuelve el backend, de modo que el
 * frontend no conoce ningun proveedor de IA.
 */
@RestController
@RequestMapping("/api/v1/ai")
public class AiController {

    private final ILogService log;
    private final IAiPort aiHandler;

    public AiController(IAiPort aiHandler, ILogService log) {
        this.log = log;
        this.aiHandler = aiHandler;
    }

    /**
     * Cuerpo: {@code {"prompt":"..."}} -> ApiResponse con data = cuerpo crudo del proveedor.
     *
     * <p>El passthrough mantiene el contrato que el cliente ya consume
     * ({@code choices[0].message.content}).
     */
    @PostMapping("/generate")
    public Mono<ResponseEntity<ApiResponse>> generate(
            @RequestBody(required = false) AiGenerateRequestDto request) {
        String prompt = extractPrompt(request);
        log.info(AiLogMessages.AI_CONTROLLER_RECEIVED);
        log.debug(AiLogMessages.AI_PROMPT_LENGTH, prompt == null ? 0 : prompt.length());
        if (isPromptInvalid(prompt)) {
            log.warn(AiLogMessages.AI_PROMPT_REJECTED,
                AiConstants.MAX_PROMPT_LENGTH);
            return Mono.just(badRequest());
        }
        return aiHandler.generate(new GenerateAiCommand(prompt))
            .map(generation -> okResponse(generation.providerPayload()))
            .onErrorResume(this::handleError);
    }

    private String extractPrompt(AiGenerateRequestDto request) {
        return request == null ? null : request.prompt();
    }

    private boolean isPromptInvalid(String prompt) {
        return prompt == null
            || prompt.isBlank()
            || prompt.length() > AiConstants.MAX_PROMPT_LENGTH;
    }

    private ResponseEntity<ApiResponse> badRequest() {
        // ApiResponse tiene sobrecargas (Map, String, int) y (Object, String, int): un null
        // sin tipo no compila. La variable tipada elige la de Map.
        Map<String, Object> noData = null;
        return ResponseEntity.badRequest()
            .body(new ApiResponse(noData, AiMessages.PROMPT_INVALID, AiConstants.STATUS_BAD_REQUEST));
    }

    private ResponseEntity<ApiResponse> okResponse(Map<String, Object> payload) {
        return ResponseEntity.ok(
            new ApiResponse(payload, AiMessages.GENERATED, AiConstants.STATUS_OK));
    }

    private Mono<ResponseEntity<ApiResponse>> handleError(Throwable error) {
        // El mensaje real puede traer la URL del proveedor: dato de infraestructura
        // que no debe viajar al cliente de un endpoint publico. Se registra aqui.
        log.error(AiLogMessages.AI_GENERATION_FAILED, error);
        Map<String, Object> noData = null;
        return Mono.just(ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
            .body(new ApiResponse(noData, AiMessages.GENERATION_ERROR, AiConstants.STATUS_INTERNAL_ERROR)));
    }
}
