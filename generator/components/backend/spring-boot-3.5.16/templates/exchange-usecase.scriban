{{ if(Name == "security") }}package {{ PACKAGE }}.security.exchange.application;

import {{ PACKAGE }}.security.exchange.domain.model.ExchangeRequest;
import {{ PACKAGE }}.security.exchange.domain.model.ExchangeResponse;
import {{ PACKAGE }}.security.exchange.domain.port.ExchangePort;
import {{ PACKAGE }}.security.exchange.domain.port.ExchangeServicePort;




import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

@Service
public class ExchangeUseCase implements ExchangeServicePort {

    private final ExchangePort exchangePort;

    public ExchangeUseCase(ExchangePort exchangePort) {
        this.exchangePort = exchangePort;
    }

    @Override
    public Mono<ExchangeResponse> exchangeCodeForTokens(ExchangeRequest request) {
        return exchangePort.exchangeCodeForTokens(request);
    }
}
{{ end }}
