{{ if(Graalvm) }}package com.{{ Company }}.{{ MicroserviceName }}.infrastructure.configuration;

import org.springframework.aot.hint.MemberCategory;
import org.springframework.aot.hint.RuntimeHintsRegistrar;
import com.{{ Company }}.product.infrastructure.persistence.dynamos.{{ EntityCapital }}Dynamo;

public class {{ EntityCapital }}RuntimeHints implements RuntimeHintsRegistrar {

    @Override
    public void registerHints(org.springframework.aot.hint.RuntimeHints hints, ClassLoader classLoader) {
        hints.reflection()
            .registerType({{ EntityCapital }}Dynamo.class,
                MemberCategory.INVOKE_PUBLIC_CONSTRUCTORS,
                MemberCategory.INVOKE_PUBLIC_METHODS,
                MemberCategory.DECLARED_FIELDS);
    }
}
{{ end }}