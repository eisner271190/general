{{ if(Name == "security") }}package com.{{ Company }}.{{ Name }}.application.services;

import com.{{ Company }}.{{ Name }}.domain.servicePorts.AdminUserServicePort;

import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

@Service
public class AdminUserService implements IAdminUserService {

    private final AdminUserServicePort adminUserServicePort;

    public AdminUserService(AdminUserServicePort adminUserServicePort) {
        this.adminUserServicePort = adminUserServicePort;
    }

    @Override
    public Mono<Void> deleteUser(String username) {
        return adminUserServicePort.deleteUser(username);
    }

    @Override
    public Mono<Void> activateUser(String username) {
        return adminUserServicePort.activateUser(username);
    }

    @Override
    public Mono<Void> deactivateUser(String username) {
        return adminUserServicePort.deactivateUser(username);
    }
}
{{ end }}
