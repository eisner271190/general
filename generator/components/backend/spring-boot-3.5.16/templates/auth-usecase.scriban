{{ if(Name == "security") }}package {{ PACKAGE }}.security.auth.application;

import {{ PACKAGE }}.security.auth.domain.model.TokenRequest;
import {{ PACKAGE }}.security.auth.domain.model.TokenResponse;
import {{ PACKAGE }}.security.auth.domain.port.AuthPort;
import {{ PACKAGE }}.security.auth.domain.port.AuthServicePort;




import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

@Service
public class AuthUseCase implements AuthServicePort {

    private final AuthPort authPort;

    public AuthUseCase(AuthPort authPort) {
        this.authPort = authPort;
    }

    @Override
    public Mono<TokenResponse> generateToken(TokenRequest request) {
        return authPort.generateToken(request);
    }
}
{{ end }}
