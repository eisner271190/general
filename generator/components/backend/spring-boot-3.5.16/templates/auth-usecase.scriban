{{ if(Name == "security") }}package {{ PACKAGE }}.domain.usecase;

import {{ PACKAGE }}.domain.servicePorts.AuthServicePort;
import {{ PACKAGE }}.domain.ports.AuthPort;
import {{ PACKAGE }}.domain.model.*;

import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

@Service
public class AuthUseCase implements AuthServicePort {

    private final AuthPort authPort;

    public AuthUseCase(AuthPort authPort) {
        this.authPort = authPort;
    }

    @Override
    public Mono<TokenResponse> generateToken(TokenRequest request) {
        return authPort.generateToken(request);
    }
}
{{ end }}
