{{ if(Name == "security") }}package com.{{ Company }}.{{ Name }}.domain.usecase;

import com.{{ Company }}.{{ Name }}.domain.servicePorts.IUserServicePort;
import com.{{ Company }}.{{ Name }}.domain.ports.IUserPort;
import com.{{ Company }}.{{ Name }}.domain.model.*;

import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

@Service
public class UserUseCase implements IUserServicePort {

    private final IUserPort userPort;

    public UserUseCase(IUserPort userPort) {
        this.userPort = userPort;
    }

    @Override
    public Mono<TokenResponse> generateToken(TokenRequest request) {
        return userPort.generateToken(request);
    }

    @Override
    public Mono<Void> registerUserByAdmin(RegisterUser request) {
        return userPort.registerUserByAdmin(request);
    }

    @Override
    public Mono<Void> registerUser(RegisterUser request) {
        return userPort.registerUser(request);
    }

    @Override
    public Mono<Void> confirmUser(ConfirmUser request) {
        return userPort.confirmUser(request);
    }

    @Override
    public Mono<Void> forcePasswordReset(ForcePasswordReset request) {
        return userPort.forcePasswordReset(request);
    }

    @Override
    public Mono<Void> changePassword(ChangePassword request) {
        return userPort.changePassword(request);
    }

    @Override
    public Mono<Void> recoverPassword(RecoverPassword request) {
        return userPort.recoverPassword(request);
    }

    @Override
    public Mono<Void> deleteUser(String username) {
        return userPort.deleteUser(username);
    }

    @Override
    public Mono<Void> activateUser(String username) {
        return userPort.activateUser(username);
    }

    @Override
    public Mono<Void> deactivateUser(String username) {
        return userPort.deactivateUser(username);
    }
}
{{ end }}