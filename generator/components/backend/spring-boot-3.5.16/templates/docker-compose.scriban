{{ for m in microservices }}
  {{ m.Name }}:
    build: ./microservices/{{ m.Name }}
    container_name: {{ m.Name }}
    ports:
      - "{{ m.Port }}:{{ m.Port }}"
    depends_on:
      - prometheus
    networks:
      - monitoring
    environment:
      AWS_REGION: ${AWS_REGION}
      AWS_PROFILE: ${AWS_PROFILE}
      AWS_ACCESS_KEY_ID: ${AWS_ACCESS_KEY_ID}
      AWS_SECRET_ACCESS_KEY: ${AWS_SECRET_ACCESS_KEY}
      AWS_SNS_TOPIC_ARN: ${AWS_SNS_TOPIC_ARN} {{if m.ConsumedEvents.size > 0}}
      AWS_SQS_URL: ${AWS_SQS_URL_{{ m.Name }}}
{{end}}
    labels:
      - "prometheus.scrape=true"
{{ end }}

networks:
  monitoring:
    driver: bridge
