package {{ PACKAGE }}.subscription.webhook.infrastructure.adapters;

import {{ PACKAGE }}.subscription.webhook.domain.model.WebhookEventDto;




import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
import com.fasterxml.jackson.annotation.JsonProperty;

import java.util.Objects;

/**
 * Payload real que RevenueCat envia a POST /api/v1/subscriptions/webhook: anidado bajo
 * {@code event} y en snake_case.
 *
 * <p>Se traduce al contrato agnostico {@link WebhookEventDto} antes de entrar en dominio,
 * de modo que cambiar de proveedor solo exige sustituir esta clase y su traduccion.
 */
@JsonIgnoreProperties(ignoreUnknown = true)
public record RevenueCatWebhookPayload(
    @JsonProperty("api_version") String apiVersion,
    @JsonProperty("event") Event event
) {

    public RevenueCatWebhookPayload {
        Objects.requireNonNull(event, "event es obligatorio en el payload del webhook");
    }

    public WebhookEventDto toWebhookEvent() {
        return new WebhookEventDto(
            event.id(),
            event.type(),
            event.appUserId(),
            event.productId(),
            event.store(),
            event.purchasedAtMs(),
            event.expirationAtMs()
        );
    }

    @JsonIgnoreProperties(ignoreUnknown = true)
    public record Event(
        @JsonProperty("id") String id,
        @JsonProperty("type") String type,
        @JsonProperty("app_user_id") String appUserId,
        @JsonProperty("product_id") String productId,
        @JsonProperty("store") String store,
        @JsonProperty("purchased_at_ms") Long purchasedAtMs,
        @JsonProperty("expiration_at_ms") Long expirationAtMs
    ) {}
}
