resource "aws_cognito_user_pool_client" "user_pool_client" {
  name         = "user-management-app-client"
  user_pool_id = aws_cognito_user_pool.user_pool.id

  generate_secret = false
  allowed_oauth_flows_user_pool_client = true

  allowed_oauth_flows = ["code", "implicit"]
  allowed_oauth_scopes = ["email", "openid", "profile"]

  supported_identity_providers = ["COGNITO", "Google"]

  explicit_auth_flows = [
    "ALLOW_USER_PASSWORD_AUTH",
    "ALLOW_REFRESH_TOKEN_AUTH",
    "ALLOW_USER_SRP_AUTH"
  ]

  callback_urls = ["http://localhost:3000/callback"] # Cambia según tu frontend
  logout_urls   = ["http://localhost:3000/logout"]

  depends_on = [
    aws_cognito_user_pool_domain.user_pool_domain,
    aws_cognito_identity_provider.google_provider
  ]
}

output "user_pool_client_id" {
  value       = aws_cognito_user_pool_client.user_pool_client.id
  description = "ID del App Client de Cognito"
}