{{ if(Name == "security") }}package com.{{ Company }}.{{ Name }}.infrastructure.adapters;

import com.{{ Company }}.{{ Name }}.domain.ports.IUserPort;
import com.{{ Company }}.{{ Name }}.infrastructure.configuration.cloud.aws.CognitoClient;
import com.{{ Company }}.{{ Name }}.domain.model.*;

import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

@Service
public class UserAdapter implements IUserPort {

    private final CognitoClient cognitoClient;

    public UserAdapter(CognitoClient cognitoClient) {
        this.cognitoClient = cognitoClient;
    }

    @Override
    public Mono<TokenResponse> generateToken(TokenRequest request) {
        return cognitoClient.generateToken(request.getUsername(), request.getPassword());
    }

    @Override
    public Mono<Void> registerUserByAdmin(RegisterUser request) {
        return cognitoClient.createUser(request);
    }

    @Override
    public Mono<Void> registerUser(RegisterUser request) {
        return cognitoClient.signUpUser(request);
    }

    @Override
    public Mono<Void> confirmUser(ConfirmUser request) {
        return cognitoClient.confirmUser(request.getUsername(), request.getConfirmationCode());
    }

    @Override
    public Mono<Void> forcePasswordReset(ForcePasswordReset request) {
        return cognitoClient.forcePasswordReset(request.getUsername());
    }

    @Override
    public Mono<Void> changePassword(ChangePassword request) {
        return cognitoClient.changePassword(request.getAccessToken(), request.getOldPassword(), request.getNewPassword());
    }

    @Override
    public Mono<Void> recoverPassword(RecoverPassword request) {
        return cognitoClient.initiatePasswordRecovery(request.getEmail());
    }

    @Override
    public Mono<Void> deleteUser(String username) {
        return cognitoClient.deleteUser(username);
    }

    @Override
    public Mono<Void> activateUser(String username) {
        return cognitoClient.updateUserStatus(username, true);
    }

    @Override
    public Mono<Void> deactivateUser(String username) {
        return cognitoClient.updateUserStatus(username, false);
    }
}
{{ end }}