{{ if(Name == "security") }}package com.{{ Company }}.{{ Name }}.application.services;

import com.{{ Company }}.{{ Name }}.domain.servicePorts.PasswordServicePort;
import com.{{ Company }}.{{ Name }}.application.dto.*;
import com.{{ Company }}.{{ Name }}.application.mappers.*;

import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

@Service
public class PasswordService implements IPasswordService {

    private final PasswordServicePort passwordServicePort;

    public PasswordService(PasswordServicePort passwordServicePort) {
        this.passwordServicePort = passwordServicePort;
    }

    @Override
    public Mono<Void> forcePasswordReset(ForcePasswordResetRequestDTO request) {
        var model = ForcePasswordResetMapperDto.INSTANCE.toModel(request);
        return passwordServicePort.forcePasswordReset(model);
    }

    @Override
    public Mono<Void> changePassword(ChangePasswordRequestDTO request) {
        var model = ChangePasswordMapperDto.INSTANCE.toModel(request);
        return passwordServicePort.changePassword(model);
    }

    @Override
    public Mono<Void> recoverPassword(RecoverPasswordRequestDTO request) {
        var model = RecoverPasswordMapperDto.INSTANCE.toModel(request);
        return passwordServicePort.recoverPassword(model);
    }
}
{{ end }}
