{{ if(Name == "security") }}package {{ PACKAGE }}.infrastructure.adapters;

import com.epc.common.log.ILogService;
import {{ PACKAGE }}.domain.ports.RegistrationPort;
import {{ PACKAGE }}.infrastructure.configuration.DomainLogMessages;
import {{ PACKAGE }}.infrastructure.configuration.cloud.aws.CognitoClient;
import {{ PACKAGE }}.domain.model.*;

import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

/**
 * Adaptador de registro sobre Cognito.
 *
 * <p>El correo y el nombre se registran porque identifican al usuario; la contrasena nunca.
 */
@Component
public class RegistrationAdapter implements RegistrationPort {

    private final ILogService log;
    private final CognitoClient cognitoClient;

    public RegistrationAdapter(CognitoClient cognitoClient, ILogService log) {
        this.log = log;
        this.cognitoClient = cognitoClient;
    }

    @Override
    public Mono<Void> registerUserByAdmin(RegisterUser request) {
        log.info(DomainLogMessages.USER_CREATING_BY_ADMIN, request.getEmail());
        return cognitoClient.createUser(request)
            .doOnSuccess(done -> log.debug(DomainLogMessages.USER_CREATED, request.getEmail()));
    }

    @Override
    public Mono<Void> registerUser(RegisterUser request) {
        log.info(DomainLogMessages.USER_REGISTERING, request.getEmail());
        return cognitoClient.signUpUser(request)
            .doOnSuccess(done -> log.debug(DomainLogMessages.USER_REGISTERED, request.getEmail()));
    }

    @Override
    public Mono<Void> confirmUser(ConfirmUser request) {
        log.info(DomainLogMessages.USER_CONFIRMING, request.getUsername());
        return cognitoClient.confirmUser(request.getUsername(), request.getConfirmationCode())
            .doOnSuccess(done -> log.debug(DomainLogMessages.USER_CONFIRMED, request.getUsername()));
    }
}
{{ end }}