package {{ PACKAGE }}.infrastructure.configuration.cloud.aws;

import com.google.gson.Gson;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import software.amazon.awssdk.services.sns.SnsClient;
import software.amazon.awssdk.services.sns.model.MessageAttributeValue;
import software.amazon.awssdk.services.sns.model.PublishRequest;
import org.springframework.beans.factory.annotation.Value;

import java.util.Map;

/**
 * Publicacion de eventos en el topico SNS.
 *
 * <p>El payload no se registra: puede llevar credenciales o datos personales. La traza anota
 * el tipo de evento y el tipo de la carga util, no su contenido.
 */
@Service
public class SnsEventPublisher {

    private static final Logger LOG = LoggerFactory.getLogger(SnsEventPublisher.class);

    private final SnsClient snsClient;

    @Value("${aws.sns.arn}")
    private String topicArn;

    public SnsEventPublisher(SnsClient snsClient) {
        this.snsClient = snsClient;
    }

    public void publishEvent(String eventType, Object payload) {
        LOG.info("Publicando evento {} en SNS", eventType);
        LOG.debug("Topic: {}, carga de tipo {}", topicArn,
            payload == null ? "null" : payload.getClass().getSimpleName());
        PublishRequest request = PublishRequest.builder()
            .topicArn(topicArn)
            .message(new Gson().toJson(payload))
            .messageAttributes(Map.of(
                "eventType", MessageAttributeValue.builder()
                    .dataType("String")
                    .stringValue(eventType)
                    .build()
            ))
            .build();

        snsClient.publish(request);
        LOG.debug("Evento {} publicado", eventType);
    }
}