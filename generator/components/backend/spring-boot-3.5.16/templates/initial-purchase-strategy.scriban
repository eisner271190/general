package {{ PACKAGE }}.domain.usecase.strategies;

import {{ PACKAGE }}.domain.dto.WebhookEventDTO;
import {{ PACKAGE }}.domain.model.Subscription;
import {{ PACKAGE }}.domain.ports.SubscriptionPort;
import {{ PACKAGE }}.domain.usecase.IWebhookStrategy;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

@Component
public class InitialPurchaseStrategy implements IWebhookStrategy {

    private static final Logger LOG = LoggerFactory.getLogger(InitialPurchaseStrategy.class);

    private final SubscriptionPort subscriptionPort;

    public InitialPurchaseStrategy(SubscriptionPort subscriptionPort) {
        this.subscriptionPort = subscriptionPort;
    }

    @Override
    public String eventType() {
        return "INITIAL_PURCHASE";
    }

    /**
     * Primera compra: el evento da de alta la suscripcion. Sin esta estrategia el evento
     * caia en {@link UnknownEventStrategy} y solo se registraba un aviso, sin persistir.
     */
    @Override
    public Mono<Void> handle(WebhookEventDTO event) {
        LOG.info("Procesando evento {}", eventType());
        LOG.debug("userId={}", event.userId());
        return subscriptionPort.saveSubscription(toSubscription(event)).then()
            .doOnSuccess(done ->
                LOG.debug("Evento {} aplicado a userId={}", eventType(), event.userId()));
    }

    private Subscription toSubscription(WebhookEventDTO event) {
        return Subscription.active(event.userId(), event.productId(), event.store(),
            event.purchasedAtMs(), event.expirationAtMs());
    }
}
