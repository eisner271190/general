package {{ PACKAGE }}.domain.ports;

import {{ PACKAGE }}.domain.model.Subscription;
import reactor.core.publisher.Mono;

/**
 * Puerto agnóstico al proveedor de suscripciones (RevenueCat u otro).
 *
 * <p>El dominio solo conoce este contrato; el adaptador concreto (p. ej.
 * RevenueCatAdapter) vive en infrastructure/adapters y lo implementa.
 * Cambiar de proveedor no toca este archivo ni los casos de uso.
 */
public interface ISubscriptionProviderPort {

    /** Obtiene el estado de suscripción del usuario en el proveedor. */
    Mono<Subscription> fetchSubscription(String userId);
}
