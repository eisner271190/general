package {{ PACKAGE }}.subscription.subscription.domain.model;

public class Subscription {

    private String userId;
    private String productId;
    private String status;
    private String store;
    private String originalTransactionId;
    private Long purchasedAtMs;
    private Long expirationAtMs;
    private Long expirationTTL;
    private Long updatedAtMs;

    public Subscription() {
    }

    public static Subscription inactive(String userId) {
        Subscription subscription = new Subscription();
        subscription.userId = userId;
        subscription.status = "INACTIVE";
        subscription.updatedAtMs = System.currentTimeMillis();
        return subscription;
    }

    /**
     * Suscripcion creada o modificada por un evento de compra (INITIAL_PURCHASE,
     * NON_RENEWING_PURCHASE, PRODUCT_CHANGE). El evento trae todos los datos, de modo
     * que se sobrescribe la fila entera sin necesidad de localizar la anterior.
     */
    public static Subscription active(
            String userId,
            String productId,
            String store,
            Long purchasedAtMs,
            Long expirationAtMs) {
        Subscription subscription = new Subscription();
        subscription.userId = userId;
        subscription.productId = productId;
        subscription.status = "ACTIVE";
        subscription.store = store;
        subscription.purchasedAtMs = purchasedAtMs;
        subscription.expirationAtMs = expirationAtMs;
        subscription.updatedAtMs = System.currentTimeMillis();
        return subscription;
    }

    public boolean isActive() {
        return "ACTIVE".equals(status) || "GRACE_PERIOD".equals(status);
    }

    public Subscription withStatus(String newStatus) {
        this.status = newStatus;
        this.updatedAtMs = System.currentTimeMillis();
        return this;
    }

    public Subscription withExpirationAtMs(Long newExpirationAtMs) {
        this.expirationAtMs = newExpirationAtMs;
        this.updatedAtMs = System.currentTimeMillis();
        return this;
    }

    public String getUserId() {
        return userId;
    }

    public void setUserId(String userId) {
        this.userId = userId;
    }

    public String getProductId() {
        return productId;
    }

    public void setProductId(String productId) {
        this.productId = productId;
    }

    public String getStatus() {
        return status;
    }

    public void setStatus(String status) {
        this.status = status;
    }

    public String getStore() {
        return store;
    }

    public void setStore(String store) {
        this.store = store;
    }

    public String getOriginalTransactionId() {
        return originalTransactionId;
    }

    public void setOriginalTransactionId(String originalTransactionId) {
        this.originalTransactionId = originalTransactionId;
    }

    public Long getPurchasedAtMs() {
        return purchasedAtMs;
    }

    public void setPurchasedAtMs(Long purchasedAtMs) {
        this.purchasedAtMs = purchasedAtMs;
    }

    public Long getExpirationAtMs() {
        return expirationAtMs;
    }

    public void setExpirationAtMs(Long expirationAtMs) {
        this.expirationAtMs = expirationAtMs;
    }

    public Long getExpirationTTL() {
        return expirationTTL;
    }

    public void setExpirationTTL(Long expirationTTL) {
        this.expirationTTL = expirationTTL;
    }

    public Long getUpdatedAtMs() {
        return updatedAtMs;
    }

    public void setUpdatedAtMs(Long updatedAtMs) {
        this.updatedAtMs = updatedAtMs;
    }
}
