package {{ PACKAGE }}.subscription.subscription.infrastructure.adapters;

import {{ PACKAGE }}.subscription.subscription.infrastructure.configuration.SubscriptionLogMessages;
import {{ PACKAGE }}.subscription.subscription.domain.model.Subscription;
import {{ PACKAGE }}.subscription.subscription.domain.port.ISubscriptionPort;
import {{ PACKAGE }}.subscription.subscription.infrastructure.persistence.dynamos.tableschema.SubscriptionTableSchema;
import {{ PACKAGE }}.subscription.subscription.infrastructure.persistence.entities.SubscriptionEntity;



import com.epc.common.log.ILogService;

import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;
import reactor.core.scheduler.Schedulers;
import software.amazon.awssdk.enhanced.dynamodb.DynamoDbTable;
import software.amazon.awssdk.enhanced.dynamodb.Key;

@Component
public class SubscriptionAdapter implements ISubscriptionPort {

    private final ILogService log;
    private final DynamoDbTable<SubscriptionEntity> table;

    public SubscriptionAdapter(SubscriptionTableSchema subscriptionTableSchema, ILogService log) {
        this.log = log;
        this.table = subscriptionTableSchema.getTable();
    }

    /**
     * Devuelve la suscripcion registrada del usuario, sea cual sea su estado.
     * No filtra por estado: las estrategias de webhook necesitan localizar la
     * suscripcion inactiva (UNCANCELLATION, RENEWAL tras EXPIRATION) para mutarla.
     */
    @Override
    public Mono<Subscription> findSubscriptionByUserId(String userId) {
        log.info(SubscriptionLogMessages.SUBSCRIPTION_NOT_FOUND_IN_DB, userId);
        return Mono.fromCallable(() -> table.getItem(keyFor(userId)))
                .subscribeOn(Schedulers.boundedElastic())
                .map(this::toDomain)
                .doOnNext(subscription -> log.debug(SubscriptionLogMessages.SUBSCRIPTION_FOUND,
                    subscription == null ? null : subscription.getStatus()));
    }

    @Override
    public Mono<Subscription> saveSubscription(Subscription subscription) {
        log.info(SubscriptionLogMessages.SUBSCRIPTION_SAVING, subscription.getUserId());
        log.debug(SubscriptionLogMessages.SUBSCRIPTION_STATUS_PERSISTED, subscription.getStatus());
        return Mono.fromRunnable(() -> table.putItem(toEntity(subscription)))
                .subscribeOn(Schedulers.boundedElastic())
                .thenReturn(subscription);
    }

    @Override
    public Mono<Subscription> updateStatus(String userId, String status) {
        log.info(SubscriptionLogMessages.SUBSCRIPTION_UPDATING, status, userId);
        return findSubscriptionByUserId(userId)
                .map(subscription -> subscription.withStatus(status))
                .flatMap(this::saveSubscription);
    }

    private Key keyFor(String userId) {
        return Key.builder().partitionValue(userId).build();
    }

    private Subscription toDomain(SubscriptionEntity entity) {
        Subscription subscription = new Subscription();
        subscription.setUserId(entity.getUserId());
        subscription.setProductId(entity.getProductId());
        subscription.setStatus(entity.getStatus());
        subscription.setStore(entity.getStore());
        subscription.setOriginalTransactionId(entity.getOriginalTransactionId());
        subscription.setPurchasedAtMs(entity.getPurchasedAtMs());
        subscription.setExpirationAtMs(entity.getExpirationAtMs());
        subscription.setExpirationTTL(entity.getExpirationTTL());
        subscription.setUpdatedAtMs(entity.getUpdatedAtMs());
        return subscription;
    }

    private SubscriptionEntity toEntity(Subscription subscription) {
        SubscriptionEntity entity = new SubscriptionEntity();
        entity.setUserId(subscription.getUserId());
        entity.setProductId(subscription.getProductId());
        entity.setStatus(subscription.getStatus());
        entity.setStore(subscription.getStore());
        entity.setOriginalTransactionId(subscription.getOriginalTransactionId());
        entity.setPurchasedAtMs(subscription.getPurchasedAtMs());
        entity.setExpirationAtMs(subscription.getExpirationAtMs());
        entity.setExpirationTTL(subscription.getExpirationTTL());
        entity.setUpdatedAtMs(subscription.getUpdatedAtMs());
        return entity;
    }
}