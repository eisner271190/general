package {{ PACKAGE }}.subscription.subscription.infrastructure.rest;

import {{ PACKAGE }}.subscription.subscription.infrastructure.configuration.SubscriptionLogMessages;
import {{ PACKAGE }}.subscription.subscription.application.SubscriptionHandler;
import {{ PACKAGE }}.subscription.subscription.domain.GetSubscriptionStatusCommand;
import {{ PACKAGE }}.subscription.subscription.domain.model.Subscription;
import {{ PACKAGE }}.subscription.subscription.domain.SyncSubscriptionCommand;



import com.epc.common.log.ILogService;
import com.epc.common.error.ApiResponse;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import reactor.core.publisher.Mono;

@RestController
@RequestMapping("/api/v1/subscriptions")
public class SubscriptionController {

    private final ILogService log;
    private final SubscriptionHandler subscriptionHandler;

    public SubscriptionController(SubscriptionHandler subscriptionHandler, ILogService log) {
        this.log = log;
        this.subscriptionHandler = subscriptionHandler;
    }

    @GetMapping("/status")
    public Mono<ResponseEntity<ApiResponse>> getStatus(@RequestHeader("X-User-Id") String userId) {
        log.info(SubscriptionLogMessages.SUBSCRIPTION_STATUS_CONTROLLER, userId);
        return subscriptionHandler.getStatus(new GetSubscriptionStatusCommand(userId))
            .map(subscription -> ResponseEntity.ok(new ApiResponse(toStatusResponse(subscription), "Status retrieved", 200)))
            .doOnSuccess(response -> log.debug(SubscriptionLogMessages.SUBSCRIPTION_STATUS_RETURNED, userId));
    }

    @PostMapping("/sync")
    public Mono<ResponseEntity<ApiResponse>> sync(@RequestHeader("X-User-Id") String userId) {
        log.info(SubscriptionLogMessages.SUBSCRIPTION_SYNC_CONTROLLER, userId);
        return subscriptionHandler.syncFromProvider(new SyncSubscriptionCommand(userId))
            .map(subscription -> ResponseEntity.ok(new ApiResponse(toStatusResponse(subscription), "Sync completed", 200)))
            .doOnSuccess(response -> log.debug(SubscriptionLogMessages.SUBSCRIPTION_SYNC_RETURNED, userId));
    }

    private SubscriptionStatusResponseDto toStatusResponse(Subscription subscription) {
        return new SubscriptionStatusResponseDto(
            subscription.isActive(),
            subscription.getProductId(),
            subscription.getExpirationAtMs()
        );
    }
}
