{{ if(Name == "security") }}package {{ PACKAGE }}.infrastructure.adapters;

import {{ PACKAGE }}.domain.ports.PasswordPort;
import {{ PACKAGE }}.infrastructure.configuration.cloud.aws.CognitoClient;
import {{ PACKAGE }}.domain.model.*;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

/**
 * Adaptador de contrasenas sobre Cognito.
 *
 * <p>La contrasena y el token de acceso jamas se registran: R10 se aplica solo a los campos
 * identificadores (usuario, correo), nunca al contenido de la credencial.
 */
@Component
public class PasswordAdapter implements PasswordPort {

    private static final Logger LOG = LoggerFactory.getLogger(PasswordAdapter.class);

    private final CognitoClient cognitoClient;

    public PasswordAdapter(CognitoClient cognitoClient) {
        this.cognitoClient = cognitoClient;
    }

    @Override
    public Mono<Void> forcePasswordReset(ForcePasswordReset request) {
        LOG.info("Forzando restablecimiento de contrasena para {}", request.getUsername());
        return cognitoClient.forcePasswordReset(request.getUsername())
            .doOnSuccess(done -> LOG.debug("Restablecimiento forzado para {}", request.getUsername()));
    }

    @Override
    public Mono<Void> changePassword(ChangePassword request) {
        // Ni la contrasena nueva ni el token de acceso se registran.
        LOG.info("Cambio de contrasena solicitado");
        return cognitoClient.changePassword(request.getAccessToken(), request.getOldPassword(), request.getNewPassword())
            .doOnSuccess(done -> LOG.debug("Contrasena actualizada"));
    }

    @Override
    public Mono<Void> recoverPassword(RecoverPassword request) {
        LOG.info("Iniciando recuperacion de contrasena para {}", request.getEmail());
        return cognitoClient.initiatePasswordRecovery(request.getEmail())
            .doOnSuccess(done -> LOG.debug("Recuperacion iniciada para {}", request.getEmail()));
    }
}
{{ end }}