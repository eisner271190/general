{{ if(Name == "security") }}package {{ PACKAGE }}.security.adminuser.application;

import {{ PACKAGE }}.security.adminuser.domain.port.AdminUserPort;
import {{ PACKAGE }}.security.adminuser.domain.port.AdminUserServicePort;




import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

@Service
public class AdminUserUseCase implements AdminUserServicePort {

    private final AdminUserPort adminUserPort;

    public AdminUserUseCase(AdminUserPort adminUserPort) {
        this.adminUserPort = adminUserPort;
    }

    @Override
    public Mono<Void> deleteUser(String username) {
        return adminUserPort.deleteUser(username);
    }

    @Override
    public Mono<Void> activateUser(String username) {
        return adminUserPort.activateUser(username);
    }

    @Override
    public Mono<Void> deactivateUser(String username) {
        return adminUserPort.deactivateUser(username);
    }
}
{{ end }}
