package {{ PACKAGE }}.infrastructure.configuration.webfilters;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.core.io.buffer.DataBuffer;
import org.springframework.core.io.buffer.DataBufferUtils;
import org.springframework.http.HttpStatus;
import org.springframework.http.server.reactive.ServerHttpRequestDecorator;
import org.springframework.stereotype.Component;
import org.springframework.web.server.ServerWebExchange;
import org.springframework.web.server.WebFilter;
import org.springframework.web.server.WebFilterChain;
import reactor.core.publisher.Flux;
import reactor.core.publisher.Mono;

import javax.crypto.Mac;
import javax.crypto.spec.SecretKeySpec;
import java.nio.ByteBuffer;
import java.nio.charset.StandardCharsets;
import java.security.GeneralSecurityException;
import java.security.MessageDigest;
import java.util.HashMap;
import java.util.HexFormat;
import java.util.Map;

/**
 * Verifica la firma HMAC que RevenueCat envia en {@code X-RevenueCat-Webhook-Signature}.
 *
 * <p>Formato: {@code t=<unix_timestamp>,v1=<hmac_sha256_hex>}, calculado sobre
 * {@code "<t>.<raw_json_body>"}. El body se lee una sola vez y se reinyecta en la peticion,
 * porque {@code ServerHttpRequest.getBody()} no es reproducible: sin este paso el
 * {@code @RequestBody} del controller recibira un cuerpo vacio.
 */
@Component
public class RevenueCatWebhookFilter implements WebFilter {

    private static final String HMAC_ALGORITHM = "HmacSHA256";
    private static final String SIGNATURE_HEADER = "X-RevenueCat-Webhook-Signature";
    private static final String TIMESTAMP_KEY = "t";
    private static final String SIGNATURE_KEY = "v1";
    private static final long MAX_TIMESTAMP_DIFF_SECONDS = 5 * 60;

    @Value("${subscription.webhook-secret}")
    private String webhookSecret;

    @Override
    public Mono<Void> filter(ServerWebExchange exchange, WebFilterChain chain) {
        if (!isWebhookRequest(exchange)) {
            return chain.filter(exchange);
        }
        return readRawBody(exchange)
            .flatMap(rawBody -> verifyHmac(rawBody, exchange)
                .flatMap(isValid -> isValid
                    ? chain.filter(withRawBody(exchange, rawBody))
                    : unauthorized(exchange)));
    }

    private boolean isWebhookRequest(ServerWebExchange exchange) {
        return exchange.getRequest().getPath().value().contains("/subscriptions/webhook");
    }

    private Mono<byte[]> readRawBody(ServerWebExchange exchange) {
        return DataBufferUtils.join(exchange.getRequest().getBody())
            .map(this::readBytes)
            .defaultIfEmpty(new byte[0]);
    }

    private byte[] readBytes(DataBuffer buffer) {
        try {
            ByteBuffer byteBuffer = buffer.toByteBuffer();
            byte[] bytes = new byte[byteBuffer.remaining()];
            byteBuffer.get(bytes);
            return bytes;
        } finally {
            DataBufferUtils.release(buffer);
        }
    }

    private ServerWebExchange withRawBody(ServerWebExchange exchange, byte[] rawBody) {
        ServerHttpRequestDecorator decorator = new ServerHttpRequestDecorator(exchange.getRequest()) {
            @Override
            public Flux<DataBuffer> getBody() {
                return Flux.just(exchange.getResponse().bufferFactory().wrap(rawBody));
            }
        };
        return exchange.mutate().request(decorator).build();
    }

    private Mono<Boolean> verifyHmac(byte[] rawBody, ServerWebExchange exchange) {
        return Mono.fromCallable(() -> {
            Signature signature = parseSignature(
                exchange.getRequest().getHeaders().getFirst(SIGNATURE_HEADER));
            return signature != null && isWithinTolerance(signature.timestamp())
                && matches(signature, rawBody);
        });
    }

    /** Devuelve {@code null} si la cabecera falta o esta malformada: se rechaza con 401. */
    private Signature parseSignature(String header) {
        if (header == null || header.isBlank()) {
            return null;
        }
        Map<String, String> fields = parseFields(header);
        String timestamp = fields.get(TIMESTAMP_KEY);
        String value = fields.get(SIGNATURE_KEY);
        if (timestamp == null || value == null) {
            return null;
        }
        try {
            return new Signature(Long.parseLong(timestamp), value);
        } catch (NumberFormatException ex) {
            return null;
        }
    }

    private Map<String, String> parseFields(String header) {
        Map<String, String> fields = new HashMap<>();
        for (String part : header.split(",")) {
            String[] pair = part.split("=", 2);
            if (pair.length == 2) {
                fields.put(pair[0].trim(), pair[1].trim());
            }
        }
        return fields;
    }

    /** {@code t} viene en segundos de epoch; se compara con la hora actual en segundos. */
    private boolean isWithinTolerance(long timestampSeconds) {
        long nowSeconds = System.currentTimeMillis() / 1000;
        return Math.abs(nowSeconds - timestampSeconds) <= MAX_TIMESTAMP_DIFF_SECONDS;
    }

    private boolean matches(Signature signature, byte[] rawBody) {
        String computed = HexFormat.of().formatHex(computeHmac(signature.timestamp(), rawBody));
        return MessageDigest.isEqual(
            computed.getBytes(StandardCharsets.UTF_8),
            signature.value().getBytes(StandardCharsets.UTF_8));
    }

    private byte[] computeHmac(long timestamp, byte[] rawBody) {
        try {
            Mac mac = Mac.getInstance(HMAC_ALGORITHM);
            mac.init(new SecretKeySpec(webhookSecret.getBytes(StandardCharsets.UTF_8), HMAC_ALGORITHM));
            mac.update(Long.toString(timestamp).getBytes(StandardCharsets.UTF_8));
            mac.update((byte) '.');
            return mac.doFinal(rawBody);
        } catch (GeneralSecurityException ex) {
            throw new IllegalStateException("No se pudo calcular la firma HMAC del webhook", ex);
        }
    }

    private Mono<Void> unauthorized(ServerWebExchange exchange) {
        exchange.getResponse().setStatusCode(HttpStatus.UNAUTHORIZED);
        return exchange.getResponse().setComplete();
    }

    private record Signature(long timestamp, String value) {}
}
