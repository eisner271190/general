package {{ PACKAGE }}.infrastructure.beans;

import {{ PACKAGE }}.infrastructure.configuration.MapperInfo;
import {{ PACKAGE }}.infrastructure.persistence.dynamos.tableschema.{{ EntityCapital }}Schema;
import {{ PACKAGE }}.infrastructure.persistence.models.{{ EntityCapital }}PersistenceModel;
import {{ PACKAGE }}.infrastructure.persistence.providers.IProviderPersistence;
import {{ PACKAGE }}.infrastructure.persistence.providers.dynamodb.DynamoDbGenericPersistence;
import {{ PACKAGE }}.infrastructure.configuration.MapperClass;
import {{ PACKAGE }}.infrastructure.persistence.dynamos.{{ EntityCapital }}Dynamo;
import {{ PACKAGE }}.infrastructure.persistence.mappers.dynamos.{{ EntityCapital }}MapperDynamo;
import {{ PACKAGE }}.infrastructure.persistence.mappers.entities.{{ EntityCapital }}MapperEntity;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import software.amazon.awssdk.enhanced.dynamodb.DynamoDbEnhancedClient;

@Configuration
public class DynamoBean{{ EntityCapital }} {
    private final MapperClass mapperClass;
    private final {{ EntityCapital }}MapperDynamo mapperDynamo;
    private final {{ EntityCapital }}MapperEntity mapperEntity;

    public DynamoBean{{ EntityCapital }}
    (
        MapperClass mapperClass,
        {{ EntityCapital }}MapperDynamo mapperDynamo,
        {{ EntityCapital }}MapperEntity mapperEntity
    )
    { 
        this.mapperClass = mapperClass;
        this.mapperDynamo = mapperDynamo;
        this.mapperEntity = mapperEntity;
    }

    @Bean
    public IProviderPersistence<{{ EntityCapital }}PersistenceModel> {{ Entity }}PersistenceModel(DynamoDbEnhancedClient client) {
        MapperInfo mapperInfo = new MapperInfo();
        mapperInfo.setDynamoModelClass({{ EntityCapital }}Dynamo.class);
        mapperInfo.setPersistenceModelClass({{ EntityCapital }}PersistenceModel.class);
        mapperInfo.setMapperDynamo(mapperDynamo);
        mapperInfo.setMapperEntity(mapperEntity);
        mapperInfo.setTableName("{{ Entity }}");

        mapperClass.register(mapperInfo);

        return new DynamoDbGenericPersistence<>
        (
            client, 
            {{ EntityCapital }}PersistenceModel.class, 
            mapperClass, 
            {{ EntityCapital }}Schema.TABLE_SCHEMA
        );
    }
}