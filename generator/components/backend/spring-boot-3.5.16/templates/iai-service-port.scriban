package {{ PACKAGE }}.domain.servicePorts;

import {{ PACKAGE }}.domain.model.AiGeneration;

import reactor.core.publisher.Mono;

/**
 * Contrato de servicio de generación con IA que consume el controlador.
 *
 * <p>Permite que application y infrastructure/controllers dependan del caso de
 * uso y no del adaptador del proveedor.
 */
public interface IAiServicePort {

    /** Genera texto con IA a partir del prompt recibido. */
    Mono<AiGeneration> generate(String prompt);
}