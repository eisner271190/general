package {{ PACKAGE }}.domain.usecase;

import {{ PACKAGE }}.domain.model.AiGeneration;
import {{ PACKAGE }}.domain.ports.IAProviderPort;
import {{ PACKAGE }}.domain.servicePorts.IAiServicePort;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;

import reactor.core.publisher.Mono;

/**
 * Caso de uso de generacion con IA: delega en el puerto agnostico del proveedor.
 *
 * <p>Punto de extension para guardarrailes de prompt, registro y rate limiting futuros.
 */
@Service
public class AiUseCase implements IAiServicePort {

    private static final Logger LOG = LoggerFactory.getLogger(AiUseCase.class);

    private final IAProviderPort aiProvider;

    public AiUseCase(IAProviderPort aiProvider) {
        this.aiProvider = aiProvider;
    }

    @Override
    public Mono<AiGeneration> generate(String prompt) {
        LOG.info("Generacion de texto con IA solicitada");
        LOG.debug("Longitud del prompt: {}", prompt == null ? 0 : prompt.length());
        return aiProvider.generate(prompt)
            .doOnNext(generation -> LOG.debug(
                "Generacion completada con el modelo {}", generation.model()));
    }
}
