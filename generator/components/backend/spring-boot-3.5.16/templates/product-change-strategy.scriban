package {{ PACKAGE }}.subscription.webhook.application.strategies;

import {{ PACKAGE }}.subscription.webhook.infrastructure.configuration.WebhookLogMessages;
import {{ PACKAGE }}.subscription.subscription.domain.model.Subscription;
import {{ PACKAGE }}.subscription.subscription.domain.port.ISubscriptionPort;
import {{ PACKAGE }}.subscription.webhook.application.IWebhookStrategy;
import {{ PACKAGE }}.subscription.webhook.domain.model.WebhookEventDto;



import com.epc.common.log.ILogService;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

@Component
public class ProductChangeStrategy implements IWebhookStrategy {

    private final ILogService log;
    private final ISubscriptionPort subscriptionPort;

    public ProductChangeStrategy(ISubscriptionPort subscriptionPort, ILogService log) {
        this.log = log;
        this.subscriptionPort = subscriptionPort;
    }

    @Override
    public String eventType() {
        return "PRODUCT_CHANGE";
    }

    /**
     * Cambio de plan: sustituye producto y vencimiento por los del nuevo plan. Sin esto
     * el {@code productId} quedaba obsoleto hasta la expiracion.
     */
    @Override
    public Mono<Void> handle(WebhookEventDto event) {
        log.info(WebhookLogMessages.WEBHOOK_PROCESSING_EVENT, eventType());
        log.debug(WebhookLogMessages.WEBHOOK_USER_ID, event.userId());
        return subscriptionPort.saveSubscription(toSubscription(event)).then()
            .doOnSuccess(done ->
                log.debug(WebhookLogMessages.WEBHOOK_EVENT_APPLIED, eventType(), event.userId()));
    }

    private Subscription toSubscription(WebhookEventDto event) {
        return Subscription.active(event.userId(), event.productId(), event.store(),
            event.purchasedAtMs(), event.expirationAtMs());
    }
}
