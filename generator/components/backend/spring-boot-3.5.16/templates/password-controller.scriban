{{ if(Name == "security") }}package com.{{ Company }}.{{ Name }}.infrastructure.controllers;

import com.{{ Company }}.{{ Name }}.application.services.IPasswordService;
import com.{{ Company }}.{{ Name }}.application.dto.*;
import com.{{ Company }}.{{ Name }}.infrastructure.rest.response.ApiResponse;
import com.{{ Company }}.{{ Name }}.infrastructure.rest.response.ErrorApiResponse;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import jakarta.validation.Valid;
import reactor.core.publisher.Mono;

@RestController
@RequestMapping("/api/v1/password")
public class PasswordController {

    private final IPasswordService passwordService;

    public PasswordController(IPasswordService passwordService) {
        this.passwordService = passwordService;
    }

    @PostMapping("/admin/force-reset/{username}")
    public Mono<ResponseEntity<ApiResponse>> forcePasswordReset(@PathVariable String username) {
        ForcePasswordResetRequestDTO request = new ForcePasswordResetRequestDTO();
        request.setUsername(username);
        
        return passwordService.forcePasswordReset(request)
                .then(Mono.fromCallable(() -> {
                    ApiResponse response = new ApiResponse(null, "Contraseña restablecida exitosamente", HttpStatus.OK.value());
                    return ResponseEntity.ok().body(response);
                }))
                .onErrorResume(e -> {
                    ErrorApiResponse errorResponse = ErrorApiResponse.createErrorResponse(
                            null,
                            "Error al restablecer la contraseña",
                            HttpStatus.BAD_REQUEST.value(),
                            e.getMessage()
                    );
                    return Mono.just(ResponseEntity.status(HttpStatus.BAD_REQUEST).body(errorResponse));
                });
    }

    @PutMapping("/change")
    public Mono<ResponseEntity<ApiResponse>> changePassword(@Valid @RequestBody ChangePasswordRequestDTO request) {
        return passwordService.changePassword(request)
                .then(Mono.fromCallable(() -> {
                    ApiResponse response = new ApiResponse(null, "Contraseña cambiada exitosamente", HttpStatus.OK.value());
                    return ResponseEntity.ok().body(response);
                }))
                .onErrorResume(e -> {
                    ErrorApiResponse errorResponse = ErrorApiResponse.createErrorResponse(
                            null,
                            "Error al cambiar la contraseña",
                            HttpStatus.BAD_REQUEST.value(),
                            e.getMessage()
                    );
                    return Mono.just(ResponseEntity.status(HttpStatus.BAD_REQUEST).body(errorResponse));
                });
    }

    @PostMapping("/forgot")
    public Mono<ResponseEntity<ApiResponse>> recoverPassword(@Valid @RequestBody RecoverPasswordRequestDTO request) {
        return passwordService.recoverPassword(request)
                .then(Mono.fromCallable(() -> {
                    ApiResponse response = new ApiResponse(null, "Se ha enviado un código de recuperación a tu correo electrónico", HttpStatus.OK.value());
                    return ResponseEntity.ok().body(response);
                }))
                .onErrorResume(e -> {
                    ErrorApiResponse errorResponse = ErrorApiResponse.createErrorResponse(
                            null,
                            "Error al iniciar la recuperación de contraseña",
                            HttpStatus.BAD_REQUEST.value(),
                            e.getMessage()
                    );
                    return Mono.just(ResponseEntity.status(HttpStatus.BAD_REQUEST).body(errorResponse));
                });
    }
}
{{ end }}
