package {{ PACKAGE }}.infrastructure.controllers;

import com.epc.common.log.ILogService;
import {{ PACKAGE }}.infrastructure.configuration.DomainLogMessages;
import {{ PACKAGE }}.infrastructure.configuration.cloud.aws.SnsEventPublisher;
import org.springframework.web.bind.annotation.*;
import org.springframework.http.ResponseEntity;

@RestController
@RequestMapping("/sns")
public class SNSController {

    private final ILogService log;
    private final SnsEventPublisher snsEventPublisher;

    public SNSController(SnsEventPublisher snsEventPublisher, ILogService log) {
        this.log = log;
        this.snsEventPublisher = snsEventPublisher;
    }

    @PostMapping("/publish")
    public ResponseEntity<String> publish(@RequestParam("message") String message) {
        log.info(DomainLogMessages.SNS_PUBLISH_ENDPOINT, message.length());
        snsEventPublisher.publishEvent("product.created", message);
        log.debug(DomainLogMessages.SNS_PUBLISH_DONE);
        return ResponseEntity.ok("Mensaje enviado a SNS.");
    }
}