{{ if(Name == "security") }}package {{ PACKAGE }}.security.adminuser.infrastructure.adapters;

import {{ PACKAGE }}.security.auth.infrastructure.adapters.CognitoAdapter;
import {{ PACKAGE }}.common.infrastructure.configuration.DomainLogMessages;
import {{ PACKAGE }}.security.adminuser.domain.port.AdminUserPort;



import com.epc.common.log.ILogService;

import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

@Component
public class AdminUserAdapter implements AdminUserPort {

    private final ILogService log;
    private final CognitoAdapter cognitoClient;

    public AdminUserAdapter(CognitoAdapter cognitoClient, ILogService log) {
        this.log = log;
        this.cognitoClient = cognitoClient;
    }

    @Override
    public Mono<Void> deleteUser(String username) {
        log.info(DomainLogMessages.USER_DELETING, username);
        return cognitoClient.deleteUser(username)
            .doOnSuccess(done -> log.debug(DomainLogMessages.USER_DELETED, username));
    }

    @Override
    public Mono<Void> activateUser(String username) {
        log.info(DomainLogMessages.USER_ACTIVATING, username);
        return cognitoClient.updateUserStatus(username, true)
            .doOnSuccess(done -> log.debug(DomainLogMessages.USER_ACTIVATED, username));
    }

    @Override
    public Mono<Void> deactivateUser(String username) {
        log.info(DomainLogMessages.USER_DEACTIVATING, username);
        return cognitoClient.updateUserStatus(username, false)
            .doOnSuccess(done -> log.debug(DomainLogMessages.USER_DEACTIVATED, username));
    }
}
{{ end }}