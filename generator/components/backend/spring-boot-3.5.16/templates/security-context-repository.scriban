{{ if(Name == "security") }}package {{ PACKAGE }}.infrastructure.configuration.authentication.jwt;

import com.epc.common.log.ILogService;
import {{ PACKAGE }}.infrastructure.configuration.DomainLogMessages;
import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
import org.springframework.security.core.context.SecurityContext;
import org.springframework.security.core.context.SecurityContextImpl;
import org.springframework.security.web.server.context.ServerSecurityContextRepository;
import org.springframework.stereotype.Component;
import org.springframework.web.server.ServerWebExchange;
import reactor.core.publisher.Mono;

@Component
public class SecurityContextRepository implements ServerSecurityContextRepository {

    private final ILogService log;
    private final JwtAuthenticationManager jwtAuthenticationManager;

    public SecurityContextRepository(JwtAuthenticationManager jwtAuthenticationManager, ILogService log) {
        this.log = log;
        this.jwtAuthenticationManager = jwtAuthenticationManager;
    }

    /** No se persiste el contexto: la Lambda es stateless y el token viaja en cada peticion. */
    @Override
    public Mono<Void> save(ServerWebExchange exchange, SecurityContext context) {
        log.debug(DomainLogMessages.SECURITY_CONTEXT_NOT_STORED);
        return Mono.empty();
    }

    @Override
    public Mono<SecurityContext> load(ServerWebExchange exchange) {
        String token = exchange.getAttribute("token");
        log.debug(DomainLogMessages.SECURITY_CONTEXT_LOADING, token != null);
        return jwtAuthenticationManager.authenticate(new UsernamePasswordAuthenticationToken(token, token))
                .map(SecurityContextImpl::new)
                .doOnNext(context -> log.debug(DomainLogMessages.SECURITY_CONTEXT_LOADED));
    }
}
{{ end }}