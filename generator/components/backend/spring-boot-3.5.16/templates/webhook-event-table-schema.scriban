package {{ PACKAGE }}.subscription.webhook.infrastructure.persistence.dynamos.tableschema;

import {{ PACKAGE }}.subscription.webhook.infrastructure.persistence.entities.WebhookEventEntity;



import org.springframework.stereotype.Component;
import software.amazon.awssdk.enhanced.dynamodb.DynamoDbEnhancedClient;
import software.amazon.awssdk.enhanced.dynamodb.DynamoDbTable;
import software.amazon.awssdk.enhanced.dynamodb.TableSchema;

@Component
public class WebhookEventTableSchema {

    private final DynamoDbTable<WebhookEventEntity> table;

    public WebhookEventTableSchema(DynamoDbEnhancedClient dynamoDbEnhancedClient) {
        this.table = dynamoDbEnhancedClient.table("{{ Name }}WebhookEvent", TableSchema.fromBean(WebhookEventEntity.class));
    }

    public DynamoDbTable<WebhookEventEntity> getTable() {
        return table;
    }
}
