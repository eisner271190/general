package {{ PACKAGE }}.domain.usecase;

import {{ PACKAGE }}.domain.dto.SubscriptionStatusResponseDTO;
import {{ PACKAGE }}.domain.model.Subscription;
import {{ PACKAGE }}.domain.ports.ISubscriptionProviderPort;
import {{ PACKAGE }}.domain.ports.SubscriptionPort;
import {{ PACKAGE }}.domain.servicePorts.ISubscriptionServicePort;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

@Service
public class SubscriptionUseCase implements ISubscriptionServicePort {

    private static final Logger LOG = LoggerFactory.getLogger(SubscriptionUseCase.class);

    private final SubscriptionPort subscriptionPort;
    private final ISubscriptionProviderPort subscriptionProvider;

    public SubscriptionUseCase(SubscriptionPort subscriptionPort, ISubscriptionProviderPort subscriptionProvider) {
        this.subscriptionPort = subscriptionPort;
        this.subscriptionProvider = subscriptionProvider;
    }

    /**
     * Solo sirve de caché la suscripcion que da acceso. Un registro INACTIVE (guardado en una
     * consulta anterior) no enmiende: si no, una compra posterior quedaria enmascarada hasta que
     * un webhook la corrigiera.
     */
    @Override
    public Mono<SubscriptionStatusResponseDTO> getStatus(String userId) {
        LOG.info("Consultando estado de suscripcion para userId={}", userId);
        return subscriptionPort.findSubscriptionByUserId(userId)
            .filter(Subscription::isActive)
            .switchIfEmpty(fetchAndCacheFromProvider(userId))
            .map(this::toResponse)
            .doOnNext(response -> LOG.debug("Estado resuelto para userId={}: isActive={}",
                userId, response.isActive()));
    }

    @Override
    public Mono<SubscriptionStatusResponseDTO> syncFromProvider(String userId) {
        LOG.info("Sincronizando suscripcion con el proveedor para userId={}", userId);
        return subscriptionProvider.fetchSubscription(userId)
            .flatMap(this::saveAndMap)
            .switchIfEmpty(saveInactive(userId).map(this::toResponse))
            .doOnNext(response -> LOG.debug("Sincronizacion terminada para userId={}: isActive={}",
                userId, response.isActive()));
    }

    /**
     * Cachea lo que diga el proveedor. Si no hay suscripcion, deja INACTIVE en almacenamiento
     * para que las siguientes consultas no vuelvan a llamar a la API (plan 5.4).
     *
     * <p>Sin este ultimo {@code switchIfEmpty} el Mono quedaba vacio y el controller respondia
     * sin {@code data} en lugar de {@code isActive:false}.
     */
    private Mono<Subscription> fetchAndCacheFromProvider(String userId) {
        return subscriptionProvider.fetchSubscription(userId)
            .flatMap(subscriptionPort::saveSubscription)
            .switchIfEmpty(saveInactive(userId));
    }

    private Mono<SubscriptionStatusResponseDTO> saveAndMap(Subscription subscription) {
        return subscriptionPort.saveSubscription(subscription)
            .map(this::toResponse);
    }

    private Mono<Subscription> saveInactive(String userId) {
        return subscriptionPort.saveSubscription(Subscription.inactive(userId));
    }

    private SubscriptionStatusResponseDTO toResponse(Subscription subscription) {
        return new SubscriptionStatusResponseDTO(
            subscription.isActive(),
            subscription.getProductId(),
            subscription.getExpirationAtMs()
        );
    }
}