{{ if(Name == "security") }}package {{ PACKAGE }}.domain.usecase;

import {{ PACKAGE }}.domain.servicePorts.PasswordServicePort;
import {{ PACKAGE }}.domain.ports.PasswordPort;
import {{ PACKAGE }}.domain.model.*;

import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

@Service
public class PasswordUseCase implements PasswordServicePort {

    private final PasswordPort passwordPort;

    public PasswordUseCase(PasswordPort passwordPort) {
        this.passwordPort = passwordPort;
    }

    @Override
    public Mono<Void> forcePasswordReset(ForcePasswordReset request) {
        return passwordPort.forcePasswordReset(request);
    }

    @Override
    public Mono<Void> changePassword(ChangePassword request) {
        return passwordPort.changePassword(request);
    }

    @Override
    public Mono<Void> recoverPassword(RecoverPassword request) {
        return passwordPort.recoverPassword(request);
    }
}
{{ end }}
