package {{ PACKAGE }}.infrastructure.configuration;

import org.springframework.stereotype.Component;

import java.util.LinkedHashMap;
import java.util.Map;
import java.util.Set;

/**
 * Parametros publicos que el frontend consulta en GET /api/v1/parameters.
 *
 * <p>Lee todas las variables de entorno de la Lambda y devuelve todas excepto
 * las definidas en {@link #EXCLUDED}: secretos, credenciales AWS e internos
 * de Lambda/X-Ray. Cualquier variable nueva debe agregarse a esa lista.
 */
@Component
public class ParameterProperties {

  private static final Set<String> EXCLUDED = Set.of(
      "_AWS_XRAY_DAEMON_ADDRESS",
      "_AWS_XRAY_DAEMON_PORT",
      "_HANDLER",
      "ADMOB_BANNER_ID",
      "AWS_ACCESS_KEY_ID",
      "AWS_ACCOUNT_ID",
      "AWS_DEFAULT_REGION",
      "AWS_EXECUTION_ENV",
      "AWS_LAMBDA_FUNCTION_MEMORY_SIZE",
      "AWS_LAMBDA_FUNCTION_NAME",
      "AWS_LAMBDA_FUNCTION_VERSION",
      "AWS_LAMBDA_INITIALIZATION_TYPE",
      "AWS_LAMBDA_LOG_GROUP_NAME",
      "AWS_LAMBDA_LOG_STREAM_NAME",
      "AWS_LAMBDA_METADATA_API",
      "AWS_LAMBDA_METADATA_TOKEN",
      "AWS_LAMBDA_RUNTIME_API",
      "AWS_REGION",
      "AWS_SECRET_ACCESS_KEY",
      "AWS_SESSION_TOKEN",
      "AWS_XRAY_CONTEXT_MISSING",
      "AWS_XRAY_DAEMON_ADDRESS",
      "HANDLER",
      "LANG",
      "LAMBDA_RUNTIME_DIR",
      "LAMBDA_TASK_ROOT",
      "LD_LIBRARY_PATH",
      "PATH",
      "REVENUECAT_PUBLIC_KEY",
      "SHLVL",
      "SPRING_PROFILES_ACTIVE",
      "TZ"
  );

  /** Variables de entorno aptas para el cliente: todas menos las excluidas. */
  public Map<String, String> getPublicParameters() {
    Map<String, String> parameters = new LinkedHashMap<>();
    System.getenv().forEach((key, value) -> {
      if (!EXCLUDED.contains(key)) {
        parameters.put(key, value);
      }
    });
    return parameters;
  }
}
