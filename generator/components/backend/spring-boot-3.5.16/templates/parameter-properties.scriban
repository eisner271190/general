package {{ PACKAGE }}.parameter.parameter.infrastructure.configuration;

import io.awspring.cloud.parameterstore.ParameterStorePropertySource;

import org.springframework.core.env.ConfigurableEnvironment;
import org.springframework.core.env.EnumerablePropertySource;
import org.springframework.core.env.PropertySource;
import org.springframework.stereotype.Component;

import java.util.LinkedHashMap;
import java.util.Map;
import java.util.Set;

/**
 * Parametros publicos que el frontend consulta en GET /api/v1/parameters.
 *
 * <p>Lee los parametros importados desde AWS Parameter Store (perfil cloud) y devuelve todos
 * excepto los definidos en {@link #EXCLUDED}: secretos, credenciales AWS e internos de
 * Lambda/X-Ray. Los secretos de Secrets Manager no se exponen: viven en otro property source.
 * Cualquier parametro nuevo debe agregarse a la lista de exclusion si es sensible.
 */
@Component
public class ParameterProperties {

  private static final Set<String> EXCLUDED = Set.of(
      "_AWS_XRAY_DAEMON_ADDRESS",
      "_AWS_XRAY_DAEMON_PORT",
      "_HANDLER",
      // Configuracion interna del proveedor de IA: no es secreta, pero el cliente no la
      // usa y publicarla revelaria proveedor y modelo en un endpoint publico sin auth.
      "AI_API_BASE_URL",
      "AI_MAX_TOKENS",
      "AI_MODEL",
      "AI_TEMPERATURE",
      "AWS_ACCESS_KEY_ID",
      "AWS_ACCOUNT_ID",
      "AWS_DEFAULT_REGION",
      "AWS_EXECUTION_ENV",
      "AWS_LAMBDA_FUNCTION_MEMORY_SIZE",
      "AWS_LAMBDA_FUNCTION_NAME",
      "AWS_LAMBDA_FUNCTION_VERSION",
      "AWS_LAMBDA_INITIALIZATION_TYPE",
      "AWS_LAMBDA_LOG_GROUP_NAME",
      "AWS_LAMBDA_LOG_STREAM_NAME",
      "AWS_LAMBDA_METADATA_API",
      "AWS_LAMBDA_METADATA_TOKEN",
      "AWS_LAMBDA_RUNTIME_API",
      "AWS_REGION",
      "AWS_SECRET_ACCESS_KEY",
      "AWS_SESSION_TOKEN",
      "AWS_XRAY_CONTEXT_MISSING",
      "AWS_XRAY_DAEMON_ADDRESS",
      "HANDLER",
      "LANG",
      "LAMBDA_RUNTIME_DIR",
      "LAMBDA_TASK_ROOT",
      "LD_LIBRARY_PATH",
      "PATH",
      "SHLVL",
      "SPRING_PROFILES_ACTIVE",
      "TZ"
  );

  private final ConfigurableEnvironment environment;

  public ParameterProperties(ConfigurableEnvironment environment) {
    this.environment = environment;
  }

  /** Parametros de Parameter Store aptos para el cliente: todos menos los excluidos. */
  public Map<String, String> getPublicParameters() {
    Map<String, String> parameters = new LinkedHashMap<>();
    environment.getPropertySources().forEach(source -> collectIfParameterStore(source, parameters));
    return parameters;
  }

  private void collectIfParameterStore(PropertySource<?> source, Map<String, String> parameters) {
    if (!isParameterStoreSource(source) || !(source instanceof EnumerablePropertySource<?> values)) {
      return;
    }
    for (String name : values.getPropertyNames()) {
      if (!EXCLUDED.contains(name)) {
        Object value = values.getProperty(name);
        if (value != null) {
          parameters.put(name, value.toString());
        }
      }
    }
  }

  /**
   * La fuente de Parameter Store lleva la ruta absoluta del import como nombre
   * (/entorno/applicationId/microservicio/); el instanceof cubre el nombre del tipo.
   *
   * <p>El prefijo {@code /} es una heuristica, no una garantia: hoy no filtra secretos porque
   * el secreto de la app se llama {@code environment/applicationId} (sin {@code /} inicial)
   * y no es un ParameterStorePropertySource. Si alguna vez el secreto empezara por {@code /},
   * hay que comprobar el tipo de clase antes que el nombre.
   */
  private static boolean isParameterStoreSource(PropertySource<?> source) {
    return source instanceof ParameterStorePropertySource || source.getName().startsWith("/");
  }
}
