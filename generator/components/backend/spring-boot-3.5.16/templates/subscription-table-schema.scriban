package {{ PACKAGE }}.infrastructure.persistence.dynamos.tableschema;

import {{ PACKAGE }}.infrastructure.persistence.entities.SubscriptionEntity;
import org.springframework.stereotype.Component;
import software.amazon.awssdk.enhanced.dynamodb.DynamoDbEnhancedClient;
import software.amazon.awssdk.enhanced.dynamodb.DynamoDbTable;
import software.amazon.awssdk.enhanced.dynamodb.TableSchema;

@Component
public class SubscriptionTableSchema {

    private final DynamoDbTable<SubscriptionEntity> table;

    public SubscriptionTableSchema(DynamoDbEnhancedClient dynamoDbEnhancedClient) {
        this.table = dynamoDbEnhancedClient.table("{{ Name }}Subscription", TableSchema.fromBean(SubscriptionEntity.class));
    }

    public DynamoDbTable<SubscriptionEntity> getTable() {
        return table;
    }
}
