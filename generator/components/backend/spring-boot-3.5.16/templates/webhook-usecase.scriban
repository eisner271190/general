package {{ PACKAGE }}.domain.usecase;

import {{ PACKAGE }}.domain.dto.WebhookEventDTO;
import {{ PACKAGE }}.domain.servicePorts.IWebhookServicePort;
import {{ PACKAGE }}.domain.usecase.strategies.UnknownEventStrategy;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

import java.util.List;
import java.util.Map;
import java.util.function.Function;
import java.util.stream.Collectors;

@Service
public class WebhookUseCase implements IWebhookServicePort {

    private static final Logger LOG = LoggerFactory.getLogger(WebhookUseCase.class);

    private final Map<String, IWebhookStrategy> strategiesByEventType;
    private final IWebhookStrategy unknownEventStrategy;

    public WebhookUseCase(List<IWebhookStrategy> strategies, UnknownEventStrategy unknownEventStrategy) {
        this.strategiesByEventType = indexByEventType(strategies);
        this.unknownEventStrategy = unknownEventStrategy;
        LOG.debug("Estrategias de webhook registradas: {}", this.strategiesByEventType.keySet());
    }

    @Override
    public Mono<Void> processWebhook(WebhookEventDTO event) {
        IWebhookStrategy strategy = findStrategy(event.getType());
        LOG.info("Webhook recibido: tipo={}, userId={}, estrategia={}",
            event.getType(), event.userId(), strategy.eventType());
        return strategy.handle(event)
            .doOnSuccess(done -> LOG.debug("Webhook {} procesado", event.getType()));
    }

    private IWebhookStrategy findStrategy(String eventType) {
        return strategiesByEventType.getOrDefault(eventType, unknownEventStrategy);
    }

    /** Spring inyecta el mapa de beans con el nombre de bean como clave; la clave util es el eventType. */
    private static Map<String, IWebhookStrategy> indexByEventType(List<IWebhookStrategy> strategies) {
        return strategies.stream()
            .collect(Collectors.toMap(IWebhookStrategy::eventType, Function.identity()));
    }
}