resource "aws_ecr_repository" "{{ Name }}" {
    name = "{{ Name }}"
    lifecycle {
        prevent_destroy = false
    }

    force_delete = true
}
output "ecr_{{ Name }}_url" {
    value = aws_ecr_repository.{{ Name }}.repository_url
}
output "ecr_{{ Name }}_arn" {
    value = aws_ecr_repository.{{ Name }}.arn
}