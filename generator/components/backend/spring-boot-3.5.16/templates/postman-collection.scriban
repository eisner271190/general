{{ open_b = "{" + "{" }}{{ close_b = "}" + "}" }}{
  "info": {
    "name": "{{ MicroserviceName }}",
    "description": "Colección de endpoints del microservicio {{ MicroserviceName }}.\n\nURL BASE (API Gateway):\n  Se rellena sola al ejecutar cloud/up.ps1 (tras el apply escribe terraform output http_api_url en esta colección).\n  Manual: cd cloud/terraform/{{ MicroserviceName }} && terraform output http_api_url -> pegar en la variable baseUrl.\n\nAUTENTICACIÓN:\n  - Ejecutar Users > Login para guardar el token (variable token) y el usuario (variable username).\n  - Las rutas de identidad /api/v1/users/** son públicas; el resto requiere Authorization: Bearer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Configura baseUrl (terraform output http_api_url)', function () { pm.expect(pm.collectionVariables.get('baseUrl'), 'Falta baseUrl').to.not.be.empty; });"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "username", "value": "demo", "type": "string" }
  ],
  "item": [
    {
      "name": "Hola Mundo",
      "item": [
        {
          "name": "Hello",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 2xx', function () { pm.response.to.have.success; });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ open_b }}baseUrl{{ close_b }}/{{ Name }}/hello",
              "host": ["{{ open_b }}baseUrl{{ close_b }}"],
              "path": ["{{ Name }}", "hello"]
            },
            "description": "Saludo del microservicio (siempre disponible)."
          },
          "response": [
            {
              "name": "OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"data\":{\"data\":\"Hola Mundo\"},\"message\":\"Hola Mundo\",\"status\":200,\"timestamp\":\"2026-01-01T00:00:00\"}"
            }
          ]
        },
        {
          "name": "Error",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 2xx', function () { pm.response.to.have.success; });"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ open_b }}baseUrl{{ close_b }}/{{ Name }}/error",
              "host": ["{{ open_b }}baseUrl{{ close_b }}"],
              "path": ["{{ Name }}", "error"]
            },
            "description": "Prueba del manejo de errores del microservicio."
          },
          "response": [
            {
              "name": "Error",
              "status": "Internal Server Error",
              "code": 500,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"data\":null,\"message\":\"Error interno\",\"status\":500,\"timestamp\":\"2026-01-01T00:00:00\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "Actuator",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 2xx', function () { pm.response.to.have.success; });",
                  "pm.test('Servicio UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ open_b }}baseUrl{{ close_b }}/actuator/health",
              "host": ["{{ open_b }}baseUrl{{ close_b }}"],
              "path": ["actuator", "health"]
            },
            "description": "Salud del microservicio. Ruta fija del API Gateway (no lleva el prefijo del microservicio); pública, sin Authorization."
          },
          "response": [
            {
              "name": "UP",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"status\":\"UP\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "SNS",
      "item": [
        {
          "name": "Publish",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 2xx', function () { pm.response.to.have.success; });"]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ open_b }}token{{ close_b }}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{ open_b }}baseUrl{{ close_b }}/sns/publish?message=Hola+Mundo",
              "host": ["{{ open_b }}baseUrl{{ close_b }}"],
              "path": ["sns", "publish"],
              "query": [{ "key": "message", "value": "Hola+Mundo" }]
            },
            "description": "Publica un mensaje en el tema SNS del microservicio."
          },
          "response": [
            {
              "name": "OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "text",
              "header": [{ "key": "Content-Type", "value": "text/plain" }],
              "body": "Mensaje publicado en SNS."
            }
          ]
        }
      ]
    }{{ if ConsumedEvents.size > 0 }},
    {
      "name": "SQS",
      "item": [
        {
          "name": "Send",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 2xx', function () { pm.response.to.have.success; });"]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ open_b }}token{{ close_b }}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{ open_b }}baseUrl{{ close_b }}/sqs/send?message=Hola+Mundo",
              "host": ["{{ open_b }}baseUrl{{ close_b }}"],
              "path": ["sqs", "send"],
              "query": [{ "key": "message", "value": "Hola+Mundo" }]
            },
            "description": "Envía un mensaje a la cola SQS."
          },
          "response": [
            {
              "name": "OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "text",
              "header": [{ "key": "Content-Type", "value": "text/plain" }],
              "body": "Mensaje enviado a SQS."
            }
          ]
        },
        {
          "name": "Consume",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 2xx', function () { pm.response.to.have.success; });"]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ open_b }}token{{ close_b }}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ open_b }}baseUrl{{ close_b }}/sqs/consume",
              "host": ["{{ open_b }}baseUrl{{ close_b }}"],
              "path": ["sqs", "consume"]
            },
            "description": "Consume mensajes pendientes de la cola SQS."
          },
          "response": [
            {
              "name": "OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\"Mensaje de ejemplo\"]"
            }
          ]
        }
      ]
    }{{ end }}{{ if(Name == "security") }},
    {
      "name": "Auth",
      "item": [
        {
          "name": "Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 2xx', function () { pm.response.to.have.success; });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.data.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{ open_b }}username{{ close_b }}\",\n  \"password\": \"Passw0rd!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{ open_b }}baseUrl{{ close_b }}/api/v1/auth/token",
              "host": ["{{ open_b }}baseUrl{{ close_b }}"],
              "path": ["api", "v1", "auth", "token"]
            },
            "description": "Genera un token JWT. Requiere Authorization: Bearer."
          },
          "response": [
            {
              "name": "OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"data\":{\"data\":{\"accessToken\":\"eyJhbGciOi...\"}},\"message\":\"Token generado exitosamente\",\"status\":200,\"timestamp\":\"2026-01-01T00:00:00\"}"
            },
            {
              "name": "Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"data\":null,\"message\":\"Error al generar el token\",\"status\":401,\"timestamp\":\"2026-01-01T00:00:00\"}"
            }
          ]
        },
        {
          "name": "Exchange",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 2xx', function () { pm.response.to.have.success; });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.data.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ open_b }}token{{ close_b }}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"authorization-code\",\n  \"codeVerifier\": \"code-verifier\",\n  \"redirectUri\": \"https://example.com/callback\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{ open_b }}baseUrl{{ close_b }}/api/v1/auth/exchange",
              "host": ["{{ open_b }}baseUrl{{ close_b }}"],
              "path": ["api", "v1", "auth", "exchange"]
            },
            "description": "Intercambia el código de autorización por tokens (PKCE)."
          },
          "response": [
            {
              "name": "OK",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"data\":{\"data\":{\"accessToken\":\"eyJhbGciOi...\",\"idToken\":\"eyJhbGciOi...\",\"refreshToken\":\"...\",\"expiresIn\":3600,\"tokenType\":\"Bearer\"}},\"message\":\"Código intercambiado exitosamente\",\"status\":200,\"timestamp\":\"2026-01-01T00:00:00\"}"
            }
          ]
        }
      ]
    },
