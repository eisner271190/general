import com.{{ Company }}.{{ Name }}.domain.model.*;

import reactor.core.publisher.Mono;

public interface IUserServicePort {

    Mono<TokenResponse> generateToken(TokenRequest request);

    Mono<Void> registerUserByAdmin(RegisterUser request);

    Mono<Void> registerUser(RegisterUser request);
    
    Mono<Void> confirmUser(ConfirmUser request);

    Mono<Void> forcePasswordReset(ForcePasswordReset request);

    Mono<Void> changePassword(ChangePassword request);

    Mono<Void> recoverPassword(RecoverPassword request);

    Mono<Void> deleteUser(String username);

    Mono<Void> activateUser(String username);

    Mono<Void> deactivateUser(String username);
}
