package {{ PACKAGE }}.parameter.parameter.infrastructure.rest;

import {{ PACKAGE }}.parameter.parameter.infrastructure.configuration.ParameterProperties;



import com.epc.common.error.ApiResponse;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.springframework.core.env.ConfigurableEnvironment;
import org.springframework.core.env.MapPropertySource;
import org.springframework.core.env.StandardEnvironment;
import org.springframework.http.HttpStatus;
import org.springframework.test.web.reactive.server.WebTestClient;

import java.util.LinkedHashMap;
import java.util.Map;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertFalse;
import static org.junit.jupiter.api.Assertions.assertTrue;
import static org.mockito.Mockito.when;

public class ParameterControllerTest {

  @Mock
  private ParameterProperties parameterProperties;

  private WebTestClient webTestClient;

  @BeforeEach
  public void setup() {
    MockitoAnnotations.openMocks(this);
    webTestClient = createWebTestClient(new ParameterController(parameterProperties));
  }

  @Test
  public void testGetParameters_ReturnsPublicParameters() {
    when(parameterProperties.getPublicParameters())
        .thenReturn(Map.of("api-url", "https://api.openrouter.ai/api/v1", "model", "gpt-4o-mini"));

    webTestClient.get()
        .uri("/api/v1/parameters")
        .exchange()
        .expectStatus().isOk()
        .expectBody(ApiResponse.class)
        .value(response -> {
          assertEquals("Parameters retrieved successfully", response.getMessage());
          assertEquals(HttpStatus.OK.value(), response.getStatus());

          Map<String, Object> data = response.getData();
          assertEquals("https://api.openrouter.ai/api/v1", data.get("api-url"));
          assertEquals("gpt-4o-mini", data.get("model"));
        });
  }

  @Test
  public void testGetParameters_OmitsSensitiveParameter() {
    // El controller NO filtra: devuelve tal cual getPublicParameters(). El filtro real
    // vive en ParameterProperties.EXCLUDED sobre las fuentes de Parameter Store, por lo
    // que aqui se usa la instancia real y no el mock (con el mock el controller devolveria
    // las claves sensibles tal cual y el test fallaria).
    ConfigurableEnvironment environment = new StandardEnvironment();
    Map<String, Object> store = new LinkedHashMap<>();
    store.put("model", "gpt-4o-mini");
    store.put("SUBSCRIPTION_API_BASE_URL", "https://api.revenuecat.com/v1/");
    store.put("AWS_SECRET_ACCESS_KEY", "no-debe-exponerse");
    store.put("PATH", "/usr/bin");
    environment.getPropertySources()
        .addFirst(new MapPropertySource("/develop/com.quizsmart.app/quizapi/", store));

    WebTestClient client =
        createWebTestClient(new ParameterController(new ParameterProperties(environment)));

    client.get()
        .uri("/api/v1/parameters")
        .exchange()
        .expectStatus().isOk()
        .expectBody(ApiResponse.class)
        .value(response -> {
          Map<String, Object> data = response.getData();
          assertEquals("gpt-4o-mini", data.get("model"));
          assertEquals("https://api.revenuecat.com/v1/", data.get("SUBSCRIPTION_API_BASE_URL"));
          assertFalse(data.containsKey("AWS_SECRET_ACCESS_KEY"));
          assertFalse(data.containsKey("PATH"));
        });
  }

  @Test
  public void testGetParameters_EmptyConfigReturnsEmptyMap() {
    when(parameterProperties.getPublicParameters()).thenReturn(Map.of());

    webTestClient.get()
        .uri("/api/v1/parameters")
        .exchange()
        .expectStatus().isOk()
        .expectBody(ApiResponse.class)
        .value(response -> assertTrue(response.getData().isEmpty()));
  }

  private WebTestClient createWebTestClient(ParameterController controller) {
    return WebTestClient.bindToController(controller).build();
  }
}
