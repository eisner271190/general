{{- if ConsumedEvents.size > 0 }}package com.{{ Company }}.{{ Name }}.infrastructure.controllers;

import com.{{ Company }}.{{ Name }}.infrastructure.configuration.cloud.aws.SqsReceiver;
import org.springframework.web.bind.annotation.*;
import org.springframework.http.ResponseEntity;

import java.util.List;

@RestController
@RequestMapping("/sqs")
public class SQSController {

    private final SqsReceiver sqsReceiver;

    public SQSController(SqsReceiver sqsReceiver) {
        this.sqsReceiver = sqsReceiver;
    }

    @PostMapping("/send")
    public ResponseEntity<String> sendMessage(@RequestParam("message") String message) {
        sqsReceiver.sendMessage(message);
        return ResponseEntity.ok("Mensaje enviado a SQS.");
    }

    @GetMapping("/consume")
    public ResponseEntity<List<String>> consumeMessages() {
        List<String> messages = sqsReceiver.receiveMessages();
        return ResponseEntity.ok(messages);
    }
}{{ end }}