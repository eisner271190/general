{{- if ConsumedEvents.size > 0 }}package {{ PACKAGE }}.infrastructure.controllers;

import com.epc.common.log.ILogService;
import {{ PACKAGE }}.infrastructure.configuration.DomainLogMessages;
import {{ PACKAGE }}.infrastructure.configuration.cloud.aws.SqsReceiver;
import org.springframework.web.bind.annotation.*;
import org.springframework.http.ResponseEntity;

import java.util.List;

@RestController
@RequestMapping("/sqs")
public class SQSController {

    private final ILogService log;
    private final SqsReceiver sqsReceiver;

    public SQSController(SqsReceiver sqsReceiver, ILogService log) {
        this.log = log;
        this.sqsReceiver = sqsReceiver;
    }

    @PostMapping("/send")
    public ResponseEntity<String> sendMessage(@RequestParam("message") String message) {
        log.info(DomainLogMessages.SQS_SEND_ENDPOINT, message.length());
        sqsReceiver.sendMessage(message);
        log.debug(DomainLogMessages.SQS_QUEUED);
        return ResponseEntity.ok("Mensaje enviado a SQS.");
    }

    @GetMapping("/consume")
    public ResponseEntity<List<String>> consumeMessages() {
        log.info(DomainLogMessages.SQS_CONSUME_ENDPOINT);
        List<String> messages = sqsReceiver.receiveMessages();
        log.debug(DomainLogMessages.SQS_RECEIVED_COUNT, messages.size());
        return ResponseEntity.ok(messages);
    }
}{{ end }}