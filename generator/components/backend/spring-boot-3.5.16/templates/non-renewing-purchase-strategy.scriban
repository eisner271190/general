package {{ PACKAGE }}.domain.usecase.strategies;

import {{ PACKAGE }}.application.dto.WebhookEventDTO;
import {{ PACKAGE }}.domain.model.Subscription;
import {{ PACKAGE }}.domain.ports.SubscriptionPort;
import {{ PACKAGE }}.domain.usecase.IWebhookStrategy;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

@Component
public class NonRenewingPurchaseStrategy implements IWebhookStrategy {

    private final SubscriptionPort subscriptionPort;

    public NonRenewingPurchaseStrategy(SubscriptionPort subscriptionPort) {
        this.subscriptionPort = subscriptionPort;
    }

    @Override
    public String eventType() {
        return "NON_RENEWING_PURCHASE";
    }

    /**
     * Compra sin renovacion automatica: da acceso hasta {@code expirationAtMs} y despues
     * no se renueva, por lo que la suscripcion queda inactiva al expirar.
     */
    @Override
    public Mono<Void> handle(WebhookEventDTO event) {
        return subscriptionPort.saveSubscription(toSubscription(event)).then();
    }

    private Subscription toSubscription(WebhookEventDTO event) {
        return Subscription.active(event.userId(), event.productId(), event.store(),
            event.purchasedAtMs(), event.expirationAtMs());
    }
}
