{{ if(Name == "security") }}package {{ PACKAGE }}.infrastructure.controllers;

import {{ PACKAGE }}.application.services.IAdminUserService;
import com.epc.common.error.ApiResponse;
import com.epc.common.error.ErrorApiResponse;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import reactor.core.publisher.Mono;

@RestController
@RequestMapping("/api/v1/admin/users")
public class AdminUserController {

    private final IAdminUserService adminUserService;

    public AdminUserController(IAdminUserService adminUserService) {
        this.adminUserService = adminUserService;
    }

    @DeleteMapping("/{username}")
    public Mono<ResponseEntity<ApiResponse>> deleteUser(@PathVariable String username) {
        return adminUserService.deleteUser(username)
                .then(Mono.fromCallable(() -> {
                    ApiResponse response = new ApiResponse(null, "Usuario eliminado exitosamente", HttpStatus.OK.value());
                    return ResponseEntity.ok().body(response);
                }))
                .onErrorResume(e -> {
                    ErrorApiResponse errorResponse = new ErrorApiResponse(
                            null,
                            "Error al eliminar el usuario",
                            HttpStatus.BAD_REQUEST.value()
                    );
                    return Mono.just(ResponseEntity.status(HttpStatus.BAD_REQUEST).body(errorResponse));
                });
    }

    @PutMapping("/{username}/activate")
    public Mono<ResponseEntity<ApiResponse>> activateUser(@PathVariable String username) {
        return adminUserService.activateUser(username)
                .then(Mono.fromCallable(() -> {
                    ApiResponse response = new ApiResponse(null, "Usuario activado exitosamente", HttpStatus.OK.value());
                    return ResponseEntity.ok().body(response);
                }))
                .onErrorResume(e -> {
                    ErrorApiResponse errorResponse = new ErrorApiResponse(
                            null,
                            "Error al activar el usuario",
                            HttpStatus.BAD_REQUEST.value()
                    );
                    return Mono.just(ResponseEntity.status(HttpStatus.BAD_REQUEST).body(errorResponse));
                });
    }

    @PutMapping("/{username}/deactivate")
    public Mono<ResponseEntity<ApiResponse>> deactivateUser(@PathVariable String username) {
        return adminUserService.deactivateUser(username)
                .then(Mono.fromCallable(() -> {
                    ApiResponse response = new ApiResponse(null, "Usuario desactivado exitosamente", HttpStatus.OK.value());
                    return ResponseEntity.ok().body(response);
                }))
                .onErrorResume(e -> {
                    ErrorApiResponse errorResponse = new ErrorApiResponse(
                            null,
                            "Error al desactivar el usuario",
                            HttpStatus.BAD_REQUEST.value()
                    );
                    return Mono.just(ResponseEntity.status(HttpStatus.BAD_REQUEST).body(errorResponse));
                });
    }
}
{{ end }}
