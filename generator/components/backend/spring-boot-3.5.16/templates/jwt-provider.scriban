{{ if(Name == "security") }}package {{ PACKAGE }}.infrastructure.configuration.authentication.jwt;

import com.epc.common.log.ILogService;
import {{ PACKAGE }}.infrastructure.configuration.DomainLogMessages;
import io.jsonwebtoken.*;
import io.jsonwebtoken.io.Decoders;
import io.jsonwebtoken.security.Keys;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.security.core.userdetails.UserDetails;
import org.springframework.stereotype.Component;

import javax.crypto.SecretKey;
import java.util.Date;

/**
 * Emision y verificacion de JWT.
 *
 * <p>El token y el secreto jamas se registran: la traza lleva usuario y resultado, no el
 * contenido de la cabecera.
 */
@Component
public class JwtProvider {

    private final ILogService log;

    public JwtProvider(ILogService log) {
        this.log = log;
    }

    @Value("${jwt.secret}")
    private String secret;
    @Value("${jwt.expiration}")
    private Integer expiration;

    public String generateToken(UserDetails userDetails) {
        log.info(DomainLogMessages.TOKEN_GENERATING, userDetails.getUsername());
        log.debug(DomainLogMessages.TOKEN_AUTHORITIES, userDetails.getAuthorities());
        String token = Jwts.builder()
                .subject(userDetails.getUsername())
                .claim("roles", userDetails.getAuthorities())
                .issuedAt(new Date())
                .expiration(new Date(new Date().getTime() + expiration))
                .signWith(getKey(secret))
                .compact();
        log.debug(DomainLogMessages.TOKEN_GENERATED, userDetails.getUsername());
        return token;
    }

    public Claims getClaims(String token) {
        log.debug(DomainLogMessages.TOKEN_CLAIMS_EXTRACTING);
        return Jwts.parser()
                .verifyWith(getKey(secret))
                .build()
                .parseSignedClaims(token)
                .getPayload();
    }

    public String getSubject(String token) {
        log.debug(DomainLogMessages.TOKEN_SUBJECT_EXTRACTING);
        return Jwts.parser()
                .verifyWith(getKey(secret))
                .build()
                .parseSignedClaims(token)
                .getPayload()
                .getSubject();
    }

    public boolean validate(String token) {
        log.debug(DomainLogMessages.TOKEN_VALIDATING);
        try {
            Jwts.parser()
                    .verifyWith(getKey(secret))
                    .build()
                    .parseSignedClaims(token)
                    .getPayload()
                    .getSubject();
            log.debug(DomainLogMessages.TOKEN_VALID);
            return true;
        } catch (Exception e) {
            // Motivo de fallo: expiracion, firma invalida o formato. No se propaga porque
            // quien llama solo necesita el booleano; el motivo queda en la traza.
            log.debug(DomainLogMessages.TOKEN_INVALID, e.getMessage());
            return false;
        }
    }

    private SecretKey getKey(String secret) {
        byte[] secretBytes = Decoders.BASE64URL.decode(secret);
        return Keys.hmacShaKeyFor(secretBytes);
    }
}
