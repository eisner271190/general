package {{ PACKAGE }}.infrastructure.controllers;
import com.epc.common.error.ApiResponse;
import com.epc.common.error.CommonException;

import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.http.HttpStatus;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.util.HashMap;
import java.util.Map;

@RestController
@RequestMapping("/{{ Name }}")
public class HolaMundoController {
    @GetMapping("/hello")
    public ResponseEntity<ApiResponse> holaMundo() {
        Map<String, Object> data = new HashMap<>();
        data.put("datos","datos");
        return ResponseEntity.ok(new ApiResponse(data, "Hola Mundo", HttpStatus.OK.value()));
    }

    @GetMapping("/error")
    public ResponseEntity<ApiResponse> holaError() throws CommonException {
        return ResponseEntity.ok(new ApiResponse(getError("Valor del parámetro"), "Hola Mundo", HttpStatus.OK.value()));
    }

    private Map<String, Object> getError(String parameter) throws CommonException {
        String variable = "Valor de la variable";
        CommonException generalException = new CommonException("Se genera excepción con los valores de los parámetros y variables");
        generalException.addData("variable", variable);
        generalException.addData("parameter", parameter);

        throw generalException;
    }
}
