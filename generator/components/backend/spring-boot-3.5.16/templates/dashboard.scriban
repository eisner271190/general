apiVersion: 1
providers:
{{ for m in microservices }}
  - name: '{{ m.Name }}'
    orgId: 1
    folder: '{{ m.Name }}'
    folderUid: ''
    type: file
    disableDeletion: false
    editable: true
    updateIntervalSeconds: 10
    options:
      path: /var/lib/grafana/dashboards/{{ m.Name }}
{{ end }}
