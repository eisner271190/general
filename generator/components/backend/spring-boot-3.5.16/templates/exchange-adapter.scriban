{{ if(Name == "security") }}package {{ PACKAGE }}.security.exchange.infrastructure.adapters;

import {{ PACKAGE }}.security.auth.infrastructure.adapters.CognitoAdapter;
import {{ PACKAGE }}.security.exchange.domain.model.ExchangeRequest;
import {{ PACKAGE }}.security.exchange.domain.model.ExchangeResponse;
import {{ PACKAGE }}.security.exchange.domain.port.ExchangePort;




import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

@Component
public class ExchangeAdapter implements ExchangePort {

    private final CognitoAdapter cognitoClient;

    public ExchangeAdapter(CognitoAdapter cognitoClient) {
        this.cognitoClient = cognitoClient;
    }

    @Override
    public Mono<ExchangeResponse> exchangeCodeForTokens(ExchangeRequest request) {
        return cognitoClient.exchangeCodeForTokens(
                request.getCode(), 
                request.getCodeVerifier(), 
                request.getRedirectUri()
        );
    }
}
{{ end }}
