package {{ PACKAGE }}.subscription.webhook.application;

import {{ PACKAGE }}.subscription.webhook.infrastructure.configuration.WebhookLogMessages;
import {{ PACKAGE }}.subscription.webhook.application.strategies.UnknownEventStrategy;
import {{ PACKAGE }}.subscription.webhook.domain.ProcessWebhookCommand;
import {{ PACKAGE }}.subscription.webhook.domain.model.WebhookEventDto;
import {{ PACKAGE }}.subscription.webhook.domain.port.IWebhookPort;

import com.epc.common.log.ILogService;
import org.springframework.stereotype.Service;
import reactor.core.publisher.Mono;

import java.util.List;
import java.util.Map;
import java.util.function.Function;
import java.util.stream.Collectors;

@Service
public class WebhookHandler implements IWebhookPort {

    private final ILogService log;
    private final Map<String, IWebhookStrategy> strategiesByEventType;
    private final IWebhookStrategy unknownEventStrategy;

    public WebhookHandler(List<IWebhookStrategy> strategies, UnknownEventStrategy unknownEventStrategy, ILogService log) {
        this.log = log;
        this.strategiesByEventType = indexByEventType(strategies);
        this.unknownEventStrategy = unknownEventStrategy;
        log.debug(WebhookLogMessages.WEBHOOK_STRATEGIES_INDEXED, this.strategiesByEventType.keySet());
    }

    @Override
    public Mono<Void> processWebhook(ProcessWebhookCommand command) {
        WebhookEventDto event = command.event();
        IWebhookStrategy strategy = findStrategy(event.getType());
        log.info(WebhookLogMessages.WEBHOOK_RECEIVED,
            event.getType(), event.userId(), strategy.eventType());
        return strategy.handle(event)
            .doOnSuccess(done -> log.debug(WebhookLogMessages.WEBHOOK_PROCESSED, event.getType()));
    }

    private IWebhookStrategy findStrategy(String eventType) {
        return strategiesByEventType.getOrDefault(eventType, unknownEventStrategy);
    }

    /** Spring inyecta el mapa de beans con el nombre de bean como clave; la clave util es el eventType. */
    private static Map<String, IWebhookStrategy> indexByEventType(List<IWebhookStrategy> strategies) {
        return strategies.stream()
            .collect(Collectors.toMap(IWebhookStrategy::eventType, Function.identity()));
    }
}
