{{- if ConsumedEvents.size > 0 }}package {{ PACKAGE }}.infrastructure.configuration.cloud.aws;

import com.epc.common.log.ILogService;
import {{ PACKAGE }}.infrastructure.configuration.DomainLogMessages;
import org.springframework.stereotype.Service;
import org.springframework.beans.factory.annotation.Value;
import software.amazon.awssdk.services.sqs.SqsClient;
import software.amazon.awssdk.services.sqs.model.*;

import java.util.List;

/**
 * Lectura y escritura en la cola SQS.
 *
 * <p>El cuerpo de los mensajes no se registra: puede llevar datos de negocio o personales.
 * La traza anota tamano y cantidad, que es lo que hace falta para diagnosticar.
 */
@Service
public class SqsReceiver {

    private final ILogService log;
    private final SqsClient sqsClient;

    @Value("${aws.sqs.url}")
    private String queueUrl;

    public SqsReceiver(SqsClient sqsClient, ILogService log) {
        this.log = log;
        this.sqsClient = sqsClient;
    }

    public void sendMessage(String messageBody) {
        log.info(DomainLogMessages.SQS_SENDING, messageBody.length());
        log.debug(DomainLogMessages.SQS_QUEUE, queueUrl);
        SendMessageRequest sendRequest = SendMessageRequest.builder()
                .queueUrl(queueUrl)
                .messageBody(messageBody)
                .build();
        sqsClient.sendMessage(sendRequest);
        log.debug(DomainLogMessages.SQS_SENT);
    }

    public List<String> receiveMessages() {
        log.info(DomainLogMessages.SQS_RECEIVING);
        log.debug("Cola: {}", queueUrl);
        ReceiveMessageRequest request = ReceiveMessageRequest.builder()
                .queueUrl(queueUrl)
                .maxNumberOfMessages(10)
                .waitTimeSeconds(10)
                .build();

        List<Message> messages = sqsClient.receiveMessage(request).messages();
        log.debug(DomainLogMessages.SQS_RECEIVED_COUNT, messages.size());

        for (Message message : messages) {
            deleteMessage(message.receiptHandle());
        }

        return messages.stream().map(Message::body).toList();
    }

    private void deleteMessage(String receiptHandle) {
        log.debug(DomainLogMessages.SQS_RECEIPT_ACK, receiptHandle.length());
        DeleteMessageRequest deleteRequest = DeleteMessageRequest.builder()
                .queueUrl(queueUrl)
                .receiptHandle(receiptHandle)
                .build();
        sqsClient.deleteMessage(deleteRequest);
    }
}{{ end }}