package {{ PACKAGE }}.subscription.webhook.application.strategies;

import {{ PACKAGE }}.subscription.webhook.infrastructure.configuration.WebhookLogMessages;
import {{ PACKAGE }}.subscription.subscription.domain.port.ISubscriptionPort;
import {{ PACKAGE }}.subscription.webhook.application.IWebhookStrategy;
import {{ PACKAGE }}.subscription.webhook.domain.model.WebhookEventDto;



import com.epc.common.log.ILogService;
import org.springframework.stereotype.Component;
import reactor.core.publisher.Mono;

@Component
public class CancellationStrategy implements IWebhookStrategy {

    private final ILogService log;
    private final ISubscriptionPort subscriptionPort;

    public CancellationStrategy(ISubscriptionPort subscriptionPort, ILogService log) {
        this.log = log;
        this.subscriptionPort = subscriptionPort;
    }

    @Override
    public String eventType() {
        return "CANCELLATION";
    }

    @Override
    public Mono<Void> handle(WebhookEventDto event) {
        log.info(WebhookLogMessages.WEBHOOK_PROCESSING_EVENT, eventType());
        log.debug(WebhookLogMessages.WEBHOOK_USER_ID, event.userId());
        return subscriptionPort.findSubscriptionByUserId(event.userId())
            .flatMap(subscription -> subscriptionPort.saveSubscription(
                subscription.withStatus("CANCELLED")
            ))
            .then()
            .doOnSuccess(done -> log.debug(WebhookLogMessages.WEBHOOK_EVENT_APPLIED_SHORT, eventType()));
    }
}
