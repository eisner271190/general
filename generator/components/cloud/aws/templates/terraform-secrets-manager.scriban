# -----------------------------------------------------------------------------
# Secrets Manager - Gestión centralizada de secretos
# -----------------------------------------------------------------------------

resource "aws_secretsmanager_secret" "app_secrets" {
  for_each = var.secrets

  name        = "${var.environment}/${var.project_name}/${each.key}"
  description = "Secret for ${var.project_name} - ${each.key}"
  kms_key_id  = var.kms_key_arn

  tags = {
    Environment = var.environment
    Project     = var.project_name
    ManagedBy   = "terraform"
  }
}

resource "aws_secretsmanager_secret_version" "app_secrets" {
  for_each = var.secrets

  secret_id     = aws_secretsmanager_secret.app_secrets[each.key].id
  secret_string = each.value
}
