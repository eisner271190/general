# -----------------------------------------------------------------------------
# Secrets Manager - un secreto por aplicación (contenedor, sin valor)
# -----------------------------------------------------------------------------
# El valor NO se gestiona con Terraform: se siembra con
# `aws secretsmanager put-secret-value` para que quede fuera del
# repositorio y fuera del estado (decisión T04).

resource "aws_secretsmanager_secret" "app_secret" {
  name        = "${var.environment}/${var.project_name}"
  description = "Secrets de la aplicación ${var.project_name}"
  kms_key_id  = var.kms_key_arn

  tags = {
    Environment = var.environment
    Project     = var.project_name
    ManagedBy   = "terraform"
  }
}
