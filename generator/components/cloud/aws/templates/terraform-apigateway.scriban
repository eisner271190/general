resource "aws_apigatewayv2_api" "http_api" {
  name          = "api-gateway"
  protocol_type = "HTTP"
}

resource "aws_apigatewayv2_stage" "api_stage" {
  api_id      = aws_apigatewayv2_api.http_api.id
  name        = "$default"
  auto_deploy = true
}

output "http_api_url" {
  value = "${aws_apigatewayv2_stage.api_stage.invoke_url}"
}