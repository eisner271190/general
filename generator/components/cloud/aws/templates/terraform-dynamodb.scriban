resource "aws_dynamodb_table" "{{ Entity }}" {
  name           = "{{ Entity }}"
  billing_mode   = "PAY_PER_REQUEST"
  hash_key       = "id"
  attribute {
    name = "id"
    type = "N"
  }
}

resource "aws_dynamodb_table" "Subscription" {
  name           = "{{ Name }}Subscription"
  billing_mode   = "PAY_PER_REQUEST"
  hash_key       = "userId"
  attribute {
    name = "userId"
    type = "S"
  }
}

resource "aws_dynamodb_table" "WebhookEvent" {
  name           = "{{ Name }}WebhookEvent"
  billing_mode   = "PAY_PER_REQUEST"
  hash_key       = "eventId"
  attribute {
    name = "eventId"
    type = "S"
  }
  ttl {
    attribute_name = "ttl"
    enabled         = true
  }
}
