resource "aws_dynamodb_table" "Subscription" {
  name         = "{{ MICROSERVICE_NAME }}Subscription"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "userId"
  attribute {
    name = "userId"
    type = "S"
  }
}

resource "aws_dynamodb_table" "WebhookEvent" {
  name         = "{{ MICROSERVICE_NAME }}WebhookEvent"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "eventId"
  attribute {
    name = "eventId"
    type = "S"
  }
  ttl {
    attribute_name = "ttl"
    enabled        = true
  }
}
