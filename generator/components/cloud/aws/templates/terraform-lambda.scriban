resource "aws_iam_role" "{{ MICROSERVICE_NAME }}" {
  name = "{{ MICROSERVICE_NAME }}"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Principal = {
          Service = "lambda.amazonaws.com"
        }
        Action = "sts:AssumeRole"
      }
    ]
  })
}

resource "aws_iam_role_policy" "{{ MICROSERVICE_NAME }}" {
  name = "{{ MICROSERVICE_NAME }}"
  role = aws_iam_role.{{ MICROSERVICE_NAME }}.id

  policy = jsonencode({
    Version = "2012-10-17",
    Statement = [
      {
        Effect   = "Allow",
        Action   = ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
        Resource = "*"
      },
      {
        Effect = "Allow",
        Action = [
          "dynamodb:GetItem",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem",
          "dynamodb:DeleteItem",
          "dynamodb:Scan",
          "dynamodb:Query"
        ],
        Resource = ["*"]
      },
      {
        Effect   = "Allow",
        Action   = ["secretsmanager:GetSecretValue"],
        Resource = ["arn:aws:secretsmanager:*:*:secret:{{ ENVIRONMENT }}/{{ APPLICATION_ID }}-*"]
      },
      {
        Effect   = "Allow",
        Action   = ["ssm:GetParametersByPath"],
        Resource = ["arn:aws:ssm:*:*:parameter/{{ ENVIRONMENT }}/{{ APPLICATION_ID }}/{{ MICROSERVICE_NAME }}/*"]
      }
    ]
  })
}

resource "aws_lambda_function" "{{ MICROSERVICE_NAME }}" {
  function_name = "{{ MICROSERVICE_NAME }}"
  role          = aws_iam_role.{{ MICROSERVICE_NAME }}.arn
  package_type  = "Image"
  memory_size   = 512
  timeout       = 60
  image_uri     = "${aws_ecr_repository.{{ MICROSERVICE_NAME }}.repository_url}:latest"
  environment {
    # Los parametros se leen desde SSM Parameter Store via spring.config.import.
    # Solo se inyecta el perfil "cloud" para activar application-cloud.properties.
    variables = {
      SPRING_PROFILES_ACTIVE = "cloud"
    }
  }
}