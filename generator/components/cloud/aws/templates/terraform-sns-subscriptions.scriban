resource "aws_sns_topic_subscription" "{{ MICROSERVICE_NAME }}" {
  topic_arn = aws_sns_topic.main.arn
  protocol  = "sqs"
  endpoint  = aws_sqs_queue.{{ MICROSERVICE_NAME }}.arn

  # AWS rechaza arrays vacíos en el filter policy: sin eventos consumidos no se filtra.
{{ if ConsumedEvents.size > 0 }}
  filter_policy = jsonencode({
    eventType = [
{{ for event in ConsumedEvents }}
      "{{ event }}"{{ if for.last == false }},{{ end }}
{{ end }}
    ]
  })
{{ end }}
}

resource "aws_sqs_queue_policy" "{{ MICROSERVICE_NAME }}" {
  queue_url = aws_sqs_queue.{{ MICROSERVICE_NAME }}.id
  policy    = data.aws_iam_policy_document.{{ MICROSERVICE_NAME }}.json
}

data "aws_iam_policy_document" "{{ MICROSERVICE_NAME }}" {
  statement {
    actions   = ["sqs:SendMessage"]
    resources = [aws_sqs_queue.{{ MICROSERVICE_NAME }}.arn]

    principals {
      type        = "Service"
      identifiers = ["sns.amazonaws.com"]
    }

    condition {
      test     = "ArnEquals"
      variable = "aws:SourceArn"
      values   = [aws_sns_topic.main.arn]
    }
  }
}
