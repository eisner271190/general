# Un secreto por aplicación: `{{ ENVIRONMENT }}/{{ APPLICATION_ID }}`.
# Cada microservicio lo lee con secretsmanager:GetSecretValue (iam de la Lambda)
# y usa sólo las claves que necesita. El valor se siembra por CLI,
# nunca aquí (aws secretsmanager put-secret-value).
module "secrets" {
  source       = "../modules/secrets-manager"
  environment  = var.environment
  project_name = "{{ APPLICATION_ID }}"
  kms_key_arn  = null
}
