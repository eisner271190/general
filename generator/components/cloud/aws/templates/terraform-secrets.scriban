# -----------------------------------------------------------------------------
# Secreto único de la aplicación (sólo el contenedor).
# El valor lo siembra cloud/up.ps1 fuera de Terraform: nunca entra en el estado.
# -----------------------------------------------------------------------------

module "secrets" {
  source       = "../modules/secrets-manager"
  environment  = var.environment
  project_name = "{{ APPLICATION_ID }}"

  # Clave gestionada aws/secretsmanager (una CMK propia costaría +1 USD/mes).
  kms_key_arn = null
}
