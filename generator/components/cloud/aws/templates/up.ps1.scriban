#Requires -Version 7.0
<#
.SYNOPSIS
    Levanta la infraestructura del componente cloud.
.DESCRIPTION
    Recorre cada directorio microservicio de cloud/terraform y ejecuta
    init -> plan -> apply. El directorio modules/ se excluye porque contiene
    módulos reutilizables y no un estado propio.
    Consola: solo líneas con formato [yyyy-MM-dd HH:mm:ss] [etapa] mensaje
    (etapa 'Cloud Bootstrap' o 'Cloud Apply') y acciones como
    'Crear ECR {ms}' o 'Crear servicios de {ms}: ECR, Lambda, ...'.
    Archivo: logs/yyyy-MM-dd-HH-mm-ss.log con la salida real de terraform.
    Tras el apply se registra la ruta del prefijo de Parameter Store del
    microservicio (output environment_parameter_path) con sus parámetros y se
    sobrescriben los parámetros cuyo valor sale de la infraestructura
    (ARN de SNS, URL de SQS, URL de API, dominio y client id de Cognito).
.PARAMETER Environment
    Entorno a desplegar. Por defecto el entorno con el que se generó el proyecto.
.PARAMETER AutoApprove
    Omite la confirmación previa al apply. Activado por defecto;
    usar -AutoApprove:$false para pedir confirmación.
.PARAMETER PlanOnly
    Se detiene tras el plan, sin aplicar.
.PARAMETER Phase
    Bootstrap crea solo el repositorio ECR (antes de subir imágenes).
    Apply ejecuta init -> plan -> apply completo. Por defecto Apply.
.EXAMPLE
    ./up.ps1 -PlanOnly
.EXAMPLE
    ./up.ps1 -AutoApprove:$false
#>
[CmdletBinding()]
param(
    [string]$Environment = '{{ ENVIRONMENT }}',
    [switch]$AutoApprove = $true,
    [switch]$PlanOnly,
    [ValidateSet('Bootstrap', 'Apply')]
    [string]$Phase = 'Apply'
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$script:TerraformRoot = Join-Path $PSScriptRoot 'terraform'
$script:TerraformFile = "terraform.$Environment.tfvars"
$script:LogDirectory = Join-Path -Path $PSScriptRoot -ChildPath 'logs'
$script:LogFile = Join-Path -Path $script:LogDirectory -ChildPath ("{0}.log" -f (Get-Date -Format 'yyyy-MM-dd-HH-mm-ss'))
$script:Stage = ''

# Descripción humana de cada archivo .tf para los mensajes de consola.
$script:ResourceLabels = @{
    'ecr.tf'                   = 'ECR'
    'apigateway.tf'            = 'API Gateway'
    'apigateway_lambda.tf'     = 'API Gateway -> Lambda'
    'lambda.tf'                = 'Lambda + IAM'
    'sqs.tf'                   = 'SQS'
    'sns.tf'                   = 'SNS'
    'sns_subscription.tf'      = 'SNS -> SQS'
    'cognito.tf'               = 'Cognito'
    'cognito_iam.tf'           = 'Cognito IAM'
    'cognito_client.tf'        = 'Cognito clientes'
    'cognito_google_provider.tf' = 'Cognito Google'
}

# Parámetros de Parameter Store cuyo valor sólo existe después del apply.
# Key: nombre del parámetro; Output: output de Terraform que lo produce.
$script:PostApplyParameters = @(
    @{ Key = 'AWS_SNS_TOPIC_ARN'; Output = 'sns_topic_arn' }
    @{ Key = 'AWS_SQS_URL_{{ MICROSERVICE_NAME }}'; Output = 'sqs_queue_url_{{ MICROSERVICE_NAME }}' }
    @{ Key = 'API_BASE_URL'; Output = 'http_api_url' }
    @{ Key = 'AUTH_BACKEND_HOST'; Output = 'http_api_url' }
    @{ Key = 'AUTH_COGNITO_DOMAIN'; Output = 'user_pool_domain_url' }
    @{ Key = 'AUTH_CLIENT_ID'; Output = 'user_pool_client_id' }
)

function Format-LogLine {
    param([Parameter(Mandatory)][string]$Message)

    $stamp = '[' + (Get-Date -Format 'yyyy-MM-dd HH:mm:ss') + ']'
    if ($script:Stage -eq '') {
        return "$stamp $Message"
    }

    return "$stamp [$script:Stage] $Message"
}

function Write-Log {
    param([Parameter(Mandatory)][string]$Message)

    $line = Format-LogLine -Message $Message
    Write-Host $line
    Add-Content -Path $script:LogFile -Value $line
}

function Write-LogDetail {
    param([Parameter(Mandatory)][string]$Message)

    Add-Content -Path $script:LogFile -Value (Format-LogLine -Message $Message)
}

function Initialize-Log {
    New-Item -ItemType Directory -Path $script:LogDirectory -Force | Out-Null
}

function Stop-WithError {
    param([Parameter(Mandatory)][string]$Reason)

    Write-Log -Message "ERROR: $Reason"
    Write-Log -Message "Log: $script:LogFile"
    exit 1
}

function Invoke-Terraform {
    param(
        [Parameter(Mandatory)][string]$WorkingDirectory,
        [Parameter(Mandatory)][string[]]$Arguments
    )

    $command = "terraform $($Arguments -join ' ')"
    Write-LogDetail -Message "terraform cwd=$WorkingDirectory cmd=$command"

    Push-Location $WorkingDirectory
    try {
        # La salida real de terraform va solo al archivo de log.
        & terraform @Arguments 2>&1 | Out-File -FilePath $script:LogFile -Append
        $code = $LASTEXITCODE
        Write-LogDetail -Message "terraform exit=$code"
        if ($code -ne 0) {
            throw "$command falló con código $code en $WorkingDirectory"
        }
    }
    finally {
        Pop-Location
    }
}

# Captura stdout de `terraform output` ( Invoke-Terraform manda todo al log ).
function Get-TerraformOutput {
    param(
        [Parameter(Mandatory)][string]$WorkingDirectory,
        [Parameter(Mandatory)][string]$OutputName
    )

    $command = "terraform output -raw $OutputName"
    Write-LogDetail -Message "terraform cwd=$WorkingDirectory cmd=$command"

    Push-Location $WorkingDirectory
    try {
        $value = & terraform output -raw $OutputName 2>> $script:LogFile
        $code = $LASTEXITCODE
        Write-LogDetail -Message "terraform output exit=$code"

        if ($code -ne 0) {
            return $null
        }

        return ((@($value) -join '').Trim())
    }
    finally {
        Pop-Location
    }
}

# Escribe un parámetro en Parameter Store (lo crea o lo sobrescribe).
function Set-ParameterStoreValue {
    param(
        [Parameter(Mandatory)][string]$ParameterName,
        [Parameter(Mandatory)][string]$Value
    )

    $arguments = @('ssm', 'put-parameter', '--name', $ParameterName, '--value', $Value, '--type', 'String', '--overwrite')
    Write-LogDetail -Message "aws $($arguments -join ' ')"

    & aws @arguments 2>&1 | Out-File -FilePath $script:LogFile -Append
    $code = $LASTEXITCODE
    Write-LogDetail -Message "aws ssm put-parameter exit=$code name=$ParameterName"
    if ($code -ne 0) {
        throw "aws ssm put-parameter falló con código $code name=$ParameterName"
    }
}

# Sobrescribe en Parameter Store los parámetros que dependen de la infraestructura.
function Update-PostApplyParameters {
    param(
        [Parameter(Mandatory)][string]$WorkingDirectory,
        [Parameter(Mandatory)][string]$ParameterPath
    )

    if ($null -eq (Get-Command -Name aws -ErrorAction SilentlyContinue)) {
        Write-LogDetail -Message 'aws CLI no disponible (se omiten parámetros post-apply)'
        return 0
    }

    $updated = 0
    foreach ($parameter in $script:PostApplyParameters) {
        $value = Get-TerraformOutput -WorkingDirectory $WorkingDirectory -OutputName $parameter.Output
        if ([string]::IsNullOrWhiteSpace($value)) {
            Write-LogDetail -Message "output vacío name=$($parameter.Output) (se omite $($parameter.Key))"
            continue
        }

        Set-ParameterStoreValue -ParameterName ($ParameterPath + $parameter.Key) -Value $value
        $updated++
    }

    return $updated
}

function Update-PostmanBaseUrl {
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][string]$BaseUrl
    )

    # cloud/ -> raíz -> backend/<ms>/postman/<ms>.postman_collection.json
    $root = Split-Path -Path $PSScriptRoot -Parent
    $collection = Join-Path -Path $root -ChildPath ("backend/{0}/postman/{0}.postman_collection.json" -f $Name)

    if (-not (Test-Path -Path $collection)) {
        Write-LogDetail -Message "postman collection no encontrada path=$collection (se omite baseUrl)"
        return
    }

    $document = Get-Content -Path $collection -Raw | ConvertFrom-Json
    $variables = $document.PSObject.Properties['variable']
    if ($null -eq $variables) {
        Write-LogDetail -Message "postman collection sin variables path=$collection (se omite baseUrl)"
        return
    }

    $variable = @($variables.Value) | Where-Object -FilterScript { $_.key -eq 'baseUrl' } | Select-Object -First 1
    if ($null -eq $variable) {
        Write-LogDetail -Message "postman collection sin variable baseUrl path=$collection (se omite)"
        return
    }

    $variable.value = $BaseUrl
    # UTF-8 sin BOM: Postman espera JSON sin BOM.
    $json = $document | ConvertTo-Json -Depth 100
    [System.IO.File]::WriteAllText($collection, "$json`n", [System.Text.UTF8Encoding]::new($false))
    Write-Log -Message "baseUrl actualizado en Postman de ${Name}: $BaseUrl"
}

function Get-ResourceLabel {
    param([Parameter(Mandatory)][string]$FileName)

    if ($script:ResourceLabels.ContainsKey($FileName)) {
        return $script:ResourceLabels[$FileName]
    }

    return $null
}

# Encapsula la consulta de archivos .tf del directorio (R5).
function Get-ServiceLabels {
    param([Parameter(Mandatory)][string]$WorkingDirectory)

    return @(Get-ChildItem -Path $WorkingDirectory -Filter '*.tf' -File |
        ForEach-Object -Process { Get-ResourceLabel -FileName $_.Name } |
        Where-Object -FilterScript { $_ } |
        Sort-Object -Unique)
}

function Get-MicroserviceDirectory {
    Write-LogDetail -Message "descubrimiento root=$script:TerraformRoot"

    $directories = @(Get-ChildItem -Path $script:TerraformRoot -Directory |
        Where-Object { $_.Name -ne 'modules' } |
        Sort-Object -Property Name |
        ForEach-Object -Process { $_.FullName })

    Write-LogDetail -Message "descubrimiento total=$($directories.Count) excluido=modules"
    return $directories
}

function Invoke-TerraformInit {
    param([Parameter(Mandatory)][string]$WorkingDirectory)

    Invoke-Terraform -WorkingDirectory $WorkingDirectory -Arguments @('init', '-input=false')
}

function Invoke-TerraformPlan {
    param([Parameter(Mandatory)][string]$WorkingDirectory)

    Invoke-Terraform -WorkingDirectory $WorkingDirectory -Arguments @(
        'plan', '-input=false', '-var-file', $script:TerraformFile
    )
}

function Invoke-TerraformApply {
    param([Parameter(Mandatory)][string]$WorkingDirectory)

    Invoke-Terraform -WorkingDirectory $WorkingDirectory -Arguments @(
        'apply', '-input=false', '-auto-approve', '-var-file', $script:TerraformFile
    )
}

function Invoke-TerraformBootstrap {
    param([Parameter(Mandatory)][string]$WorkingDirectory)

    # Aísla la creación del repositorio ECR: la imagen debe subirse antes de
    # que la Lambda pueda referenciarla. Rompe el ciclo ECR <-> Lambda sin
    # partir el estado de Terraform.
    $target = '-target=aws_ecr_repository.{{ MICROSERVICE_NAME }}'
    Write-LogDetail -Message "bootstrap target=$target tfvars=$script:TerraformFile"
    Invoke-Terraform -WorkingDirectory $WorkingDirectory -Arguments @(
        'apply', '-input=false', '-auto-approve', '-var-file', $script:TerraformFile, $target
    )
}

function Confirm-Apply {
    param([Parameter(Mandatory)][string]$Name)

    if ($AutoApprove) {
        Write-LogDetail -Message "confirmacion name=$Name respuesta=forzada"
        return $true
    }

    $answer = Read-Host "Aplicar cambios de '$Name'? [s/N]"
    Write-LogDetail -Message "confirmacion name=$Name respuesta=$answer"
    return ($answer -match '^[sS]')
}

function Invoke-MicroserviceBootstrap {
    param([Parameter(Mandatory)][string]$Name, [string]$WorkingDirectory)

    Write-LogDetail -Message "terraform init name=$Name"
    Invoke-TerraformInit -WorkingDirectory $WorkingDirectory

    Write-Log -Message "Creando ECR $Name"
    Invoke-TerraformBootstrap -WorkingDirectory $WorkingDirectory
    Write-Log -Message "Creado ECR $Name"
}

function Invoke-MicroserviceApplyPhases {
    param([Parameter(Mandatory)][string]$Name, [string]$WorkingDirectory)

    $labels = @(Get-ServiceLabels -WorkingDirectory $WorkingDirectory)
    Write-LogDetail -Message "servicios $($labels -join ', ')"

    Write-Log -Message "Generando plan de $Name"
    Invoke-TerraformInit -WorkingDirectory $WorkingDirectory
    Invoke-TerraformPlan -WorkingDirectory $WorkingDirectory
    Write-Log -Message "Plan generado $Name"
    if ($PlanOnly) {
        Write-Log -Message "Se omite apply de $Name (PlanOnly)"
        return
    }

    if (-not (Confirm-Apply -Name $Name)) {
        Write-Log -Message "Aplicación omitida de $Name (confirmación rechazada)"
        return
    }

    Write-Log -Message "Creando servicios de ${Name}: $($labels -join ', ')"
    Invoke-TerraformApply -WorkingDirectory $WorkingDirectory
    Write-Log -Message "Servicios creados $Name"

    # Los parámetros del microservicio quedan desplegados en Parameter Store.
    $parameterPath = Get-TerraformOutput -WorkingDirectory $WorkingDirectory -OutputName 'environment_parameter_path'
    if ([string]::IsNullOrWhiteSpace($parameterPath)) {
        Write-LogDetail -Message "environment_parameter_path vacío name=$Name (se omite Parameter Store)"
    }
    else {
        Write-Log -Message "Parámetros de $Name en Parameter Store: $parameterPath"

        # Parámetros cuyo valor sale de la infraestructura recién creada.
        $updated = Update-PostApplyParameters -WorkingDirectory $WorkingDirectory -ParameterPath $parameterPath
        if ($updated -gt 0) {
            Write-Log -Message "Parámetros post-apply de ${Name} actualizados: $updated"
        }
        else {
            Write-LogDetail -Message "sin parámetros post-apply name=$Name"
        }
    }

    # El API Gateway ya existe: propaga su URL al collection Postman del microservicio.
    $baseUrl = Get-TerraformOutput -WorkingDirectory $WorkingDirectory -OutputName 'http_api_url'
    if ([string]::IsNullOrWhiteSpace($baseUrl)) {
        Write-LogDetail -Message "http_api_url vacío name=$Name (se omite baseUrl en Postman)"
        return
    }

    Update-PostmanBaseUrl -Name $Name -BaseUrl $baseUrl
}

function Invoke-MicroserviceUp {
    param([Parameter(Mandatory)][string]$WorkingDirectory)

    $name = Split-Path -Path $WorkingDirectory -Leaf
    Write-LogDetail -Message "microservicio name=$name phase=$Phase"

    if ($Phase -eq 'Bootstrap') {
        Invoke-MicroserviceBootstrap -Name $name -WorkingDirectory $WorkingDirectory
    }
    else {
        Invoke-MicroserviceApplyPhases -Name $name -WorkingDirectory $WorkingDirectory
    }
}

# Facade: una sola entrada para el componente cloud.
function Invoke-CloudUp {
    $script:Stage = if ($Phase -eq 'Bootstrap') { 'Cloud Bootstrap' } else { 'Cloud Apply' }

    Write-Log -Message 'Iniciando despliegue de infraestructura'
    Write-LogDetail -Message "log=$script:LogFile"
    Write-LogDetail -Message "environment=$Environment phase=$Phase autoApprove=$AutoApprove planOnly=$PlanOnly tfvars=$script:TerraformFile"

    $directories = @(Get-MicroserviceDirectory)
    foreach ($directory in $directories) {
        Invoke-MicroserviceUp -WorkingDirectory $directory
    }

    Write-Log -Message 'Despliegue finalizado'
}

Initialize-Log
try {
    Invoke-CloudUp
    exit 0
}
catch {
    Stop-WithError -Reason $_.Exception.Message
}
