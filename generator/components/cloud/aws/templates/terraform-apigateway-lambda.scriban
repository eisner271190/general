resource "aws_lambda_permission" "{{ MICROSERVICE_NAME }}" {
  statement_id  = "AllowExecutionFromAPIGateway"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.{{ MICROSERVICE_NAME }}.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "${aws_apigatewayv2_api.http_api.execution_arn}/*/*"
}
resource "aws_apigatewayv2_integration" "{{ MICROSERVICE_NAME }}" {
  api_id                    = aws_apigatewayv2_api.http_api.id
  integration_type          = "AWS_PROXY"
  integration_uri           = aws_lambda_function.{{ MICROSERVICE_NAME }}.invoke_arn
  integration_method        = "POST"
  payload_format_version    = "2.0"
}
resource "aws_apigatewayv2_route" "{{ MICROSERVICE_NAME }}" {
  api_id    = aws_apigatewayv2_api.http_api.id
  route_key = "ANY /{{ MICROSERVICE_NAME }}/{proxy+}"
  target    = "integrations/${aws_apigatewayv2_integration.{{ MICROSERVICE_NAME }}.id}"
}