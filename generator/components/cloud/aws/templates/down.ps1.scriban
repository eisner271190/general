#Requires -Version 7.0
<#
.SYNOPSIS
    Retira la infraestructura del componente cloud.
.DESCRIPTION
    Ejecuta terraform destroy en cada directorio microservicio, en orden
    inverso al de up.ps1. El directorio modules/ se excluye.
    Antes del destroy borra el SecureString de la aplicación con
    delete-parameter (sin ventana de recuperación) y purga por CLI el bucket
    del keystore (objetos y versiones), porque AWS no destruye un bucket con
    contenido. Después del destroy elimina de Parameter Store los parámetros
    del microservicio y, por CLI, cualquier resto del bucket del keystore.
    Consola: solo líneas con formato [yyyy-MM-dd HH:mm:ss] [etapa] mensaje
    (etapa 'Cloud Destroy').
    Archivo: logs/yyyy-MM-dd-HH-mm-ss.log con la salida real de terraform.
.PARAMETER Environment
    Entorno a retirar. Por defecto el entorno con el que se generó el proyecto.
.PARAMETER AutoApprove
    Omite la confirmación previa al destroy. Activado por defecto;
    usar -AutoApprove:$false para pedir confirmación.
.EXAMPLE
    ./down.ps1
.EXAMPLE
    ./down.ps1 -AutoApprove:$false
#>
[CmdletBinding()]
param(
    [string]$Environment = '{{ ENVIRONMENT }}',
    [switch]$AutoApprove = $true
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$script:TerraformRoot = Join-Path $PSScriptRoot 'terraform'
$script:TerraformFile = "terraform.$Environment.tfvars"
$script:LogDirectory = Join-Path -Path $PSScriptRoot -ChildPath 'logs'
$script:LogFile = Join-Path -Path $script:LogDirectory -ChildPath ("{0}.log" -f (Get-Date -Format 'yyyy-MM-dd-HH-mm-ss'))
$script:Stage = ''

function Format-LogLine {
    param([Parameter(Mandatory)][string]$Message)

    $stamp = '[' + (Get-Date -Format 'yyyy-MM-dd HH:mm:ss') + ']'
    if ($script:Stage -eq '') {
        return "$stamp $Message"
    }

    return "$stamp [$script:Stage] $Message"
}

function Write-Log {
    param([Parameter(Mandatory)][string]$Message)

    $line = Format-LogLine -Message $Message
    Write-Host $line
    Add-Content -Path $script:LogFile -Value $line
}

function Write-LogDetail {
    param([Parameter(Mandatory)][string]$Message)

    Add-Content -Path $script:LogFile -Value (Format-LogLine -Message $Message)
}

function Initialize-Log {
    New-Item -ItemType Directory -Path $script:LogDirectory -Force | Out-Null
}

function Stop-WithError {
    param([Parameter(Mandatory)][string]$Reason)

    Write-Log -Message "ERROR: $Reason"
    Write-Log -Message "Log: $script:LogFile"
    exit 1
}

function Invoke-Terraform {
    param(
        [Parameter(Mandatory)][string]$WorkingDirectory,
        [Parameter(Mandatory)][string[]]$Arguments
    )

    $command = "terraform $($Arguments -join ' ')"
    Write-LogDetail -Message "terraform cwd=$WorkingDirectory cmd=$command"

    Push-Location $WorkingDirectory
    try {
        # La salida real de terraform va solo al archivo de log.
        & terraform @Arguments 2>&1 | Out-File -FilePath $script:LogFile -Append
        $code = $LASTEXITCODE
        Write-LogDetail -Message "terraform exit=$code"
        if ($code -ne 0) {
            throw "$command falló con código $code en $WorkingDirectory"
        }
    }
    finally {
        Pop-Location
    }
}

# Captura stdout de `terraform output` ( Invoke-Terraform manda todo al log ).
function Get-TerraformOutput {
    param(
        [Parameter(Mandatory)][string]$WorkingDirectory,
        [Parameter(Mandatory)][string]$OutputName
    )

    Write-LogDetail -Message "terraform cwd=$WorkingDirectory cmd=terraform output -raw $OutputName"

    Push-Location $WorkingDirectory
    try {
        $value = & terraform output -raw $OutputName 2>> $script:LogFile
        $code = $LASTEXITCODE
        Write-LogDetail -Message "terraform output exit=$code"
        if ($code -ne 0) {
            return ''
        }

        return ((@($value) -join '').Trim())
    }
    finally {
        Pop-Location
    }
}

function Get-MicroserviceDirectory {
    Write-LogDetail -Message "descubrimiento root=$script:TerraformRoot"

    $directories = @(Get-ChildItem -Path $script:TerraformRoot -Directory |
        Where-Object { $_.Name -ne 'modules' } |
        Sort-Object -Property Name |
        ForEach-Object -Process { $_.FullName })

    Write-LogDetail -Message "descubrimiento total=$($directories.Count) excluido=modules"
    return $directories
}

function Invoke-TerraformDestroy {
    param([Parameter(Mandatory)][string]$WorkingDirectory)

    Invoke-Terraform -WorkingDirectory $WorkingDirectory -Arguments @(
        'destroy', '-input=false', '-auto-approve', '-var-file', $script:TerraformFile
    )
}

# AWS CLI: devuelve el código de salida junto al texto (salida y error) sin
# abortar el flujo, para que el llamado decida qué hacer con el fallo.
function Invoke-AwsCli {
    param(
        [Parameter(Mandatory)][string]$Operation,
        [Parameter(Mandatory)][string[]]$Arguments
    )

    Write-LogDetail -Message "aws $Operation"
    $output = (& aws @Arguments 2>&1 | Out-String)
    $code = $LASTEXITCODE
    Write-LogDetail -Message "aws $Operation exit=$code"

    return [pscustomobject]@{
        ExitCode = $code
        Output   = $output
    }
}

# SecureString único de la aplicación: /<environment>/<applicationId>/secrets.
function Get-ApplicationSecretName {
    return "/$Environment/{{ APPLICATION_ID }}/secrets"
}

# Bucket del keystore por entorno; mismo nombre que genera Terraform.
function Get-KeystoreBucketName {
    return "{{ APPLICATION_ID }}-keystore-$Environment"
}

# Borra el parámetro, que no tiene ventana de recuperación (Q31). Idempotente:
# si ya no existe solo se anota en el log.
function Remove-ApplicationSecret {
    param([Parameter(Mandatory)][string]$SecretName)

    $result = Invoke-AwsCli -Operation 'delete-parameter' -Arguments @(
        'ssm', 'delete-parameter', '--name', $SecretName
    )
    if ($result.ExitCode -ne 0) {
        if ($result.Output -match 'ParameterNotFound') {
            Write-LogDetail -Message "parámetro ya eliminado name=$SecretName"
            return
        }

        throw "aws ssm delete-parameter falló con código $($result.ExitCode) name=$SecretName"
    }

    Write-Log -Message "Parámetro eliminado: $SecretName"
}

# El parámetro de la aplicación vive en el microservicio con secrets.tf (igual
# que el repositorio ECR vive en el que tiene ecr.tf).
function Test-SecretDirectory {
    param([Parameter(Mandatory)][string]$WorkingDirectory)

    return (Test-Path -Path (Join-Path -Path $WorkingDirectory -ChildPath 'secrets.tf'))
}

# El bucket del keystore está versionado: `delete-bucket` y `terraform destroy`
# lo rechazan con objetos o versiones. Se purgan todas (con sus marcadores de
# borrado) en lotes de 1000 (D42). No falla si el bucket ya no existe.
function Remove-KeystoreBucketContent {
    param([Parameter(Mandatory)][string]$BucketName)

    $versions = Invoke-AwsCli -Operation 'list-object-versions' -Arguments @(
        's3api', 'list-object-versions', '--bucket', $BucketName, '--output', 'json'
    )
    if ($versions.ExitCode -ne 0) {
        Write-LogDetail -Message "list-object-versions sin efecto bucket=$BucketName (ya no existe)"
        return
    }

    $keys = [System.Collections.Generic.List[object]]::new()
    foreach ($entry in @($versions.Output | ConvertFrom-Json)) {
        foreach ($version in @($entry.Versions, $entry.DeleteMarkers)) {
            if ($null -eq $version) {
                continue
            }

            $keys.Add([pscustomobject]@{ Key = $version.Key; VersionId = $version.VersionId }) | Out-Null
        }
    }

    Write-LogDetail -Message "keystore objetos+versiones bucket=$BucketName total=$($keys.Count)"
    for ($offset = 0; $offset -lt $keys.Count; $offset += 1000) {
        $batch = @($keys[$offset..([Math]::Min($offset + 999, $keys.Count - 1))])
        $payload = @{ Objects = @($batch) } | ConvertTo-Json -Depth 4 -Compress
        $result = Invoke-AwsCli -Operation 'delete-objects' -Arguments @(
            's3api', 'delete-objects', '--bucket', $BucketName, '--delete', $payload
        )
        if ($result.ExitCode -ne 0) {
            throw "aws s3api delete-objects falló con código $($result.ExitCode) bucket=$BucketName"
        }
    }
}

# Restos tras el destroy (D41): si el bucket sigue existiendo y ya está vacío,
# se borra por CLI. Idempotente: no hace nada si Terraform ya lo eliminó.
function Remove-KeystoreBucketLeftover {
    param([Parameter(Mandatory)][string]$BucketName)

    $result = Invoke-AwsCli -Operation 'delete-bucket' -Arguments @('s3api', 'delete-bucket', '--bucket', $BucketName)
    if ($result.ExitCode -eq 0) {
        Write-Log -Message "Bucket del keystore eliminado: $BucketName"
        return
    }

    if ($result.Output -match 'NoSuchBucket') {
        Write-LogDetail -Message "bucket del keystore ya destruido por Terraform bucket=$BucketName"
        return
    }

    throw "aws s3api delete-bucket falló con código $($result.ExitCode) bucket=$BucketName"
}

# Nombres de los parámetros bajo una ruta (AWS CLI pagina la respuesta solo).
function Get-ParameterNamesByPath {
    param([Parameter(Mandatory)][string]$ParameterPath)

    $result = Invoke-AwsCli -Operation 'get-parameters-by-path' -Arguments @(
        'ssm', 'get-parameters-by-path', '--path', $ParameterPath, '--recursive', '--query', 'Parameters[].Name', '--output', 'text'
    )
    if ($result.ExitCode -ne 0) {
        throw "aws ssm get-parameters-by-path falló con código $($result.ExitCode) path=$ParameterPath"
    }

    $text = ([string]$result.Output).Trim()
    if ($text -eq '' -or $text -eq 'None') {
        return @()
    }

    return @($text -split '\s+' | Where-Object -FilterScript { $_ })
}

# Borra por lotes: delete-parameters admite un máximo de 10 nombres por llamada.
function Remove-Parameters {
    param([Parameter(Mandatory)][string[]]$Names)

    for ($index = 0; $index -lt $Names.Count; $index += 10) {
        $last = [Math]::Min($index + 9, $Names.Count - 1)
        $batch = @($Names[$index..$last])
        $result = Invoke-AwsCli -Operation 'delete-parameters' -Arguments (@('ssm', 'delete-parameters', '--names') + $batch)
        if ($result.ExitCode -ne 0) {
            throw "aws ssm delete-parameters falló con código $($result.ExitCode)"
        }

        Write-LogDetail -Message "aws ssm delete-parameters lote total=$($batch.Count)"
    }
}

# Tras el destroy sólo sobreviven los parámetros que escribió up.ps1 fuera del
# estado de Terraform: se borra todo lo que haya bajo la ruta del microservicio.
function Remove-ParameterStorePath {
    param([Parameter(Mandatory)][string]$ParameterPath)

    $names = @(Get-ParameterNamesByPath -ParameterPath $ParameterPath)
    if ($names.Count -eq 0) {
        Write-LogDetail -Message "sin parámetros path=$ParameterPath"
        return
    }

    Remove-Parameters -Names $names
    Write-Log -Message "Parámetros eliminados de ${ParameterPath}: $($names.Count)"
}

function Confirm-Destroy {
    param([Parameter(Mandatory)][string]$Name)

    if ($AutoApprove) {
        Write-LogDetail -Message "confirmacion name=$Name respuesta=forzada"
        return $true
    }

    $answer = Read-Host "Destruir la infraestructura de '$Name'? [s/N]"
    Write-LogDetail -Message "confirmacion name=$Name respuesta=$answer"
    return ($answer -match '^[sS]')
}

function Invoke-MicroserviceDown {
    param([Parameter(Mandatory)][string]$WorkingDirectory)

    $name = Split-Path -Path $WorkingDirectory -Leaf
    Write-LogDetail -Message "microservicio name=$name action=destroy"

    if (-not (Confirm-Destroy -Name $name)) {
        Write-Log -Message "Destrucción omitida de $name"
        return
    }

    $keystoreBucket = $null
    if (Test-SecretDirectory -WorkingDirectory $WorkingDirectory) {
        Remove-ApplicationSecret -SecretName (Get-ApplicationSecretName)
        $keystoreBucket = Get-KeystoreBucketName

        # Antes del destroy: AWS no destruye un bucket con objetos o versiones (D42).
        Remove-KeystoreBucketContent -BucketName $keystoreBucket
    }

    # La ruta se lee antes del destroy: con el estado vacío el output ya no existe.
    $parameterPath = Get-TerraformOutput -WorkingDirectory $WorkingDirectory -OutputName 'environment_parameter_path'

    Write-Log -Message "Destruyendo infraestructura de $name"
    Invoke-TerraformDestroy -WorkingDirectory $WorkingDirectory
    Write-Log -Message "Infraestructura destruida $name"

    # Después del destroy: restos del bucket del keystore (D41).
    if (-not [string]::IsNullOrWhiteSpace($keystoreBucket)) {
        Remove-KeystoreBucketLeftover -BucketName $keystoreBucket
    }

    if ([string]::IsNullOrWhiteSpace($parameterPath)) {
        Write-LogDetail -Message "environment_parameter_path vacío name=$name (sin parámetros que borrar)"
        return
    }

    Remove-ParameterStorePath -ParameterPath $parameterPath
}

# Facade: una sola entrada para el componente cloud, en orden inverso a up.ps1.
function Invoke-CloudDown {
    $script:Stage = 'Cloud Destroy'

    Write-Log -Message 'Iniciando retiro de infraestructura'
    Write-LogDetail -Message "log=$script:LogFile"
    Write-LogDetail -Message "environment=$Environment autoApprove=$AutoApprove tfvars=$script:TerraformFile"

    if ($null -eq (Get-Command -Name aws -ErrorAction SilentlyContinue)) {
        Stop-WithError -Reason 'aws CLI no disponible: no se puede limpiar el parámetro ni el bucket'
    }

    $directories = @(Get-MicroserviceDirectory)
    [array]::Reverse($directories)
    Write-LogDetail -Message "orden inverso total=$($directories.Count)"

    foreach ($directory in $directories) {
        Invoke-MicroserviceDown -WorkingDirectory $directory
    }

    Write-Log -Message 'Retiro finalizado'
}

Initialize-Log
try {
    Invoke-CloudDown
    exit 0
}
catch {
    Stop-WithError -Reason $_.Exception.Message
}
