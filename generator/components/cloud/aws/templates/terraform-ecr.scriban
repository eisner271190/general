resource "aws_ecr_repository" "{{ MICROSERVICE_NAME }}" {
  name = "{{ MICROSERVICE_NAME }}"
  lifecycle {
    prevent_destroy = false
  }

  force_delete = true
}
output "ecr_{{ MICROSERVICE_NAME }}_url" {
  value = aws_ecr_repository.{{ MICROSERVICE_NAME }}.repository_url
}
output "ecr_{{ MICROSERVICE_NAME }}_arn" {
  value = aws_ecr_repository.{{ MICROSERVICE_NAME }}.arn
}
