variable "region" {
  type        = string
  description = "Región AWS de despliegue. La fuente de verdad es cloud.region en la configuración de la aplicación."
  default     = "{{ CLOUD_REGION }}"
}

variable "environment" {
  type        = string
  description = "Entorno de despliegue. La fuente de verdad es environments[].name en la configuración de la aplicación."
  default     = "{{ ENVIRONMENT }}"

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]*$", var.environment))
    error_message = "El entorno debe ser minúsculas, dígitos y guiones."
  }
}

variable "environment_variables" {
  type        = map(string)
  description = "Variables de entorno inyectadas en la Lambda."
  default     = {}
}

variable "google_client_id" {
  type        = string
  description = "Client ID de Google para el proveedor de Cognito. Sensible: se inyecta con -var o TF_VAR_google_client_id."
  sensitive   = true
  default     = ""
}

variable "google_client_secret" {
  type        = string
  description = "Client secret de Google para el proveedor de Cognito. Sensible: se inyecta con -var o TF_VAR_google_client_secret."
  sensitive   = true
  default     = ""
}
