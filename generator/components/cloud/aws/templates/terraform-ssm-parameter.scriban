# -----------------------------------------------------------------------------
# SSM Parameter Store - Un SecureString por aplicación (contenedor, sin valor)
# El valor se siembra fuera de Terraform (cloud/up.ps1): nunca entra en el estado.
# -----------------------------------------------------------------------------

resource "aws_ssm_parameter" "app_secret" {
  name        = "/${var.environment}/${var.project_name}/secrets"
  type        = "SecureString"
  description = "Secrets of the application ${var.project_name}"
  value       = "placeholder"

  # El valor real lo siembra cloud/up.ps1; Terraform no debe revertirlo.
  lifecycle {
    ignore_changes = [value]
  }

  tags = {
    Environment = var.environment
    Project     = var.project_name
    ManagedBy   = "terraform"
  }
}