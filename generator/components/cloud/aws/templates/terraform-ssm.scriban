# Parameter Store es la fuente de verdad de las variables de ejecución:
# el backend las lee con get-parameters-by-path para arrancar su contenedor.
resource "aws_ssm_parameter" "environment" {
  for_each = var.environment_variables

  name  = "/{{ ENVIRONMENT }}/{{ APPLICATION_ID }}/{{ MICROSERVICE_NAME }}/${each.key}"
  type  = "String"
  value = each.value
}

output "environment_parameter_path" {
  value = "/{{ ENVIRONMENT }}/{{ APPLICATION_ID }}/{{ MICROSERVICE_NAME }}/"
}
