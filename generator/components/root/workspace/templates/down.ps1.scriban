#Requires -Version 7.0
<#
.SYNOPSIS
    Retira la aplicación completa (frontend -> backend -> cloud).
.DESCRIPTION
    Orden inverso a up.ps1: primero la app, luego los contenedores y por
    último la infraestructura de Terraform.
    Consola: solo líneas con formato [yyyy-MM-dd HH:mm:ss] [etapa] mensaje.
    Archivo: logs/yyyy-MM-dd-HH-mm-ss.log con la salida real de cada
    herramienta y el detalle (rutas, argumentos, códigos de salida).
.PARAMETER Environment
    Entorno a retirar. Por defecto el entorno con el que se generó el proyecto.
.PARAMETER AutoApprove
    Omite la confirmación previa al destroy de Terraform.
.PARAMETER SkipFrontend
    Omite la limpieza del frontend.
.EXAMPLE
    ./down.ps1
.EXAMPLE
    ./down.ps1 -AutoApprove
#>
[CmdletBinding()]
param(
    [string]$Environment = '{{ ENVIRONMENT }}',
    [switch]$AutoApprove,
    [switch]$SkipFrontend
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$script:LogDirectory = Join-Path -Path $PSScriptRoot -ChildPath 'logs'
$script:LogFile = Join-Path -Path $script:LogDirectory -ChildPath ("{0}.log" -f (Get-Date -Format 'yyyy-MM-dd-HH-mm-ss'))
$script:Stage = ''

function Format-LogLine {
    param([Parameter(Mandatory)][string]$Message)

    $stamp = '[' + (Get-Date -Format 'yyyy-MM-dd HH:mm:ss') + ']'
    if ($script:Stage -eq '') {
        return "$stamp $Message"
    }

    return "$stamp [$script:Stage] $Message"
}

function Write-Log {
    param([Parameter(Mandatory)][string]$Message)

    $line = Format-LogLine -Message $Message
    Write-Host $line
    Add-Content -Path $script:LogFile -Value $line
}

function Write-LogDetail {
    param([Parameter(Mandatory)][string]$Message)

    Add-Content -Path $script:LogFile -Value (Format-LogLine -Message $Message)
}

function Initialize-Log {
    New-Item -ItemType Directory -Path $script:LogDirectory -Force | Out-Null
}

function Stop-WithError {
    param([Parameter(Mandatory)][string]$Reason)

    Write-Log -Message "ERROR: $Reason"
    Write-Log -Message "Log: $script:LogFile"
    exit 1
}

function Write-Arguments {
    param([Parameter(Mandatory)][hashtable]$Arguments)

    foreach ($key in ($Arguments.Keys | Sort-Object)) {
        Write-LogDetail -Message "argumento $key=$($Arguments[$key])"
    }
}

function Invoke-ComponentScript {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][hashtable]$Arguments
    )

    if (-not (Test-Path -Path $Path)) {
        Stop-WithError -Reason "No se encontró el script de componente: $Path"
    }

    Write-LogDetail -Message "componente path=$Path"
    Write-Arguments -Arguments $Arguments
    # El componente solo emite líneas amigables por consola; van al log raíz tal cual.
    & $Path @Arguments *>&1 | Tee-Object -FilePath $script:LogFile -Append
    $code = $LASTEXITCODE
    Write-LogDetail -Message "componente path=$Path exit=$code"
    if ($code -ne 0) {
        Stop-WithError -Reason "El componente '$Path' terminó con código $code"
    }
}

function Get-ComponentScript {
    param(
        [Parameter(Mandatory)][string]$Component,
        [Parameter(Mandatory)][string]$ScriptName
    )

    $root = Join-Path -Path $PSScriptRoot -ChildPath $Component
    Write-LogDetail -Message "descubrimiento root=$root filter=$ScriptName"

    $scripts = @(Get-ChildItem -Path $root -Filter $ScriptName -Recurse -ErrorAction SilentlyContinue |
        Sort-Object -Property FullName |
        ForEach-Object -Process { $_.FullName })

    foreach ($script in $scripts) {
        Write-LogDetail -Message "script path=$script"
    }
    Write-LogDetail -Message "descubrimiento total=$($scripts.Count)"

    return $scripts
}

function Invoke-ComponentScriptList {
    param([Parameter(Mandatory)][string]$Component)

    Write-LogDetail -Message "paso component=$Component action=down"
    foreach ($path in Get-ComponentScript -Component $Component -ScriptName 'down.ps1') {
        Invoke-ComponentScript -Path $path -Arguments @{}
    }
}

function Invoke-FrontendDown {
    if ($SkipFrontend) {
        Write-LogDetail -Message 'paso 1/3 frontend omitido (skipFrontend)'
        return
    }

    Write-LogDetail -Message 'paso 1/3 frontend'
    Invoke-ComponentScriptList -Component 'frontend'
}

function Invoke-CloudDown {
    $path = Join-Path -Path $PSScriptRoot -ChildPath 'cloud/down.ps1'
    Write-LogDetail -Message "paso 3/3 cloud path=$path"
    Invoke-ComponentScript -Path $path -Arguments @{ Environment = $Environment; AutoApprove = [bool]$AutoApprove }
}

# Facade: una sola entrada para retirar la aplicación completa.
function Invoke-ApplicationDown {
    Write-Log -Message 'Iniciando retiro de la aplicación'
    Write-LogDetail -Message "log=$script:LogFile"
    Write-LogDetail -Message "aplicacion={{ APPLICATION_NAME }} environment=$Environment autoApprove=$AutoApprove skipFrontend=$SkipFrontend"

    Invoke-FrontendDown
    Write-LogDetail -Message 'paso 2/3 backend'
    Invoke-ComponentScriptList -Component 'backend'

    Invoke-CloudDown

    Write-Log -Message 'Retiro finalizado'
}

Initialize-Log
try {
    Invoke-ApplicationDown
    exit 0
}
catch {
    Stop-WithError -Reason $_.Exception.Message
}
