#Requires -Version 7.0
<#
.SYNOPSIS
    Levanta la aplicación completa (cloud -> backend -> frontend).
.DESCRIPTION
    0. platform               : library/platform/scripts/up.ps1. Crea el dominio de CodeArtifact,
                                sin el cual el build del backend no puede resolver `common`. Con
                                -SkipPlatform se omite.
    0b. publish common        : library/platform/scripts/publish-common.ps1. Publica los paquetes
                                Maven de `common`; sin ellos el pom del microservicio no resuelve el
                                common-bom y `docker build` falla.
    0c. publish buildspecs     : library/platform/scripts/publish-buildspecs.ps1. Los buildspecs se
                                referencian por ARN; sin ellos en el bucket el pipeline no arranca.
    1. cloud  -Phase Bootstrap : crea el repositorio ECR.
    2. backend -Phase Build    : build + push de la imagen de cada microservicio.
    3. cloud  -Phase Apply     : plan + apply de toda la infraestructura.
    3b. codecommit             : conecta el remoto de la aplicación y hace push.
    4. backend -Phase Run      : lee Parameter Store y arranca cada contenedor.
    5. frontend                : clean -> pub get -> iconos -> appbundle -> run.
       Con -Fast el frontend se limita a clean + pub get + iconos: sin
       compilar el .aab y sin ejecutar flutter run.
    El orden 2 antes de 3 es imprescindible: la Lambda no puede crearse con
    una imagen que aún no existe.
    Consola: solo líneas con formato [yyyy-MM-dd HH:mm:ss] [etapa] mensaje.
    Archivo: logs/yyyy-MM-dd-HH-mm-ss.log con la salida real de cada
    herramienta y el detalle (rutas, argumentos, códigos de salida).
.PARAMETER Environment
    Entorno a levantar. Por defecto el entorno con el que se generó el proyecto.
.PARAMETER AutoApprove
    Omite la confirmación previa al apply de Terraform. Activado por defecto;
    usar -AutoApprove:$false para pedir confirmación.
.PARAMETER PlanOnly
    Se detiene tras el plan de Terraform.
.PARAMETER SkipFrontend
    Omite el paso de frontend (servidores útiles en CI).
.PARAMETER Fast
    Modo rápido: el frontend se ejecuta con -SkipBuild -SkipRun, así que no se
    compila el .aab ni se lanza flutter run.
.PARAMETER DeviceId
    Dispositivo para `flutter run`. Si se omite, el frontend usa el único
    móvil Android conectado por adb; con cero o varios móviles solo compila
    (flutter run es interactivo y aborta con más de un dispositivo).
.EXAMPLE
    ./up.ps1 -PlanOnly
.EXAMPLE
    ./up.ps1 -Fast
.EXAMPLE
    ./up.ps1 -AutoApprove:$false
.PARAMETER PlatformRoot
    Raiz de la plataforma (el repo `library/platform` del monorepo). Es un paso previo: sin el
    dominio de CodeArtifact el build del backend no puede resolver `common`. Por defecto se
    resuelve como `../../../library/platform`, que es donde vive junto a `projects/`.
.PARAMETER SkipPlatform
    Omite el paso de plataforma. Util cuando la plataforma ya esta desplegada y solo se
    actualiza la aplicacion.
.EXAMPLE
    ./up.ps1 -SkipPlatform
#>
[CmdletBinding()]
param(
    [string]$Environment = '{{ ENVIRONMENT }}',
    [switch]$AutoApprove = $true,
    [switch]$PlanOnly,
    [switch]$SkipFrontend,
    [switch]$Fast,
    [string]$DeviceId = '',
    [string]$PlatformRoot = (Join-Path -Path $PSScriptRoot -ChildPath '../../library/platform'),
    [switch]$SkipPlatform
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$script:LogDirectory = Join-Path -Path $PSScriptRoot -ChildPath 'logs'
$script:LogFile = Join-Path -Path $script:LogDirectory -ChildPath ("{0}.log" -f (Get-Date -Format 'yyyy-MM-dd-HH-mm-ss'))
$script:Stage = ''

function Format-LogLine {
    param([Parameter(Mandatory)][string]$Message)

    $stamp = '[' + (Get-Date -Format 'yyyy-MM-dd HH:mm:ss') + ']'
    if ($script:Stage -eq '') {
        return "$stamp $Message"
    }

    return "$stamp [$script:Stage] $Message"
}

function Write-Log {
    param([Parameter(Mandatory)][string]$Message)

    $line = Format-LogLine -Message $Message
    Write-Host $line
    Add-Content -Path $script:LogFile -Value $line
}

function Write-LogDetail {
    param([Parameter(Mandatory)][string]$Message)

    Add-Content -Path $script:LogFile -Value (Format-LogLine -Message $Message)
}

function Initialize-Log {
    New-Item -ItemType Directory -Path $script:LogDirectory -Force | Out-Null
}

function Stop-WithError {
    param([Parameter(Mandatory)][string]$Reason)

    Write-Log -Message "ERROR: $Reason"
    Write-Log -Message "Log: $script:LogFile"
    exit 1
}

function Write-Arguments {
    param([Parameter(Mandatory)][hashtable]$Arguments)

    foreach ($key in ($Arguments.Keys | Sort-Object)) {
        Write-LogDetail -Message "argumento $key=$($Arguments[$key])"
    }
}

function Invoke-ComponentScript {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][hashtable]$Arguments
    )

    if (-not (Test-Path -Path $Path)) {
        Stop-WithError -Reason "No se encontró el script de componente: $Path"
    }

    Write-LogDetail -Message "componente path=$Path"
    Write-Arguments -Arguments $Arguments
    # El componente solo emite líneas amigables por consola; van al log raíz tal cual.
    & $Path @Arguments *>&1 | Tee-Object -FilePath $script:LogFile -Append
    $code = $LASTEXITCODE
    Write-LogDetail -Message "componente path=$Path exit=$code"
    if ($code -ne 0) {
        Stop-WithError -Reason "El componente '$Path' terminó con código $code"
    }
}

function Get-ComponentScript {
    param(
        [Parameter(Mandatory)][string]$Component,
        [Parameter(Mandatory)][string]$ScriptName
    )

    $root = Join-Path -Path $PSScriptRoot -ChildPath $Component
    Write-LogDetail -Message "descubrimiento root=$root filter=$ScriptName"

    $scripts = @(Get-ChildItem -Path $root -Filter $ScriptName -Recurse -ErrorAction SilentlyContinue |
        Sort-Object -Property FullName |
        ForEach-Object -Process { $_.FullName })

    foreach ($script in $scripts) {
        Write-LogDetail -Message "script path=$script"
    }
    Write-LogDetail -Message "descubrimiento total=$($scripts.Count)"

    return $scripts
}

function Invoke-PlatformStage {
    # El dominio de CodeArtifact lo declara la plataforma, no la aplicacion. Sin el,
    # `aws codeartifact get-repository-endpoint` falla en el paso 2 y no hay build.
    if ($SkipPlatform) {
        Write-LogDetail -Message 'paso 0/5 plataforma omitida (SkipPlatform)'
        return
    }

    $path = Join-Path -Path $PlatformRoot -ChildPath 'scripts/up.ps1'
    if (-not (Test-Path -Path $path)) {
        # No es un error: se puede desplegar solo la aplicacion si la plataforma ya existe en otra
        # parte. Se avisa y se sigue, en vez de abortar por una ruta.
        Write-Log -Message "Plataforma no encontrada en $path; se omite el paso 0 (usa -SkipPlatform para silenciarlo)"
        return
    }

    Write-LogDetail -Message "paso 0/5 plataforma path=$path"
    Invoke-ComponentScript -Path $path -Arguments @{ AutoApprove = [bool]$AutoApprove }

    Invoke-PlatformPublishStage -PlatformRoot $PlatformRoot
}

# Sin los paquetes Maven publicados, el `pom.xml` de cada microservicio no resuelve el import del
# common-bom y `docker build` falla sin versiones en todas las dependencias.
function Invoke-PlatformPublishStage {
    param([Parameter(Mandatory)][string]$PlatformRoot)

    $publish = Join-Path -Path $PlatformRoot -ChildPath 'scripts/publish-common.ps1'
    if (-not (Test-Path -Path $publish)) {
        Write-Log -Message "publish-common.ps1 no encontrado en $publish; se omite (los paquetes ya deben estar en CodeArtifact)"
        return
    }

    Write-LogDetail -Message "paso 0b/5 publica common en CodeArtifact path=$publish"
    Invoke-ComponentScript -Path $publish -Arguments @{}

    Invoke-PlatformBuildspecsStage -PlatformRoot $PlatformRoot
}

# Los buildspecs se referencian por ARN desde el pipeline y los proyectos CodeBuild, asi que sin
# ellos en el bucket el pipeline falla al arrancar. El script es idempotente (compara MD5), asi
# que invocarlo siempre no genera versiones nuevas.
function Invoke-PlatformBuildspecsStage {
    param([Parameter(Mandatory)][string]$PlatformRoot)

    $publish = Join-Path -Path $PlatformRoot -ChildPath 'scripts/publish-buildspecs.ps1'
    if (-not (Test-Path -Path $publish)) {
        Write-Log -Message "publish-buildspecs.ps1 no encontrado en $publish; se omite (los buildspecs deben estar ya en el bucket)"
        return
    }

    Write-LogDetail -Message "paso 0c/5 publica buildspecs en el bucket path=$publish"
    Invoke-ComponentScript -Path $publish -Arguments @{}
}

function Invoke-CloudPhase {
    param(
        [Parameter(Mandatory)][string]$Phase,
        [Parameter(Mandatory)][hashtable]$Arguments
    )

    $path = Join-Path -Path $PSScriptRoot -ChildPath 'cloud/up.ps1'
    Write-LogDetail -Message "paso cloud phase=$Phase path=$path"
    Invoke-ComponentScript -Path $path -Arguments ($Arguments + @{ Phase = $Phase })
}

function Invoke-BackendPhase {
    param([Parameter(Mandatory)][string]$Phase)

    Write-LogDetail -Message "paso backend phase=$Phase"
    foreach ($path in Get-ComponentScript -Component 'backend' -ScriptName 'up.ps1') {
        Invoke-ComponentScript -Path $path -Arguments @{ Phase = $Phase }
    }
}

function Invoke-Frontend {
    foreach ($path in Get-ComponentScript -Component 'frontend' -ScriptName 'up.ps1') {
        $arguments = @{}
        if ($DeviceId -ne '') {
            $arguments['DeviceId'] = $DeviceId
        }
        if ($Fast) {
            $arguments['SkipBuild'] = $true
            $arguments['SkipRun'] = $true
        }
        Invoke-ComponentScript -Path $path -Arguments $arguments
    }
}

function Invoke-CloudApplyStage {
    Write-LogDetail -Message 'paso 3/5 cloud plan + apply'
    $cloudArguments = @{ Environment = $Environment; AutoApprove = [bool]$AutoApprove; PlanOnly = [bool]$PlanOnly }
    Invoke-CloudPhase -Phase 'Apply' -Arguments $cloudArguments
}

# El repositorio de la aplicación lo declara cloud/terraform/app/codecommit.tf (ya aplicado en
# el paso 3). Aquí solo se conecta el remoto y se empuja: es el único sitio del proyecto con
# comandos git, para que no haya pushes sueltos a mano. Sin credenciales sembradas: CodeCommit
# autentica con las del usuario (credential helper local o AWS CLI).
function Invoke-Git {
    param([Parameter(Mandatory)][string[]]$Arguments)

    Write-LogDetail -Message "git $($Arguments -join ' ')"
    & git @Arguments *>&1 | Tee-Object -FilePath $script:LogFile -Append
    $code = $LASTEXITCODE
    Write-LogDetail -Message "git exit=$code"
    return $code
}

function Get-GitOutput {
    param([Parameter(Mandatory)][string[]]$Arguments)

    $value = (& git @Arguments 2>> $script:LogFile | Out-String)
    if ($LASTEXITCODE -ne 0) {
        return ''
    }

    return $value.Trim()
}

function Invoke-RepositorySync {
    Write-LogDetail -Message 'paso 3b/5 codecommit remoto + push'

    $terraformApp = Join-Path -Path $PSScriptRoot -ChildPath 'cloud/terraform/app'
    if (-not (Test-Path -Path $terraformApp)) {
        Write-LogDetail -Message "sin cloud/terraform/app (se omite el remoto)"
        return
    }

    # El Credential Manager de Windows (`credential.helper = manager`, en el config de sistema) se
    # consulta antes que el helper de CodeCommit y abre un dialogo de usuario/contrasena que no
    # existe: el token sale de STS con las credenciales del usuario IAM (ADR-0022). El helper vacio
    # resetea la lista y deja solo el de AWS.
    function Invoke-SeedGit {
        param(
            [Parameter(Mandatory)][string]$Path,
            [Parameter(Mandatory)][string[]]$Arguments
        )

        $env:GIT_TERMINAL_PROMPT = '0'
        & git -C $Path @('-c', 'credential.helper=', '-c', 'credential.helper=!aws codecommit credential-helper $@') @Arguments *>&1 |
            Tee-Object -FilePath $script:LogFile -Append
        if ($LASTEXITCODE -ne 0) {
            throw "git $($Arguments -join ' ') fallo con codigo $LASTEXITCODE en la copia temporal"
        }
    }

    # Las comillas son obligatorias: sin ellas PowerShell no expande la variable y Terraform recibe
    # el string literal "$terraformApp", que no existe como directorio (exit 1).
    $cloneUrl = (& terraform "-chdir=$terraformApp" output -raw codecommit_clone_url 2>> $script:LogFile | Out-String).Trim()
    if ([string]::IsNullOrWhiteSpace($cloneUrl)) {
        # El directorio existe, asi que Terraform ya aplico y el repo deberia estar creado: si el
        # output sale vacio es un fallo real. Avisar y seguir dejaba el repo vacio sin senal.
        throw 'codecommit_clone_url vacio: Terraform no devolvio la URL. Revisa el log del apply de app/.'
    }

    # La app es un subdirectorio del monorepo, no un repo propio: empujar `HEAD` subiria el
    # historial de `general` y el repo de la app no tendria `backend/<ms>/pom.xml` en la raiz.
    # Se siembra desde una copia temporal, igual que hace library/platform/scripts/seed-repos.ps1
    # con `common` y `platform`. El indice del monorepo no se toca.
    $seed = Join-Path -Path ([IO.Path]::GetTempPath()) -ChildPath "app-seed-$(Get-Random)"
    try {
        Write-LogDetail -Message "copiando la app a $seed"
        New-Item -Path $seed -ItemType Directory -Force | Out-Null
        Copy-Item -Path (Join-Path -Path $PSScriptRoot -ChildPath '*') -Destination $seed -Recurse -Force -Exclude 'logs'

        Invoke-SeedGit -Path $seed -Arguments @('init', '-b', 'main')
        Invoke-SeedGit -Path $seed -Arguments @('add', '-A')
        Invoke-SeedGit -Path $seed -Arguments @('commit', '-q', '-m', 'chore: estado inicial de la aplicacion')
        Invoke-SeedGit -Path $seed -Arguments @('remote', 'add', 'origin', $cloneUrl)
        # `--force` a proposito: la copia es una foto del codigo generado, no un historial que
        # haya que conservar. Sin el, un intento anterior deja commits y el push se rechaza.
        Write-LogDetail -Message 'push --force: la copia reemplaza el contenido del repo'
        Invoke-SeedGit -Path $seed -Arguments @('push', '--force', '-u', 'origin', 'main')
    }
    finally {
        if (Test-Path -Path $seed) {
            Remove-Item -Path $seed -Recurse -Force -ErrorAction SilentlyContinue
        }
    }

    Write-Log -Message "Repositorio sincronizado: $cloneUrl (main)"
}

function Invoke-FrontendStage {
    if ($SkipFrontend) {
        Write-LogDetail -Message 'paso 5/5 frontend omitido (skipFrontend)'
        return
    }

    Write-LogDetail -Message 'paso 5/5 frontend'
    Invoke-Frontend
}

# Facade: una sola entrada para levantar la aplicación completa.
function Invoke-ApplicationUp {
    Write-Log -Message 'Iniciando despliegue'
    Write-LogDetail -Message "log=$script:LogFile"
    Write-LogDetail -Message "aplicacion={{ APPLICATION_NAME }} environment=$Environment autoApprove=$AutoApprove planOnly=$PlanOnly skipFrontend=$SkipFrontend fast=$Fast deviceId=$DeviceId platformRoot=$PlatformRoot skipPlatform=$SkipPlatform"

    Invoke-PlatformStage

    Write-LogDetail -Message 'paso 1/5 cloud bootstrap (crea ECR)'
    Invoke-CloudPhase -Phase 'Bootstrap' -Arguments @{ Environment = $Environment; AutoApprove = $true }

    Write-LogDetail -Message 'paso 2/5 backend build (docker build + push)'
    Invoke-BackendPhase -Phase 'Build'

    Invoke-CloudApplyStage
    if ($PlanOnly) {
        Write-Log -Message 'Despliegue finalizado (PlanOnly: sin apply)'
        return
    }

    Invoke-RepositorySync

    Write-LogDetail -Message 'paso 4/5 backend run (Parameter Store + docker run)'
    Invoke-BackendPhase -Phase 'Run'
    Invoke-FrontendStage

    Write-Log -Message 'Despliegue finalizado'
}

Initialize-Log
try {
    Invoke-ApplicationUp
    exit 0
}
catch {
    Stop-WithError -Reason $_.Exception.Message
}
