#Requires -Version 7.0
<#
.SYNOPSIS
    Levanta la aplicación completa (cloud -> backend -> frontend).
.DESCRIPTION
    1. cloud  -Phase Bootstrap : crea el repositorio ECR.
    2. backend -Phase Build    : build + push de la imagen de cada microservicio.
    3. cloud  -Phase Apply     : plan + apply de toda la infraestructura.
    4. backend -Phase Run      : lee Parameter Store y arranca cada contenedor.
    5. frontend                : clean -> pub get -> iconos -> appbundle -> run.
    El orden 2 antes de 3 es imprescindible: la Lambda no puede crearse con
    una imagen que aún no existe.
    Consola: solo líneas con formato [yyyy-MM-dd HH:mm:ss] [etapa] mensaje.
    Archivo: logs/yyyy-MM-dd-HH-mm-ss.log con la salida real de cada
    herramienta y el detalle (rutas, argumentos, códigos de salida).
.PARAMETER Environment
    Entorno a levantar. Por defecto el entorno con el que se generó el proyecto.
.PARAMETER AutoApprove
    Omite la confirmación previa al apply de Terraform.
.PARAMETER PlanOnly
    Se detiene tras el plan de Terraform.
.PARAMETER SkipFrontend
    Omite el paso de frontend (servidores útiles en CI).
.PARAMETER DeviceId
    Dispositivo para `flutter run`. Si se omite, el frontend solo compila
    (flutter run es interactivo y aborta con más de un dispositivo).
.EXAMPLE
    ./up.ps1 -PlanOnly
.EXAMPLE
    ./up.ps1 -AutoApprove
#>
[CmdletBinding()]
param(
    [string]$Environment = '{{ ENVIRONMENT }}',
    [switch]$AutoApprove,
    [switch]$PlanOnly,
    [switch]$SkipFrontend,
    [string]$DeviceId = ''
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$script:LogDirectory = Join-Path -Path $PSScriptRoot -ChildPath 'logs'
$script:LogFile = Join-Path -Path $script:LogDirectory -ChildPath ("{0}.log" -f (Get-Date -Format 'yyyy-MM-dd-HH-mm-ss'))
$script:Stage = ''

function Format-LogLine {
    param([Parameter(Mandatory)][string]$Message)

    $stamp = '[' + (Get-Date -Format 'yyyy-MM-dd HH:mm:ss') + ']'
    if ($script:Stage -eq '') {
        return "$stamp $Message"
    }

    return "$stamp [$script:Stage] $Message"
}

function Write-Log {
    param([Parameter(Mandatory)][string]$Message)

    $line = Format-LogLine -Message $Message
    Write-Host $line
    Add-Content -Path $script:LogFile -Value $line
}

function Write-LogDetail {
    param([Parameter(Mandatory)][string]$Message)

    Add-Content -Path $script:LogFile -Value (Format-LogLine -Message $Message)
}

function Initialize-Log {
    New-Item -ItemType Directory -Path $script:LogDirectory -Force | Out-Null
}

function Stop-WithError {
    param([Parameter(Mandatory)][string]$Reason)

    Write-Log -Message "ERROR: $Reason"
    Write-Log -Message "Log: $script:LogFile"
    exit 1
}

function Write-Arguments {
    param([Parameter(Mandatory)][hashtable]$Arguments)

    foreach ($key in ($Arguments.Keys | Sort-Object)) {
        Write-LogDetail -Message "argumento $key=$($Arguments[$key])"
    }
}

function Invoke-ComponentScript {
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][hashtable]$Arguments
    )

    if (-not (Test-Path -Path $Path)) {
        Stop-WithError -Reason "No se encontró el script de componente: $Path"
    }

    Write-LogDetail -Message "componente path=$Path"
    Write-Arguments -Arguments $Arguments
    # El componente solo emite líneas amigables por consola; van al log raíz tal cual.
    & $Path @Arguments *>&1 | Tee-Object -FilePath $script:LogFile -Append
    $code = $LASTEXITCODE
    Write-LogDetail -Message "componente path=$Path exit=$code"
    if ($code -ne 0) {
        Stop-WithError -Reason "El componente '$Path' terminó con código $code"
    }
}

function Get-ComponentScript {
    param(
        [Parameter(Mandatory)][string]$Component,
        [Parameter(Mandatory)][string]$ScriptName
    )

    $root = Join-Path -Path $PSScriptRoot -ChildPath $Component
    Write-LogDetail -Message "descubrimiento root=$root filter=$ScriptName"

    $scripts = @(Get-ChildItem -Path $root -Filter $ScriptName -Recurse -ErrorAction SilentlyContinue |
        Sort-Object -Property FullName |
        ForEach-Object -Process { $_.FullName })

    foreach ($script in $scripts) {
        Write-LogDetail -Message "script path=$script"
    }
    Write-LogDetail -Message "descubrimiento total=$($scripts.Count)"

    return $scripts
}

function Invoke-CloudPhase {
    param(
        [Parameter(Mandatory)][string]$Phase,
        [Parameter(Mandatory)][hashtable]$Arguments
    )

    $path = Join-Path -Path $PSScriptRoot -ChildPath 'cloud/up.ps1'
    Write-LogDetail -Message "paso cloud phase=$Phase path=$path"
    Invoke-ComponentScript -Path $path -Arguments ($Arguments + @{ Phase = $Phase })
}

function Invoke-BackendPhase {
    param([Parameter(Mandatory)][string]$Phase)

    Write-LogDetail -Message "paso backend phase=$Phase"
    foreach ($path in Get-ComponentScript -Component 'backend' -ScriptName 'up.ps1') {
        Invoke-ComponentScript -Path $path -Arguments @{ Phase = $Phase }
    }
}

function Invoke-Frontend {
    foreach ($path in Get-ComponentScript -Component 'frontend' -ScriptName 'up.ps1') {
        $arguments = @{}
        if ($DeviceId -ne '') {
            $arguments['DeviceId'] = $DeviceId
        }
        Invoke-ComponentScript -Path $path -Arguments $arguments
    }
}

function Invoke-CloudApplyStage {
    Write-LogDetail -Message 'paso 3/5 cloud plan + apply'
    $cloudArguments = @{ Environment = $Environment; AutoApprove = [bool]$AutoApprove; PlanOnly = [bool]$PlanOnly }
    Invoke-CloudPhase -Phase 'Apply' -Arguments $cloudArguments
}

function Invoke-FrontendStage {
    if ($SkipFrontend) {
        Write-LogDetail -Message 'paso 5/5 frontend omitido (skipFrontend)'
        return
    }

    Write-LogDetail -Message 'paso 5/5 frontend'
    Invoke-Frontend
}

# Facade: una sola entrada para levantar la aplicación completa.
function Invoke-ApplicationUp {
    Write-Log -Message 'Iniciando despliegue'
    Write-LogDetail -Message "log=$script:LogFile"
    Write-LogDetail -Message "aplicacion={{ APPLICATION_NAME }} environment=$Environment autoApprove=$AutoApprove planOnly=$PlanOnly skipFrontend=$SkipFrontend deviceId=$DeviceId"

    Write-LogDetail -Message 'paso 1/5 cloud bootstrap (crea ECR)'
    Invoke-CloudPhase -Phase 'Bootstrap' -Arguments @{ Environment = $Environment; AutoApprove = $true }

    Write-LogDetail -Message 'paso 2/5 backend build (docker build + push)'
    Invoke-BackendPhase -Phase 'Build'

    Invoke-CloudApplyStage
    if ($PlanOnly) {
        Write-Log -Message 'Despliegue finalizado (PlanOnly: sin apply)'
        return
    }

    Write-LogDetail -Message 'paso 4/5 backend run (Parameter Store + docker run)'
    Invoke-BackendPhase -Phase 'Run'
    Invoke-FrontendStage

    Write-Log -Message 'Despliegue finalizado'
}

Initialize-Log
try {
    Invoke-ApplicationUp
    exit 0
}
catch {
    Stop-WithError -Reason $_.Exception.Message
}
