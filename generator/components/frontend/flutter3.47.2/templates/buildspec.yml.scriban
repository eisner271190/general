version: 0.2

env:
  variables:
    APPLICATION_ID: "{{ APPLICATION_ID }}"

phases:
  pre_build:
    commands:
      # Fix git dubious ownership for Flutter SDK
      - git config --global --add safe.directory /home/flutter/sdks/flutter
      # Verify environment
      - flutter --version
      - java -version 2>&1
      - echo "ANDROID_HOME=$ANDROID_HOME"
      - echo "JAVA_HOME=$JAVA_HOME"
      # Install AWS CLI
      - pip install awscli 2>/dev/null || pip3 install awscli 2>/dev/null || (curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip && cd /tmp && unzip -q awscliv2.zip && ./aws/install 2>/dev/null)
      - aws --version
      # local.properties
      - 'ANDROID_SDK="$ANDROID_HOME" && FLUTTER_SDK=$(which flutter | sed "s|/bin/flutter||") && printf "sdk.dir=%s\nflutter.sdk=%s\nflutter.buildMode=release\nflutter.versionName=1.0.0\nflutter.versionCode=1\n" "$ANDROID_SDK" "$FLUTTER_SDK" | tee "$CODEBUILD_SRC_DIR/frontend/{{ FRONTEND_NAME }}/android/local.properties" && echo "local.properties OK"'
      # Keystore create-or-get: si el secreto existe se usa; si no, se genera con keytool y se crea
      - 'SECRET_NAME="/epc/$APPLICATION_ID/android-signing"; KS="$CODEBUILD_SRC_DIR/frontend/{{ FRONTEND_NAME }}/android/upload-keystore.jks"; SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id "$SECRET_NAME" --query SecretString --output text 2>/dev/null) || SECRET_JSON=""; if [ -z "$SECRET_JSON" ]; then echo "Secreto no existe, generando keystore con keytool"; PW=$(openssl rand -base64 24 | tr -d "/+="); keytool -genkeypair -alias "upload-$APPLICATION_ID" -keyalg RSA -keysize 2048 -validity 10000 -storetype JKS -keystore "$KS" -storepass "$PW" -keypass "$PW" -dname "CN=$APPLICATION_ID" && SECRET_JSON=$(jq -n --arg keyAlias "upload-$APPLICATION_ID" --arg storePassword "$PW" --arg keyPassword "$PW" --arg keystoreBase64 "$(base64 -w0 < "$KS")" "{keyAlias:\$keyAlias,storePassword:\$storePassword,keyPassword:\$keyPassword,keystoreBase64:\$keystoreBase64}") && aws secretsmanager create-secret --name "$SECRET_NAME" --secret-string "$SECRET_JSON" >/dev/null && echo "Secreto creado: $SECRET_NAME" || { echo "ERROR: no se pudo crear el secreto de firma $SECRET_NAME"; exit 1; }; fi; test -n "$SECRET_JSON" || { echo "ERROR: no se pudo obtener el secreto de firma $SECRET_NAME"; exit 1; }; echo "$SECRET_JSON" | jq -r ".keystoreBase64" | base64 --decode > "$KS" && STORE_PW=$(echo "$SECRET_JSON" | jq -r ".storePassword") && KEY_PW=$(echo "$SECRET_JSON" | jq -r ".keyPassword") && KEY_ALIAS=$(echo "$SECRET_JSON" | jq -r ".keyAlias") && printf "storePassword=%s\nkeyPassword=%s\nkeyAlias=%s\nstoreFile=upload-keystore.jks\n" "$STORE_PW" "$KEY_PW" "$KEY_ALIAS" | tee "$CODEBUILD_SRC_DIR/frontend/{{ FRONTEND_NAME }}/android/key.properties" && echo "Keystore OK: $(wc -c < "$KS") bytes" && echo "key.properties OK"'

  build:
    commands:
      # set -o pipefail propaga exit codes de pipes en sh
      # exit $EXIT al final garatiza que CodeBuild vea el codigo real de Flutter
      - 'set -o pipefail && chmod +x "$CODEBUILD_SRC_DIR/frontend/{{ FRONTEND_NAME }}/android/gradlew" && cd "$CODEBUILD_SRC_DIR/frontend/{{ FRONTEND_NAME }}" && flutter build appbundle --release --verbose 2>&1 | tee /tmp/flutter_full.log; EXIT=$?; echo "=== BUILD RESULT ==="; echo "BUILD EXIT=$EXIT"; echo "=== LAST 200 LINES ==="; tail -200 /tmp/flutter_full.log; echo "=== END ==="; exit $EXIT'

  post_build:
    commands:
      - rm -f "$CODEBUILD_SRC_DIR/frontend/{{ FRONTEND_NAME }}/android/key.properties"
      - rm -f "$CODEBUILD_SRC_DIR/frontend/{{ FRONTEND_NAME }}/android/upload-keystore.jks"
      - echo "Cleanup completed"

artifacts:
  files:
    - frontend/{{ FRONTEND_NAME }}/build/app/outputs/bundle/release/app-release.aab
  discard-paths: no
  name: $APPLICATION_ID-aab-$CODEBUILD_BUILD_ID
