import 'validator.dart';
import '../../core/parameters_initializer.dart';

/// Valida parámetros obtenidos del backend vía /api/v1/parameters.
abstract final class EnvHelper {
  EnvHelper._();

  static final _validator = Validator();

  /// Obtiene un parámetro del backend.
  /// Lanza excepción si el parámetro no existe o está vacío.
  static String getEnv(String key) {
    final value = ParametersInitializer.instance!.getParameter(key);
    _validator.notEmptyAndNotNull(
      value,
      'Parámetro no encontrado en el backend: ',
    );
    return value!;
  }

  /// Valida que todos los parámetros requeridos estén presentes.
  static void validate(List<String> requiredKeys) {
    final missing = <String>[];

    for (final key in requiredKeys) {
      final value = ParametersInitializer.instance!.getParameter(key);
      if (value == null || value.isEmpty) {
        missing.add(key);
      }
    }

    _validator.validate(
      missing.isEmpty,
      'Parámetros faltantes en el backend: ',
    );
  }
}