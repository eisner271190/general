import 'package:{{ FRONTEND_NAME }}/core/parameters_initializer.dart';
import 'api_env.dart';

/// Configuración de monetización obtenida del backend vía /api/v1/parameters.
abstract final class MonetizationEnv {
  MonetizationEnv._();

  static const String keyRevenueCat = 'REVENUECAT_PUBLIC_KEY';
  static const String keyAdmobBanner = 'ADMOB_BANNER_ID';
  static const String keyPrivacyUrl = 'PRIVACY_URL';
  static const String keyTermsUrl = 'TERMS_URL';

  /// Validar y loguear la configuración de monetización.
  static void validateAndLog() {
    // Los parámetros se validan en el backend
  }

  /// Clave pública de RevenueCat.
  static String get revenueCatKey =>
      ParametersInitializer.instance!.getParameterOrDefault(keyRevenueCat, '');

  /// ID del banner de AdMob.
  static String get admobBannerId =>
      ParametersInitializer.instance!.getParameterOrDefault(keyAdmobBanner, '');

  /// URL de política de privacidad.
  static String get privacyUrl =>
      ParametersInitializer.instance!.getParameterOrDefault(keyPrivacyUrl, '');

  /// URL de términos y condiciones.
  static String get termsUrl =>
      ParametersInitializer.instance!.getParameterOrDefault(keyTermsUrl, '');

  /// URL base del backend API (ver [ApiEnv.baseUrl]).
  static String get apiBaseUrl => ApiEnv.baseUrl;
}
