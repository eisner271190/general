import 'dart:async';
import 'package:flutter/foundation.dart';
import 'package:http/http.dart' as http;
import 'dart:convert';
import 'package:purchases_flutter/purchases_flutter.dart';
import 'package:flutter_secure_storage/flutter_secure_storage.dart';
import '../../core/config/monetization_env.dart';
import '../../core/interfaces/monetization_provider.dart';
import '../../core/models/subscription_plan.dart';
import '../../core/models/user_entitlement.dart';

class RevenueCatProvider implements MonetizationProvider {
  final _secureStorage = const FlutterSecureStorage();
  final _entitlementController = StreamController<UserEntitlement>.broadcast();
  static const _entitlementCacheKey = 'subscription_status_cache';
  static const _entitlementCacheTimestampKey = 'subscription_status_timestamp';

  @override
  Future<void> initialize() async {
    if (kIsWeb) return;
    try {
      await Purchases.setLogLevel(LogLevel.debug);
      await Purchases.configure(
        PurchasesConfiguration(MonetizationEnv.revenueCatKey),
      );
      await _syncFromBackend();
    } catch (e) {
      debugPrint('[RevenueCatProvider] Error initializing: $e');
      rethrow;
    }
  }

  @override
  Future<List<SubscriptionPlan>> getPlans() async {
    final offerings = await Purchases.getOfferings();
    if (offerings.current == null) return [];
    return offerings.current!.availablePackages.map((package) {
      return SubscriptionPlan(
        id: package.identifier,
        name: package.storeProduct.title,
        price: package.storeProduct.price.toString(),
        period: package.storeProduct.subscriptionPeriod ?? '',
      );
    }).toList();
  }

  @override
  Future<void> purchase(String planId) async {
    final offerings = await Purchases.getOfferings();
    final package = offerings.current?.availablePackages
        .firstWhereOrNull((p) => p.identifier == planId);
    if (package == null) {
      throw Exception('Plan $planId not found');
    }
    await Purchases.purchase(PurchaseParams.package(package));
    await _syncFromBackend();
  }

  @override
  Future<void> restore() async {
    await Purchases.restorePurchases();
    await _syncFromBackend();
  }

  @override
  Stream<UserEntitlement> entitlementStream() {
    return _entitlementController.stream;
  }

  Future<void> _syncFromBackend() async {
    try {
      final response = await http.get(
        Uri.parse('${MonetizationEnv.apiBaseUrl}/api/v1/subscriptions/status'),
        headers: await _buildAuthHeaders(),
      );
      if (response.statusCode == 200) {
        final data = jsonDecode(response.body)['data'];
        final isActive = data['isActive'] as bool;
        final planId = data['productId'] as String? ?? '';
        final entitlement = UserEntitlement(isActive: isActive, planId: planId);
        _entitlementController.add(entitlement);
        await _cacheEntitlement(entitlement);
      }
    } catch (e) {
      debugPrint('[RevenueCatProvider] Sync failed, using cache: $e');
      final cached = await _getCachedEntitlement();
      if (cached != null) {
        _entitlementController.add(cached);
      }
    }
  }

  Future<Map<String, String>> _buildAuthHeaders() async {
    final token = await _secureStorage.read(key: 'jwt_token');
    return token != null ? {'Authorization': 'Bearer $token'} : {};
  }

  Future<void> _cacheEntitlement(UserEntitlement entitlement) async {
    await _secureStorage.write(
      key: _entitlementCacheKey,
      value: jsonEncode({'isActive': entitlement.isActive, 'planId': entitlement.planId}),
    );
    await _secureStorage.write(
      key: _entitlementCacheTimestampKey,
      value: DateTime.now().millisecondsSinceEpoch.toString(),
    );
  }

  Future<UserEntitlement?> _getCachedEntitlement() async {
    final cached = await _secureStorage.read(key: _entitlementCacheKey);
    if (cached == null) return null;
    final data = jsonDecode(cached);
    return UserEntitlement(
      isActive: data['isActive'] ?? false,
      planId: data['planId'],
    );
  }
}
