/// Sigue el principio de InversiÃ³n de Dependencias (SOLID).
abstract class IAuthService {
  /// Stream que emite el estado actual de autenticaciÃ³n del usuario.
  /// Emite null cuando el usuario no estÃ¡ autenticado.
  Stream<AuthUser?> get authStateChanges;

  /// Usuario actualmente autenticado, o null si no hay sesiÃ³n activa.
  AuthUser? get currentUser;

