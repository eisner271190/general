import 'package:flutter/material.dart';
import 'package:{{ FRONTEND_NAME }}/features/quiz/domain/question.dart';
import 'package:{{ FRONTEND_NAME }}/features/quiz/domain/quiz_generation_config.dart';
import 'package:{{ FRONTEND_NAME }}/features/quiz/application/ai_service.dart';
import 'package:{{ FRONTEND_NAME }}/features/history/application/history_provider.dart';
import 'package:{{ FRONTEND_NAME }}/shared/log/logger.dart';
import 'quiz_config.dart';
import 'quiz_timer.dart';
import 'quiz_result_calculator.dart';
import 'quiz_state_coordinator.dart';
import 'quiz_history_coordinator.dart';

/// Provider de estado del quiz
/// Responsabilidad: Coordinar estado del quiz actual
class QuizProvider extends ChangeNotifier {
  final QuizConfig config = QuizConfig();
  final QuizTimer timer = QuizTimer();
  final QuizStateCoordinator _state = QuizStateCoordinator();
  final QuizHistoryCoordinator _history = QuizHistoryCoordinator();

  bool isLoading = false;

  // DelegaciÃ³n a config
  String get topic => config.topic;
  String get language => config.language;
  int get numQuestions => config.numQuestions;
  int get optionsCount => config.optionsCount;
  int? get timePerQuestionSeconds => config.timePerQuestionSeconds;

  set topic(String value) => config.setTopic(value);
  set language(String value) => config.setLanguage(value);
  set numQuestions(int value) => config.setNumQuestions(value);
  set optionsCount(int value) => config.setOptionsCount(value);
  set timePerQuestionSeconds(int? value) => config.setTimePerQuestion(value);

  // DelegaciÃ³n a state
  List<Question> get questions => _state.questions;
  int get currentIndex => _state.currentIndex;

  int get remainingSeconds => timer.remainingSeconds;

  Future<void> startQuiz() async {
    Logger.info('[PROVIDER] Starting quiz', data: config.toMap());
    isLoading = true;
    notifyListeners();

    final generatedQuestions = await AIService.generateQuestions(
      QuizGenerationConfig(
        topic: topic,
        language: language,
        numQuestions: numQuestions,
        optionsCount: optionsCount,
        timePerQuestionSeconds: timePerQuestionSeconds,
      ),
    );

    _state.setQuestions(generatedQuestions);
    isLoading = false;
    timer.start(timePerQuestionSeconds, nextQuestion);
    Logger.info('[PROVIDER] Quiz started', data: {'count': questions.length});
    notifyListeners();
  }

  void selectAnswer(int index) {
    _state.selectAnswer(index);
    notifyListeners();
  }

  void nextQuestion() {
    _state.next();
    timer.reset();
    notifyListeners();
  }

  void previousQuestion() {
    _state.previous();
    timer.reset();
    notifyListeners();
  }

  Map<String, dynamic> results() {
    return QuizResultCalculator.calculate(questions);
  }

  Future<void> saveToHistory(HistoryProvider historyProvider) async {
    await _history.saveToHistory(
      historyProvider: historyProvider,
      topic: topic,
      language: language,
      questions: questions,
    );
  }

  void clear() {
    _state.reset();
    timer.stop();
    notifyListeners();
  }

  @override
  void dispose() {
    timer.dispose();
    super.dispose();
  }
}
