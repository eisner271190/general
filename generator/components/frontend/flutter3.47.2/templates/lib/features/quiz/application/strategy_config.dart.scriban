import 'package:{{ FRONTEND_NAME }}/core/parameters_initializer.dart';

class StrategyConfig {
  final String? apiKey;
  final String promptTemplate;

  StrategyConfig({this.apiKey, required this.promptTemplate});

  factory StrategyConfig.load({required String promptTemplate}) {
    return StrategyConfig(
      apiKey: ParametersInitializer.instance!.getParameter('API_KEY'),
      promptTemplate: promptTemplate,
    );
  }
}
