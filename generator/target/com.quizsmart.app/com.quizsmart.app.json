{
  "applicationName": "Quiz Smart",
  "applicationId": "com.quizsmart.app",
  "frontend": {
    "name": "quizsmart",
    "framework": "flutter3.47.2",
    "platforms": [
      "android",
      "ios",
      "web",
      "windows",
      "macos",
      "linux"
    ],
    "version": "1.0.0+1"
  },
  "cloud": {
    "provider": "aws"
  },
  "environments": [
    {
      "name": "develop",
      "variables": {
        "JWT_EXPIRATION": "86400000",
        "AWS_REGION": "us-east-1",
        "THEME_STYLE": "CHATGPT",
        "PROMPT": "Generate a valid JSON object with a questions array for the requested quiz.",
        "MODEL": "MiMo-V2.6-Flash",
        "REVENUECAT_PUBLIC_KEY": "REVENUECAT_PUBLIC_KEY_PLACEHOLDER",
        "ADMOB_BANNER_ID": "ADMOB_BANNER_ID_PLACEHOLDER",
        "PRIVACY_URL": "https://quiz-epc-politica-privacidad.s3.us-east-1.amazonaws.com/privacy-policy.html",
        "TERMS_URL": "https://quiz-epc-politica-privacidad.s3.us-east-1.amazonaws.com/privacy-policy.html"
      }
    }
  ],
  "microservices": [
    {
      "name": "quizapi",
      "backend": "spring-boot-3.5.16",
      "deploy": "DOCKER",
      "entities": [
        {
          "name": "Quiz",
          "fields": [
            {
              "name": "id",
              "datatype": "long"
            },
            {
              "name": "title",
              "datatype": "String"
            }
          ],
          "relations": [
            {
              "entity": "Question",
              "type": "one-to-many"
            }
          ]
        },
        {
          "name": "Question",
          "fields": [
            {
              "name": "id",
              "datatype": "long"
            },
            {
              "name": "text",
              "datatype": "String"
            },
            {
              "name": "quizId",
              "datatype": "long"
            }
          ],
          "relations": [
            {
              "entity": "Quiz",
              "type": "many-to-one"
            },
            {
              "entity": "Answer",
              "type": "one-to-many"
            }
          ]
        },
        {
          "name": "Answer",
          "fields": [
            {
              "name": "id",
              "datatype": "long"
            },
            {
              "name": "text",
              "datatype": "String"
            },
            {
              "name": "questionId",
              "datatype": "long"
            },
            {
              "name": "isCorrect",
              "datatype": "boolean"
            }
          ],
          "relations": [
            {
              "entity": "Question",
              "type": "many-to-one"
            }
          ]
        }
      ],
      "endpoints": [
        {
          "method": "GET",
          "path": "/quizzes",
          "parameters": {},
          "response": "Quiz[]"
        },
        {
          "method": "POST",
          "path": "/quizzes",
          "parameters": {},
          "response": "Quiz"
        }
      ],
      "consumedEvents": [],
      "port": 5000
    }
  ]
}
